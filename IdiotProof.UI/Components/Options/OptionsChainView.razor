@*
    Options chain — CALLS on the left, PUTS on the right, one strike per row. Every cell
    carries the numbers a person normally has to compute in their head: breakeven at
    expiration, and how much of the premium is HYPE (extrinsic / time value) vs REAL
    (intrinsic). The hype meter colour is the whole point of this page: that's the value
    you cash in by selling early, and the value that evaporates if you wait for reality.
    Every header word is a <Jargon> (hover = hint, click = full explanation) and every
    per-cell title comes from OptionsGlossary, so the jargon is explained exactly once.
    Presentational only — data arrives via parameters, selections leave via callbacks.
*@

<div class="opt-chain trading-card p-3" data-cy="opt-chain">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <div class="d-flex align-items-center gap-3">
            <h2 class="h6 mb-0">
                <i class="bi bi-diagram-3 me-1" style="color:var(--brand)" aria-hidden="true"></i>
                @(string.IsNullOrWhiteSpace(Underlying) ? "Chain" : $"{Underlying} chain")
            </h2>
            @if (UnderlyingPrice is { } spot)
            {
                <span class="small opt-mono" data-cy="opt-underlying-price">
                    <span class="text-muted">@Underlying is at</span> @OptionsPresenter.Money(spot)
                    @if (!string.IsNullOrEmpty(PriceSource))
                    {
                        <span class="badge opt-badge ms-1" title="@(PriceSource == "Sandbox" ? "Sandbox reference price — no live quote was available for this ticker" : "Live price from Alpaca market data")">@PriceSource</span>
                    }
                </span>
            }
        </div>
        <div class="d-flex align-items-center gap-2 small text-muted">
            <Jargon Term="hype-meter">Hype meter</Jargon><span>:</span>
            <span class="opt-hype-legend" title="@OptionsGlossary.Hint("hype-meter")">
                <span class="hype-0">real</span><span class="hype-1"></span><span class="hype-2"></span><span class="hype-3"></span><span class="hype-4">all hype</span>
            </span>
        </div>
    </div>

    @if (Expirations.Count > 0)
    {
        <div class="d-flex flex-wrap align-items-center gap-1 mb-2" role="tablist" aria-label="Expirations">
            <span class="small text-muted me-1"><Jargon Term="expiration">Expires</Jargon>:</span>
            @foreach (var exp in Expirations)
            {
                var dte = IntrinsicValueCalculator.DaysToExpiration(exp, Today);
                <button type="button" role="tab" data-cy="opt-exp"
                        class="btn btn-sm @(exp == SelectedExpiration ? "btn-warning" : "btn-outline-secondary") opt-exp-pill"
                        aria-selected="@(exp == SelectedExpiration)"
                        title="@($"{exp:dddd, MMMM d yyyy} — {dte} days to expiration")"
                        @onclick="() => OnExpirationSelected.InvokeAsync(exp)">
                    @exp.ToString("MMM d") <span class="opt-dte">@dte d</span>
                </button>
            }
        </div>
    }

    @if (Loading)
    {
        <div class="text-muted small py-3" data-cy="opt-chain-loading"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading chain…</div>
    }
    else if (Rows.Count == 0)
    {
        <div class="text-muted small py-3" data-cy="opt-chain-empty">@EmptyMessage</div>
    }
    else
    {
        var byStrike = Rows.GroupBy(r => r.Contract.Strike).OrderBy(g => g.Key).ToList();
        <div class="table-responsive">
            <table class="table table-dark table-sm table-hover align-middle opt-chain-table mb-0" data-cy="opt-chain-table">
                <thead>
                    <tr class="opt-side-head">
                        <th colspan="5" class="text-center opt-calls-head"><Jargon Term="call">CALLS</Jargon> <span class="text-muted fw-normal">bet it goes UP</span></th>
                        <th class="text-center"><Jargon Term="strike">Strike</Jargon></th>
                        <th colspan="5" class="text-center opt-puts-head"><Jargon Term="put">PUTS</Jargon> <span class="text-muted fw-normal">bet it goes DOWN</span></th>
                    </tr>
                    <tr class="small">
                        <th><Jargon Term="iv">IV</Jargon></th>
                        <th><Jargon Term="hype">Hype $ / %</Jargon></th>
                        <th><Jargon Term="breakeven">Breakeven</Jargon></th>
                        <th><Jargon Term="bid-ask">Bid / Ask</Jargon></th>
                        <th><Jargon Term="mid">Mid</Jargon></th>
                        <th class="text-center"><Jargon Term="moneyness" Class="text-muted fw-normal">ITM shaded</Jargon></th>
                        <th><Jargon Term="mid">Mid</Jargon></th>
                        <th><Jargon Term="bid-ask">Bid / Ask</Jargon></th>
                        <th><Jargon Term="breakeven">Breakeven</Jargon></th>
                        <th><Jargon Term="hype">Hype $ / %</Jargon></th>
                        <th><Jargon Term="iv">IV</Jargon></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in byStrike)
                    {
                        var call = g.FirstOrDefault(r => r.Contract.Right == OptionRight.Call);
                        var put = g.FirstOrDefault(r => r.Contract.Right == OptionRight.Put);
                        var isAtm = UnderlyingPrice is { } sp && Math.Abs(g.Key - sp) <= AtmBand(sp);
                        // A call is in the money when the stock is ABOVE the strike, a put when it is
                        // BELOW. Both need a known underlying price — with none, nothing is shaded.
                        var callItm = !isAtm && UnderlyingPrice is { } sp2 && g.Key < sp2;
                        var putItm = !isAtm && UnderlyingPrice is { } sp3 && g.Key > sp3;
                        <tr class="@(isAtm ? "opt-atm" : "")" data-strike="@g.Key.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">
                            @RenderSide(call, callItm, mirror: false)
                            <td class="text-center opt-strike opt-mono" title="@(isAtm ? "At the money — strike is about where the stock trades now" : OptionsGlossary.Hint("strike"))">@g.Key.ToString("0.##")@(isAtm ? " ●" : "")</td>
                            @RenderSide(put, putItm, mirror: true)
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small mt-2 mb-0">
            Click any call or put to open the order ticket. <Jargon Term="hype">Hype</Jargon> is the premium you're paying for the
            <em>idea</em> of a move; it decays to zero by expiration and inflates when the stock runs. The
            <Jargon Term="iv-source">IV badge</Jargon> says where the volatility number came from:
            <span class="badge opt-badge">Alpaca</span> = broker-supplied, <span class="badge opt-badge">Model</span> = solved locally (Black-Scholes).
        </p>
    }
</div>

@code {
    [Parameter] public string Underlying { get; set; } = "";
    [Parameter] public decimal? UnderlyingPrice { get; set; }
    [Parameter] public string? PriceSource { get; set; }
    [Parameter] public IReadOnlyList<ChainRow> Rows { get; set; } = [];
    [Parameter] public IReadOnlyList<DateOnly> Expirations { get; set; } = [];
    [Parameter] public DateOnly? SelectedExpiration { get; set; }
    [Parameter] public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow);
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = "Type a ticker above and load its chain.";
    [Parameter] public ChainRow? Selected { get; set; }
    [Parameter] public EventCallback<DateOnly> OnExpirationSelected { get; set; }
    [Parameter] public EventCallback<ChainRow> OnRowSelected { get; set; }

    private static decimal AtmBand(decimal spot) => Math.Max(0.25m, spot * 0.005m);

    private RenderFragment RenderSide(ChainRow? row, bool inTheMoney, bool mirror) => builder =>
    {
        var seq = 0;
        if (row is null)
        {
            for (var i = 0; i < 5; i++) { builder.OpenElement(seq++, "td"); builder.AddContent(seq++, "—"); builder.CloseElement(); }
            return;
        }

        var b = row.Breakdown;
        var selected = Selected is { } s && s.Contract.OccSymbol == row.Contract.OccSymbol;
        var cls = $"opt-cell {(inTheMoney ? "opt-itm" : "")} {(selected ? "opt-selected" : "")}".Trim();
        var hype = b is { } ? OptionsPresenter.HypeBucket(b.ExtrinsicPercent) : 0;
        var sideCy = row.Contract.Right == OptionRight.Call ? "opt-cell-call" : "opt-cell-put";
        var rightWord = row.Contract.Right == OptionRight.Call ? "call" : "put";

        void Cell(string content, string extraClass = "", string? title = null)
        {
            builder.OpenElement(seq++, "td");
            builder.AddAttribute(seq++, "class", $"{cls} {extraClass}".Trim());
            builder.AddAttribute(seq++, "role", "button");
            builder.AddAttribute(seq++, "tabindex", "0");
            builder.AddAttribute(seq++, "data-cy", sideCy);
            builder.AddAttribute(seq++, "data-occ", row.Contract.OccSymbol);
            builder.AddAttribute(seq++, "aria-label", $"Select the {row.Contract.UnderlyingSymbol} ${row.Contract.Strike:0.##} {rightWord}");
            if (title is not null) builder.AddAttribute(seq++, "title", title);
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => OnRowSelected.InvokeAsync(row)));
            builder.AddAttribute(seq++, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, e => e.Key is "Enter" or " " ? OnRowSelected.InvokeAsync(row) : Task.CompletedTask));
            builder.AddMarkupContent(seq++, content);
            builder.CloseElement();
        }

        var iv = $"<span class=\"opt-mono\">{OptionsPresenter.Iv(row.ImpliedVolatility)}</span>" +
                 (row.ImpliedVolatility is { } ? $" <span class=\"badge opt-badge opt-badge-xs\">{row.IvSource}</span>" : "");
        var hypeCell = b is { }
            ? $"<span class=\"opt-hype hype-{hype}\"><span class=\"opt-mono\">{OptionsPresenter.Money(b.Extrinsic)}</span> <span class=\"opt-hype-pct\">{OptionsPresenter.Pct(b.ExtrinsicPercent, 0)}</span></span>"
            : "—";
        var breakeven = b is { } ? $"<span class=\"opt-mono\">{OptionsPresenter.Money(b.Breakeven)}</span>" : "—";
        var bidAsk = row.Quote is { } q ? $"<span class=\"opt-mono\">{q.Bid:0.00} × {q.Ask:0.00}</span>" : "—";
        var mid = row.Mid is { } m ? $"<span class=\"opt-mono fw-semibold\">{m:0.00}</span>" : "—";

        var ivTitle = row.ImpliedVolatility is { }
            ? $"{OptionsGlossary.Hint("iv")} Source: {row.IvSource}{(row.ModelPrice is { } mp ? $" · model fair value {OptionsPresenter.Money(mp)}/sh" : "")}"
            : OptionsGlossary.Hint("iv");
        var hypeTitle = b is { } ? $"Real (intrinsic) {OptionsPresenter.Money(b.Intrinsic)} + hype (time value) {OptionsPresenter.Money(b.Extrinsic)} = {OptionsPresenter.Money(b.Premium)} per share. {OptionsGlossary.Hint("hype")}" : OptionsGlossary.Hint("hype");
        var beTitle = b is { } ? $"Only matters if you HOLD to expiration ({b.DaysToExpiration} days). Selling early cashes in the hype instead." : OptionsGlossary.Hint("breakeven");
        var midTitle = b is { } ? $"{OptionsPresenter.Money(b.CostPerContract)} per contract ({row.Contract.Multiplier} shares). {OptionsGlossary.Hint("mid")}" : OptionsGlossary.Hint("mid");
        var bidAskTitle = OptionsGlossary.Hint("bid-ask");

        if (!mirror)
        {
            Cell(iv, "", ivTitle); Cell(hypeCell, "", hypeTitle); Cell(breakeven, "", beTitle); Cell(bidAsk, "", bidAskTitle); Cell(mid, "", midTitle);
        }
        else
        {
            Cell(mid, "", midTitle); Cell(bidAsk, "", bidAskTitle); Cell(breakeven, "", beTitle); Cell(hypeCell, "", hypeTitle); Cell(iv, "", ivTitle);
        }
    };
}
