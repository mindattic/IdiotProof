@*
    Open option positions with live valuation, the real/hype split, and the informational
    "consider taking profit" callout from SellSignalEvaluator. Never acts on its own — the
    Close button just asks the host to pre-fill the ticket with the opposite side.
*@

<div class="trading-card p-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h6 mb-0"><i class="bi bi-briefcase me-1" style="color:var(--brand)" aria-hidden="true"></i>Open option positions</h2>
        <div class="d-flex align-items-center gap-2 small text-muted">
            @if (!string.IsNullOrEmpty(LastRefreshLabel))
            {
                <span>Updated @LastRefreshLabel</span>
            }
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@Loading" @onclick="() => OnRefresh.InvokeAsync()" aria-label="Refresh positions">
                <i class="bi bi-arrow-clockwise @(Loading ? "spin" : "")" aria-hidden="true"></i>
            </button>
        </div>
    </div>

    @if (Loading && Positions.Count == 0)
    {
        <div class="text-muted small"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading positions…</div>
    }
    else if (Positions.Count == 0)
    {
        <div class="text-muted small">No open option positions on this account.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-sm align-middle mb-0 opt-positions">
                <thead class="small">
                    <tr>
                        <th>Contract</th>
                        <th class="text-end">Qty</th>
                        <th class="text-end" title="Average premium paid per share">Avg /sh</th>
                        <th class="text-end" title="Current mid-point per share">Now /sh</th>
                        <th class="text-end">P&amp;L</th>
                        <th title="How much of today's premium is real (intrinsic) vs hype (time value)">Real / Hype</th>
                        <th class="text-end">DTE</th>
                        <th class="text-end">IV</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Positions)
                    {
                        var c = p.Contract;
                        var b = p.Breakdown;
                        var pnl = p.UnrealizedPnl;
                        var pnlClass = pnl is null ? "" : pnl >= 0m ? "text-success" : "text-danger";
                        <tr>
                            <td>
                                <div class="fw-semibold">
                                    @c.UnderlyingSymbol <span class="opt-mono">$@c.Strike.ToString("0.##")</span>
                                    <span class="badge @(c.Right == OptionRight.Call ? "opt-badge-call" : "opt-badge-put")">@c.Right.ToString().ToUpperInvariant()</span>
                                </div>
                                <div class="small text-muted">@c.Expiration.ToString("MMM d, yyyy")@(p.UnderlyingPrice is { } u ? $" · {c.UnderlyingSymbol} at {OptionsPresenter.Money(u)}" : "")</div>
                            </td>
                            <td class="text-end opt-mono">@p.Position.Quantity.ToString("+0;-0")</td>
                            <td class="text-end opt-mono">@OptionsPresenter.Money(p.Position.AveragePrice)</td>
                            <td class="text-end opt-mono">@OptionsPresenter.Money(p.Mid)</td>
                            <td class="text-end opt-mono @pnlClass">
                                @OptionsPresenter.Money(pnl)
                                @if (p.UnrealizedPnlPercent is { } pct)
                                {
                                    <div class="small">@(pct >= 0 ? "+" : "")@pct.ToString("0.0")%</div>
                                }
                            </td>
                            <td style="min-width:160px">
                                @if (b is { } && b.Premium > 0m)
                                {
                                    var realPct = 100m - b.ExtrinsicPercent;
                                    <div class="opt-split-bar" title="@($"Real {OptionsPresenter.Money(b.Intrinsic)} / hype {OptionsPresenter.Money(b.Extrinsic)} per share")">
                                        <span class="opt-split-real" style="width:@(realPct.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                        <span class="opt-split-hype hype-@OptionsPresenter.HypeBucket(b.ExtrinsicPercent)" style="width:@(b.ExtrinsicPercent.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                    </div>
                                    <div class="small opt-mono">@OptionsPresenter.Money(b.Intrinsic) / <span class="opt-hype hype-@OptionsPresenter.HypeBucket(b.ExtrinsicPercent)">@OptionsPresenter.Money(b.Extrinsic) (@OptionsPresenter.Pct(b.ExtrinsicPercent, 0))</span></div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end opt-mono">@(b?.DaysToExpiration.ToString() ?? IntrinsicValueCalculator.DaysToExpiration(c.Expiration, Today).ToString())</td>
                            <td class="text-end opt-mono">@OptionsPresenter.Iv(p.ImpliedVolatility)@(p.ImpliedVolatility is { } ? $" " : "")@if (p.ImpliedVolatility is { }) { <span class="badge opt-badge opt-badge-xs">@p.IvSource</span> }</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => OnClose.InvokeAsync(p)" title="Pre-fill the ticket to close this position">
                                    Close
                                </button>
                            </td>
                        </tr>
                        @if (p.Signal is { } sig)
                        {
                            <tr class="opt-signal-row">
                                <td colspan="9">
                                    <div class="opt-signal">
                                        <i class="bi bi-lightning-charge-fill me-2" aria-hidden="true"></i>
                                        <span>@sig.Message</span>
                                        <span class="text-muted small ms-2">(informational — nothing is placed automatically)</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<OptionPositionView> Positions { get; set; } = [];
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? LastRefreshLabel { get; set; }
    [Parameter] public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow);
    [Parameter] public EventCallback<OptionPositionView> OnClose { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
}
