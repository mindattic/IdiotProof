@*
    Open option positions with live valuation, the real/hype split, and the informational
    "consider taking profit" callout from SellSignalEvaluator. Never acts on its own — the
    Close button just asks the host to pre-fill the ticket with the opposite side.
    Column headers are <Jargon> terms; the nudge row explains itself.
*@

<div class="trading-card p-3" data-cy="opt-positions">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h6 mb-0"><i class="bi bi-briefcase me-1" style="color:var(--brand)" aria-hidden="true"></i>Open option positions</h2>
        <div class="d-flex align-items-center gap-2 small text-muted">
            @if (!string.IsNullOrEmpty(LastRefreshLabel))
            {
                <span data-cy="opt-positions-updated">Updated @LastRefreshLabel</span>
            }
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@Loading" @onclick="() => OnRefresh.InvokeAsync()" aria-label="Refresh positions" title="Refresh positions (they also refresh every 20 seconds)" data-cy="opt-positions-refresh">
                <i class="bi bi-arrow-clockwise @(Loading ? "spin" : "")" aria-hidden="true"></i>
            </button>
        </div>
    </div>

    @if (Loading && Positions.Count == 0)
    {
        <div class="text-muted small"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading positions…</div>
    }
    else if (Positions.Count == 0)
    {
        <div class="text-muted small" data-cy="opt-positions-empty">No open option positions on this account.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-sm align-middle mb-0 opt-positions" data-cy="opt-positions-table">
                <thead class="small">
                    <tr>
                        <th><Jargon Term="contract">Contract</Jargon></th>
                        <th class="text-end"><Jargon Term="qty">Qty</Jargon></th>
                        <th class="text-end"><Jargon Term="avg">Avg /sh</Jargon></th>
                        <th class="text-end"><Jargon Term="now">Now /sh</Jargon></th>
                        <th class="text-end"><Jargon Term="pnl">P&amp;L</Jargon></th>
                        <th><Jargon Term="real">Real</Jargon> / <Jargon Term="hype">Hype</Jargon></th>
                        <th class="text-end"><Jargon Term="dte">DTE</Jargon></th>
                        <th class="text-end"><Jargon Term="iv">IV</Jargon></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Positions)
                    {
                        var c = p.Contract;
                        var b = p.Breakdown;
                        var pnl = p.UnrealizedPnl;
                        var pnlClass = pnl is null ? "" : pnl >= 0m ? "text-success" : "text-danger";
                        var isLong = p.Position.Quantity > 0m;
                        <tr data-occ="@c.OccSymbol" data-cy="opt-position-row">
                            <td>
                                <div class="fw-semibold">
                                    @c.UnderlyingSymbol <span class="opt-mono">$@c.Strike.ToString("0.##")</span>
                                    <span class="badge @(c.Right == OptionRight.Call ? "opt-badge-call" : "opt-badge-put")" title="@OptionsGlossary.Hint(c.Right == OptionRight.Call ? "call" : "put")">@c.Right.ToString().ToUpperInvariant()</span>
                                    @if (!isLong)
                                    {
                                        <span class="badge bg-danger ms-1" title="@OptionsGlossary.Hint("sell-to-open")">SHORT</span>
                                    }
                                </div>
                                <div class="small text-muted">@c.Expiration.ToString("MMM d, yyyy")@(p.UnderlyingPrice is { } u ? $" · {c.UnderlyingSymbol} at {OptionsPresenter.Money(u)}" : "")</div>
                                @if (p.IsWarmingUp)
                                {
                                    <div class="opt-watching" data-cy="opt-watching" title="@OptionsGlossary.Hint("sell-signal")">
                                        <i class="bi bi-eye me-1" aria-hidden="true"></i>Watching the hype level — @p.Observations/@SellSignalEvaluator.MinObservations samples before the sell nudge can fire.
                                    </div>
                                }
                            </td>
                            <td class="text-end opt-mono" data-cy="opt-position-qty">@p.Position.Quantity.ToString("+0;-0")</td>
                            <td class="text-end opt-mono" title="@($"{OptionsPresenter.Money(p.Position.AveragePrice * c.Multiplier)} per contract")">@OptionsPresenter.Money(p.Position.AveragePrice)</td>
                            <td class="text-end opt-mono" title="@(p.Mid is { } nm ? $"{OptionsPresenter.Money(nm * c.Multiplier)} per contract" : OptionsGlossary.Hint("now"))">@OptionsPresenter.Money(p.Mid)</td>
                            <td class="text-end opt-mono @pnlClass" title="@($"Cost {OptionsPresenter.Money(p.CostBasis)} → now {OptionsPresenter.Money(p.MarketValueNow)}. Unrealised until you close.")">
                                @OptionsPresenter.Money(pnl)
                                @if (p.UnrealizedPnlPercent is { } pct)
                                {
                                    <div class="small">@(pct >= 0 ? "+" : "")@pct.ToString("0.0")%</div>
                                }
                            </td>
                            <td style="min-width:160px">
                                @if (b is { } && b.Premium > 0m)
                                {
                                    var realPct = 100m - b.ExtrinsicPercent;
                                    <div class="opt-split-bar" title="@($"Real {OptionsPresenter.Money(b.Intrinsic)} / hype {OptionsPresenter.Money(b.Extrinsic)} per share. {OptionsGlossary.Hint("hype")}")">
                                        <span class="opt-split-real" style="width:@(realPct.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                        <span class="opt-split-hype hype-@OptionsPresenter.HypeBucket(b.ExtrinsicPercent)" style="width:@(b.ExtrinsicPercent.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                    </div>
                                    <div class="small opt-mono">@OptionsPresenter.Money(b.Intrinsic) / <span class="opt-hype hype-@OptionsPresenter.HypeBucket(b.ExtrinsicPercent)">@OptionsPresenter.Money(b.Extrinsic) (@OptionsPresenter.Pct(b.ExtrinsicPercent, 0))</span></div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end opt-mono" title="@OptionsGlossary.Hint("dte")">@(b?.DaysToExpiration.ToString() ?? IntrinsicValueCalculator.DaysToExpiration(c.Expiration, Today).ToString())</td>
                            <td class="text-end opt-mono" title="@OptionsGlossary.Hint("iv-source")">@OptionsPresenter.Iv(p.ImpliedVolatility)@if (p.ImpliedVolatility is { }) { <text> </text><span class="badge opt-badge opt-badge-xs">@p.IvSource</span> }</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-warning" data-cy="opt-close" @onclick="() => OnClose.InvokeAsync(p)"
                                        title="@(isLong ? "Pre-fill the ticket to SELL these contracts and cash in" : "Pre-fill the ticket to BUY BACK the contracts you wrote")">
                                    Close
                                </button>
                            </td>
                        </tr>
                        @if (p.Signal is { } sig)
                        {
                            <tr class="opt-signal-row" data-cy="opt-signal-row">
                                <td colspan="9">
                                    <div class="opt-signal">
                                        <i class="bi bi-lightning-charge-fill me-2" aria-hidden="true"></i>
                                        <span>@sig.Message</span>
                                        <span class="text-muted small ms-2">(<Jargon Term="sell-signal">informational</Jargon> — nothing is placed automatically)</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<OptionPositionView> Positions { get; set; } = [];
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? LastRefreshLabel { get; set; }
    [Parameter] public DateOnly Today { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow);
    [Parameter] public EventCallback<OptionPositionView> OnClose { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
}
