<Project Sdk="Microsoft.NET.Sdk">
  <!-- stdio MCP server: one tool per Hub operation, generated from the operation catalog and
       forwarded to the Hub. stdout is the protocol wire — nothing else may write to it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IdiotProof.Mcp</RootNamespace>
    <AssemblyName>idiotproof-mcp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IdiotProof.Mcp.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shipped copies for the MCP resources when the server runs outside the checkout (IP-T122). -->
    <None Include="..\docs\BIBLE.md" Link="docs\BIBLE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\docs\USER_STORIES.md" Link="docs\USER_STORIES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\docs\agent\IDIOTPROOF_PROTOCOL.md" Link="docs\agent\IDIOTPROOF_PROTOCOL.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IdiotProof.Operations\IdiotProof.Operations.csproj" />
  </ItemGroup>
</Project>
