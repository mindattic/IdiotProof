<Project Sdk="Microsoft.NET.Sdk">
  <!-- `idiotproof` — the command-line front door (Epic W2). A thin client: everything except
       help, version, owner defaults and Hub lifecycle runs on the Hub (POST /api/op). It references
       IdiotProof.Operations so help and `agent bootstrap` work with the Hub down (IP-T60). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IdiotProof.Cli</RootNamespace>
    <AssemblyName>idiotproof</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IdiotProof.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IdiotProof.Operations\IdiotProof.Operations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- `agent export` renders docs/MCP_TOOLS.md with the MCP server's own renderer (IP-T272);
         compiled in rather than referenced, since the MCP server is an exe. -->
    <Compile Include="..\IdiotProof.Mcp\ToolSpec.cs" Link="Mcp\ToolSpec.cs" />
    <Compile Include="..\IdiotProof.Mcp\ToolDocs.cs" Link="Mcp\ToolDocs.cs" />
  </ItemGroup>
</Project>
