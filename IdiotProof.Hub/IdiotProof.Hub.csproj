<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The one long-running IdiotProof process: hosts the Monitor (the only evaluator and order
       placer, IP-LAW-10) and serves every operation to the CLI, the MCP server and the web app
       over loopback HTTP. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IdiotProof.Hub</RootNamespace>
    <AssemblyName>idiotproof-hub</AssemblyName>
    <!-- The Hub's money-green console window gets its own taskbar/exe icon (IdiotProof.Hub/run.ps1's Desktop shortcut reads it off the exe). -->
    <ApplicationIcon>..\assets\hub.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IdiotProof.Hub.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
    <!-- The Hub's durable log: %APPDATA%\MindAttic\Logging\IdiotProof.Hub\MindAttic.Log.db (IP-T78). -->
    <PackageReference Include="MindAttic.Log" Version="3.0.0" />
    <!-- MailKit's MimeKit pins System.Security.Cryptography.Pkcs transitively at its 10.0.0 floor,
         inside the vulnerable range for CVE-2026-84008/70162/96958/96959/96960 (NU1902/NU1903),
         fixed in 10.0.13 — pin to 10.0.14, matching IdiotProof.Core's direct reference. A direct
         reference wins over the transitive floor. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- Legion voter-panel config (repo root): a deployed host has no repo checkout. -->
    <Content Include="..\legion.json" Link="legion.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IdiotProof.Core\IdiotProof.Core.csproj" />
    <ProjectReference Include="..\IdiotProof.Operations\IdiotProof.Operations.csproj" />
  </ItemGroup>
</Project>
