{
  "hooks": {
    "SessionStart": [
      { "matcher": "clear", "hooks": [ { "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%CLAUDE_PROJECT_DIR%\\.claude\\hooks\\restore-handoff.ps1\"" } ] },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-digest.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "async": true,
            "statusMessage": "Publishing Monitor to C:\\Apps\\IdiotProof\\Monitor...",
            "command": "$j = [Console]::In.ReadToEnd() | ConvertFrom-Json; if ($j.tool_input.file_path -like '*IdiotProof.Monitor*') { Start-Process dotnet -ArgumentList 'publish', 'D:\\Projects\\MindAttic\\IdiotProof\\IdiotProof.Monitor\\IdiotProof.Monitor.csproj', '--configuration', 'Release', '--output', 'C:\\Apps\\IdiotProof\\Monitor', '--no-self-contained' -NoNewWindow }"
          }
        ]
      }
    ]
  }
}
