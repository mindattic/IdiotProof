<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IdiotProof.Monitor</RootNamespace>
    <AssemblyName>idiotproof-monitor</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.*" />
    <!-- Premarket-fade alert emailing (EmailSmsAlertSender) — same email-to-SMS
         gateway approach as MindAttic.Psst, without pulling in that assembly's
         net10.0-windows + WindowsDesktop sound-effect dependency. -->
    <PackageReference Include="MailKit" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legion voter-panel config (repo root). Ship it with the binaries:
         during dev the walk-up discovery finds the repo-root copy, but a
         deployed host has no repo — without this the "high tier" 4-voter
         panel silently reverted to Legion's defaults in production. -->
    <Content Include="..\legion.json" Link="legion.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IdiotProof.Models\IdiotProof.Models.csproj" />
    <ProjectReference Include="..\IdiotProof.Indicators\IdiotProof.Indicators.csproj" />
    <ProjectReference Include="..\IdiotProof.Scripting\IdiotProof.Scripting.csproj" />
    <ProjectReference Include="..\IdiotProof.Strategies\IdiotProof.Strategies.csproj" />
    <ProjectReference Include="..\IdiotProof.DataFeeds\IdiotProof.DataFeeds.csproj" />
    <ProjectReference Include="..\IdiotProof.Brokers\IdiotProof.Brokers.csproj" />
    <ProjectReference Include="..\IdiotProof.Engine\IdiotProof.Engine.csproj" />
    <ProjectReference Include="..\IdiotProof.Blazor\IdiotProof.Blazor.csproj" />
  </ItemGroup>

</Project>
