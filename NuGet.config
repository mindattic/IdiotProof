<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    NuGet sources for the IdiotProof solution. nuget.org carries the
    published MindAttic.Vault and MindAttic.Legion packages; LocalNuGet
    on the dev box is kept as a fallback for in-progress prerelease bumps.
    GitHub Actions runners ignore the LocalNuGet entry (path doesn't exist)
    and resolve everything from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="LocalNuGet" value="C:\LocalNuGet" />
  </packageSources>
</configuration>
