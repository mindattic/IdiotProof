<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    NuGet.config for the IdiotProof solution.

    Adds a local feed at the MindAttic family root so unpublished packages
    (currently MindAttic.Vault, packed via `dotnet pack`) resolve without
    hitting nuget.org. Drop the .nupkg into D:\Projects\MindAttic\local-feed\
    after running pack on the source project; restore picks it up on next
    build.

    nuget.org stays as the primary source for everything else.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="MindAttic-local" value="..\local-feed" />
  </packageSources>
</configuration>
