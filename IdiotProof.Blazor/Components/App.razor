@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IdiotProof — Trading Strategy Platform</title>
    <base href="/" />
    <!-- Pre-paint: apply the stored theme (dark default) before CSS to avoid a flash.
         Dark and light share all structure (font, radius, spacing); only colors swap. -->
    <script>
      (function () {
        try {
          var t = localStorage.getItem('idiotproof.theme');
          t = (t === 'light' || t === 'dark') ? t : 'dark';
          var r = document.documentElement;
          r.setAttribute('data-theme', t);
          r.setAttribute('data-bs-theme', t);
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="css/components.css" />
    <link rel="stylesheet" href="_content/IdiotProof.UI/css/options.css" />
    <HeadOutlet @rendermode="@RenderMode.InteractiveServer" />
</head>
<body>
    <Routes @rendermode="@RenderMode.InteractiveServer" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="_framework/blazor.server.js"></script>
    <script src="app.js"></script>
    <script src="js/live-chart.js"></script>
    <script src="js/strategy-preview.js"></script>
    <script src="_content/IdiotProof.UI/js/focus-trap.js"></script>
</body>
</html>
