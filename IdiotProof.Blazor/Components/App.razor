@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IdiotProof — Trading Strategy Platform</title>
    <base href="/" />
    @* Everything below is same-origin, with no inline script: /login, /mfa and /account get
       MindAttic.Authentication's strict CSP (default-src 'self', script/style 'self' + nonce),
       which blocks CDNs and inline scripts and left those pages unstyled (IP-T350).
       Pre-paint: theme-init.js applies the stored theme (dark default) before CSS to avoid a flash. *@
    <script src="js/theme-init.js"></script>
    <link rel="stylesheet" href="lib/fonts/fonts.css" />
    <link rel="stylesheet" href="lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="css/components.css" />
    <link rel="stylesheet" href="_content/IdiotProof.UI/css/options.css" />
    <link rel="stylesheet" href="_content/IdiotProof.UI/css/tooltip.css" />
    <HeadOutlet @rendermode="@RenderMode.InteractiveServer" />
</head>
<body>
    <Routes @rendermode="@RenderMode.InteractiveServer" />
    <script src="lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="_framework/blazor.server.js"></script>
    <script src="app.js"></script>
    <script src="js/live-chart.js"></script>
    <script src="lib/lightweight-charts/lightweight-charts.standalone.production.js"></script>
    <script src="js/ip-chart.js"></script>
    <script src="js/strategy-preview.js"></script>
    <script src="_content/IdiotProof.UI/js/focus-trap.js"></script>
    <script src="_content/IdiotProof.UI/js/tooltip.js" defer></script>
</body>
</html>
