<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <ErrorBoundary>
            <ChildContent>
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                    <NotAuthorized>
                        <RedirectToLogin />
                    </NotAuthorized>
                </AuthorizeRouteView>
            </ChildContent>
            <ErrorContent Context="ex">
                <LayoutView Layout="typeof(Layout.MainLayout)">
                    <div class="container mt-5 text-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-1 text-warning d-block mb-3" aria-hidden="true"></i>
                        <h1 class="h4">Something went wrong</h1>
                        <p class="text-muted small">@ex.Message</p>
                        <a href="/" class="btn btn-outline-secondary mt-2">Back to Strategies</a>
                    </div>
                </LayoutView>
            </ErrorContent>
        </ErrorBoundary>
        @* No FocusOnNavigate: pages load with no element focused so users must press Tab to begin keyboard navigation. *@
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="container mt-5 text-center" role="alert">
                <h1 class="text-muted">404 — Page not found</h1>
                <p class="text-muted">The page you requested could not be located.</p>
                <a href="/" class="btn btn-outline-secondary mt-3">Back to Strategies</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
