<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        @* No FocusOnNavigate: pages load with no element focused so users must press Tab to begin keyboard navigation. *@
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="container mt-5 text-center" role="alert">
                <h1 class="text-muted">404 — Page not found</h1>
                <p class="text-muted">The page you requested could not be located.</p>
                <a href="/" class="btn btn-outline-secondary mt-3">Back to Dashboard</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
