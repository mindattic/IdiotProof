@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthState

@* CDN <link>s and <script>s moved to App.razor so they live in the host page
   and execute exactly once at load time. Blazor does not run <script> tags
   rendered as part of an interactive component's output, which is why the
   Bootstrap dropdown previously failed to bind. *@

<div class="app-shell d-flex flex-column" style="min-height:100vh;">
    <!-- Top Bar: brand · account pill · primary tabs · user menu -->
    <header class="navbar top-bar px-3 py-1 flex-shrink-0 d-flex align-items-center gap-3" role="banner">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2 m-0" href="/" aria-label="IdiotProof home">
            <i class="bi bi-graph-up-arrow" style="color:var(--green)" aria-hidden="true"></i>
            IdiotProof
        </a>

        <AuthorizeView>
            <Authorized>
                <IdiotProof.Blazor.Components.Shared.AccountPill />
            </Authorized>
        </AuthorizeView>

        <!-- Primary tabs (horizontal) -->
        <AuthorizeView>
            <Authorized>
                <nav class="top-tabs d-flex align-items-center gap-1 ms-2" aria-label="Primary">
                    <NavLink class="top-tab" href="/" Match="NavLinkMatch.All" aria-label="Strategies">
                        <i class="bi bi-collection me-1" aria-hidden="true"></i>Strategies
                    </NavLink>
                    <NavLink class="top-tab" href="/gapper" aria-label="Gapper">
                        <i class="bi bi-sunrise me-1" aria-hidden="true"></i>Gapper
                    </NavLink>
                    <NavLink class="top-tab" href="/logs" aria-label="Logs">
                        <i class="bi bi-journal-text me-1" aria-hidden="true"></i>Logs<LogsBadge />
                    </NavLink>
                    <NavLink class="top-tab" href="/builder" aria-label="Editor">
                        <i class="bi bi-code-square me-1" aria-hidden="true"></i>Editor
                    </NavLink>
                    <NavLink class="top-tab" href="/backtest" aria-label="Backtest">
                        <i class="bi bi-clock-history me-1" aria-hidden="true"></i>Backtest
                    </NavLink>
                    <NavLink class="top-tab" href="/learn" aria-label="Learn">
                        <i class="bi bi-book me-1" aria-hidden="true"></i>Learn
                    </NavLink>
                    <NavLink class="top-tab" href="/research" aria-label="Research">
                        <i class="bi bi-search me-1" aria-hidden="true"></i>Research
                    </NavLink>
                </nav>
            </Authorized>
        </AuthorizeView>

        <!-- User menu (right) -->
        <div class="ms-auto">
            <AuthorizeView>
                <Authorized>
                    <div class="dropdown">
                        <button class="btn btn-sm user-menu-toggle d-flex align-items-center gap-2"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                aria-label="User menu">
                            <i class="bi bi-person-circle" aria-hidden="true"></i>
                            <span class="user-menu-name">@(context.User.Identity?.Name ?? "Account")</span>
                            <i class="bi bi-chevron-down small" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-menu-dropdown" role="menu">
                            <li>
                                <a class="dropdown-item" href="/api-keys" role="menuitem">
                                    <i class="bi bi-key me-2" aria-hidden="true"></i>API Keys
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/settings" role="menuitem">
                                    <i class="bi bi-gear me-2" aria-hidden="true"></i>Settings
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form method="post" action="/logout" style="margin:0">
                                    <AntiforgeryToken />
                                    <button type="submit" class="dropdown-item text-danger" role="menuitem">
                                        <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="main-content flex-grow-1 overflow-auto p-3" tabindex="-1">
        @Body
    </main>
</div>

<IdiotProof.Blazor.Components.Shared.ToastContainer />
