@page "/builder"
@page "/builder/{StrategyId:guid}"
@rendermode InteractiveServer
@using IdiotProof.Blazor.Data
@using IdiotProof.Blazor.Services
@using IdiotProof.Scripting
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Reflection
@attribute [Authorize]
@inject StrategyRepository StrategyRepo
@inject StrategyScriptGenerator ScriptGenerator
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject GapperProfileService ProfileService
@inject IJSRuntime JS
@using System.Globalization

@*
    IdiotScript Editor — the north star. Three panes:
        • Left  : verb palette (reflection on StrategyBuilder + Conditions). Click
                  to append the verb to the script textarea.
        • Right : the script editor + live visual preview via StrategyBuilderRenderer.
        • Below : prose-to-script assist powered by Legion (StrategyScriptGenerator).

    Save writes a Strategy row. The Monitor (StrategyExecutionService) picks up
    every IsActive=true row on its next tick and runs the parsed script.

    Full drag-and-drop WYSIWYG canvas is the next iteration; this pass keeps
    the surface area small while still showing the verb catalog and AI assist.
*@

<PageTitle>@(string.IsNullOrEmpty(title) ? "New Strategy" : title) — Editor</PageTitle>

<section class="d-flex flex-column gap-3" aria-labelledby="builder-heading">

    <!-- Header: title, symbol, active, save -->
    <div class="trading-card p-3 d-flex flex-wrap gap-2 align-items-end">
        <div class="flex-grow-1" style="min-width:200px">
            <label for="b-title" class="form-label text-muted small mb-1">Title</label>
            <input id="b-title" class="form-control" placeholder="e.g. TSLA reclaim 9 EMA"
                   @bind="title" />
        </div>
        <div style="width:140px">
            <label for="b-symbol" class="form-label text-muted small mb-1">Symbol</label>
            <input id="b-symbol" class="form-control" placeholder="TSLA"
                   @bind="symbol" />
        </div>
        <div class="form-check form-switch align-self-end mb-2">
            <input class="form-check-input" type="checkbox" id="b-active" @bind="isActive" />
            <label class="form-check-label text-muted small" for="b-active">Active (Monitor will evaluate)</label>
        </div>
        <button class="btn btn-success" type="button" @onclick="Save" disabled="@busy">
            <i class="bi bi-floppy me-1" aria-hidden="true"></i>@(busy ? "Saving…" : "Save")
        </button>
        <button class="btn btn-outline-secondary" type="button" @onclick='() => Nav.NavigateTo("/")'>
            Cancel
        </button>
    </div>

    @if (!string.IsNullOrEmpty(saveMessage))
    {
        <div class="alert @(saveOk ? "alert-success" : "alert-danger") py-2 mb-0" role="status">@saveMessage</div>
    }

    <!-- Mode tabs: Manual (verb palette + DSL editor) or From Profile (preset dials) -->
    <div>
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button type="button" class="nav-link @(builderMode == "manual" ? "active" : "")"
                        role="tab" aria-selected="@(builderMode == "manual")"
                        @onclick='() => builderMode = "manual"'>
                    <i class="bi bi-code-slash me-1" aria-hidden="true"></i>Manual
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button type="button" class="nav-link @(builderMode == "preset" ? "active" : "")"
                        role="tab" aria-selected="@(builderMode == "preset")"
                        @onclick='() => { builderMode = "preset"; InitPresetTab(); }'>
                    <i class="bi bi-sliders me-1" aria-hidden="true"></i>From Profile
                </button>
            </li>
        </ul>

    @if (builderMode == "manual")
    {
    <div class="row g-3">

        <!-- Verb palette -->
        <aside class="col-lg-3" aria-label="IdiotScript verbs">
            <div class="trading-card p-3">
                <h2 class="h6 mb-3">
                    <i class="bi bi-puzzle me-1" aria-hidden="true"></i>Verbs
                </h2>
                <input class="form-control form-control-sm mb-2"
                       placeholder="filter…"
                       @bind="verbFilter"
                       @bind:event="oninput"
                       aria-label="Filter verbs" />
                @foreach (var group in VerbGroups)
                {
                    var filtered = group.Verbs
                        .Where(v => string.IsNullOrWhiteSpace(verbFilter)
                                    || v.Contains(verbFilter, StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    if (filtered.Count == 0) continue;
                    <div class="mb-2">
                        <div class="text-muted small text-uppercase" style="font-size:0.7rem;letter-spacing:0.05em">@group.Label</div>
                        <ul class="list-unstyled mb-0">
                            @foreach (var v in filtered)
                            {
                                <li>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary text-start w-100 mb-1"
                                            style="font-family:ui-monospace,monospace;font-size:0.75rem"
                                            @onclick="() => AppendVerb(v)"
                                            aria-label="Insert @v">
                                        .@v
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </aside>

        <!-- Editor + preview -->
        <main class="col-lg-9 d-flex flex-column gap-3">
            <div class="trading-card p-3">
                <div class="d-flex justify-content-between mb-2">
                    <label for="b-script" class="form-label text-muted small mb-0">IdiotScript</label>
                    <span class="text-muted small">@scriptText.Length chars</span>
                </div>
                <textarea id="b-script"
                          class="form-control"
                          rows="14"
                          style="font-family:ui-monospace,monospace;font-size:0.85rem"
                          @bind="scriptText"
                          @bind:event="oninput"
                          spellcheck="false"
                          placeholder='Stock.Ticker("TSLA").RequireAdxAbove(20).IsAboveVwap().Long().StopLoss(9.50).TakeProfit(12.00).Build();'></textarea>
            </div>

            <!-- AI assist -->
            <div class="trading-card p-3">
                <h2 class="h6 mb-2">
                    <i class="bi bi-stars me-1" style="color:var(--brand)" aria-hidden="true"></i>Describe it in English — Legion will write the IdiotScript
                </h2>
                <textarea id="b-prose"
                          class="form-control mb-2"
                          rows="3"
                          placeholder="e.g. Watch XYZ for a breakout over 5, then a pullback to 4.75. Buy when that pattern hits. Sell at 10% profit or stop at 4.50."
                          @bind="aiProse"
                          @bind:event="oninput"></textarea>
                <div class="d-flex gap-2 align-items-center">
                    <button id="b-generate" class="btn btn-primary btn-sm" type="button" @onclick="Generate" disabled="@aiBusy">
                        <i class="bi bi-magic me-1" aria-hidden="true"></i>@(aiBusy ? "Thinking…" : "Generate")
                    </button>
                    @if (!string.IsNullOrEmpty(aiError))
                    {
                        <span class="text-danger small">@aiError</span>
                    }
                </div>
            </div>
        </main>
    </div>
    }
    else
    {
        <!-- From Profile tab: pick a gapper preset, dial in the variables, load into the editor -->
        @if (dial is not null)
        {
        <div class="trading-card p-3 mt-3">
            <!-- Profile selector -->
            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <label class="text-muted small fw-semibold mb-0">Profile</label>
                <select class="form-select" style="max-width:240px"
                        value="@selectedProfileId"
                        @onchange="OnPresetProfileSelected">
                    @foreach (var p in profiles)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
                @if (CurrentProfile is { Description: { } desc } && !string.IsNullOrEmpty(desc))
                {
                    <span class="text-muted small" style="max-width:340px">@desc</span>
                }
            </div>

            <!-- Dial grid -->
            <div class="row g-3">
                <!-- Gap screen -->
                <div class="col-md-4">
                    <p class="fw-semibold mb-2" style="font-size:.68rem;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted)">Gap screen</p>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Min gap %</label>
                        <input type="number" class="form-control form-control-sm" step="0.5"
                               @bind="dial.MinGapPercent" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Max gap % <span style="font-size:.7rem">(blank = no cap)</span></label>
                        <input type="text" class="form-control form-control-sm" placeholder="—"
                               @bind="maxGapText" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Min vol ratio</label>
                        <input type="number" class="form-control form-control-sm" step="0.1"
                               @bind="dial.MinVolumeRatio" @bind:event="oninput" />
                    </div>
                    <div class="d-flex gap-2">
                        <div class="flex-grow-1">
                            <label class="form-label small text-muted mb-1">Min $</label>
                            <input type="number" class="form-control form-control-sm"
                                   @bind="dial.MinPrice" @bind:event="oninput" />
                        </div>
                        <div class="flex-grow-1">
                            <label class="form-label small text-muted mb-1">Max $</label>
                            <input type="number" class="form-control form-control-sm"
                                   @bind="dial.MaxPrice" @bind:event="oninput" />
                        </div>
                    </div>
                </div>

                <!-- Entry windows -->
                <div class="col-md-4">
                    <p class="fw-semibold mb-2" style="font-size:.68rem;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted)">Windows (ET)</p>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Entry from</label>
                        <input type="text" class="form-control form-control-sm" placeholder="04:00"
                               @bind="dial.EntryWindowStartEt" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Entry until</label>
                        <input type="text" class="form-control form-control-sm" placeholder="09:00"
                               @bind="dial.EntryWindowEndEt" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Arm giveback at</label>
                        <input type="text" class="form-control form-control-sm" placeholder="09:15"
                               @bind="dial.ArmExitAtEt" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Sell by</label>
                        <input type="text" class="form-control form-control-sm" placeholder="09:28"
                               @bind="dial.SellByEt" @bind:event="oninput" />
                    </div>
                </div>

                <!-- Risk & exit -->
                <div class="col-md-4">
                    <p class="fw-semibold mb-2" style="font-size:.68rem;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted)">Risk &amp; exit</p>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Stop loss %</label>
                        <input type="number" class="form-control form-control-sm" step="0.5"
                               @bind="dial.StopLossPercent" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Trailing stop % <span style="font-size:.7rem">(blank = off)</span></label>
                        <input type="text" class="form-control form-control-sm" placeholder="—"
                               @bind="trailingText" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Peak giveback %</label>
                        <input type="number" class="form-control form-control-sm" step="5"
                               @bind="dial.PeakGivebackPercent" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1">Size (notional $)</label>
                        <input type="number" class="form-control form-control-sm" step="100"
                               @bind="dial.DefaultNotional" @bind:event="oninput" />
                    </div>
                </div>
            </div>

            <!-- Script preview -->
            <details class="mt-3">
                <summary class="text-muted small" style="cursor:pointer">
                    <i class="bi bi-eye me-1" aria-hidden="true"></i>Preview generated IdiotScript
                </summary>
                <pre class="mt-2 p-2 small" style="background:var(--bg-row-alt);border-radius:6px;overflow-x:auto;white-space:pre-wrap">@PresetScriptPreview</pre>
            </details>

            <!-- Load button -->
            <div class="d-flex align-items-center gap-2 mt-3 pt-2" style="border-top:1px solid var(--border)">
                <button class="btn btn-success" type="button"
                        @onclick="LoadPresetIntoEditor"
                        disabled="@string.IsNullOrWhiteSpace(symbol)">
                    <i class="bi bi-arrow-right-circle me-1" aria-hidden="true"></i>Load into Editor
                </button>
                <span class="text-muted small">
                    @(string.IsNullOrWhiteSpace(symbol)
                        ? "Enter a symbol in the header first."
                        : "Loads the generated script into the Manual tab for editing and saving.")
                </span>
            </div>
        </div>
        }
    }
    </div>

</section>

@if (showDisambigModal)
{
    <div class="modal-backdrop fade show" @onclick="() => showDisambigModal = false"></div>
    <div class="modal fade show d-block" role="dialog" aria-modal="true"
         aria-labelledby="disambig-title" tabindex="-1"
         @ref="disambigModalRef" @onkeydown="OnDisambigKeyDown">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-light border border-warning">
                <div class="modal-header border-warning">
                    <h5 id="disambig-title" class="modal-title">You already hold @disambigSymbol</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-3">
                        You have <strong>@disambigHoldingCount existing @disambigSymbol position(s)</strong> tracked by the Monitor.
                        How should this new strategy behave?
                    </p>
                    <div class="d-grid gap-2">
                        <button class="btn btn-success" type="button" @onclick="DisambigCloseExisting">
                            Close my existing position
                            <small class="d-block text-white-50 fw-normal">Monitor starts managing the exit immediately (Live mode, PositionQty=1).</small>
                        </button>
                        <button class="btn btn-outline-danger" type="button" @onclick="DisambigNewShort">
                            Open a new Short on @disambigSymbol
                            <small class="d-block text-danger-emphasis fw-normal">Saves normally — strategy direction governs the order side.</small>
                        </button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="DisambigIgnore">
                            Save as-is (I know what I'm doing)
                        </button>
                        <button class="btn btn-link text-muted" type="button" @onclick="() => showDisambigModal = false">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? StrategyId { get; set; }

    // Learn-page deep links: /builder?seed=<script>&ticker=<symbol> pre-fills
    // the editor with an example script (IP-US-I2 "Open in Builder").
    [SupplyParameterFromQuery] public string? Seed { get; set; }
    [SupplyParameterFromQuery] public string? Ticker { get; set; }

    private string title       = "";
    private string symbol      = "";
    private string scriptText  = "";
    private bool   isActive    = false;
    private bool   busy        = false;
    private bool   saveOk      = false;
    private string saveMessage = "";

    private string aiProse = "";
    private bool   aiBusy  = false;
    private string aiError = "";

    private string verbFilter = "";
    private Guid userId;

    // Disambiguation modal — shown when saving a new strategy for a ticker already held.
    private bool   showDisambigModal   = false;
    private string disambigSymbol      = "";
    private int    disambigHoldingCount = 0;
    private bool   disambigConfirmed   = false;
    private bool   disambigCloseIntent = false;
    private ElementReference disambigModalRef;
    private bool   disambigModalWasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showDisambigModal && !disambigModalWasOpen)
            await JS.InvokeVoidAsync("focusTrap.activate", disambigModalRef);
        else if (!showDisambigModal && disambigModalWasOpen)
            await JS.InvokeVoidAsync("focusTrap.deactivate");
        disambigModalWasOpen = showDisambigModal;
    }

    // Verb taxonomy — discovered once via reflection so the palette tracks the DSL.
    // The same reflection feeds StrategyScriptGenerator's system prompt, so the
    // palette + AI assist always know the same vocabulary.
    private static readonly (string Label, List<string> Verbs)[] VerbGroups = BuildVerbGroups();

    // Which route id / seed the editor currently reflects. Loading lives in
    // OnParametersSetAsync (NOT OnInitializedAsync): Blazor REUSES this
    // component instance when navigating /builder/{A} → /builder/{B} (browser
    // back/forward) or → /builder ("Create New"), so an init-only load left
    // strategy A's fields on screen under strategy B's route id — and Save
    // would overwrite B with A's content.
    private Guid? loadedStrategyId;
    private string? appliedSeed;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out userId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (StrategyId is { } id)
        {
            if (loadedStrategyId == id) return; // already showing this row

            var existing = await StrategyRepo.GetByIdAsync(id);
            if (existing is not null && existing.OwnerUserId == userId)
            {
                title      = existing.Title;
                symbol     = existing.Symbol;
                scriptText = existing.ScriptText;
                isActive   = existing.IsActive;
                loadedStrategyId = id;
                saveMessage = "";
            }
            else
            {
                // Not found or not owned by this user: drop the route id so a
                // Save can never resolve (and overwrite) someone else's row.
                StrategyId = null;
                loadedStrategyId = null;
                ResetEditor();
            }
        }
        else
        {
            // Route carries no id ("Create New" after an edit, or a Learn-page
            // seed link) — clear any previously loaded row's fields.
            if (loadedStrategyId is not null)
            {
                loadedStrategyId = null;
                ResetEditor();
            }
            if (!string.IsNullOrWhiteSpace(Seed) && Seed != appliedSeed)
            {
                // Deep link from the Learn page: seed the editor with the example.
                scriptText = Seed;
                appliedSeed = Seed;
                if (!string.IsNullOrWhiteSpace(Ticker))
                    symbol = Ticker.ToUpperInvariant();
            }
        }
    }

    private void ResetEditor()
    {
        title = ""; symbol = ""; scriptText = "";
        isActive = false; saveOk = false; saveMessage = "";
        showDisambigModal = false; disambigConfirmed = false; disambigCloseIntent = false;
    }

    private void AppendVerb(string verb)
    {
        if (!scriptText.EndsWith("."))
        {
            if (!scriptText.EndsWith(")") && !string.IsNullOrWhiteSpace(scriptText))
                scriptText = scriptText.TrimEnd() + ")";
        }
        var sep = string.IsNullOrWhiteSpace(scriptText) ? "Stock.Ticker(\"" + (string.IsNullOrWhiteSpace(symbol) ? "SYMBOL" : symbol.ToUpperInvariant()) + "\")\n    ." : "\n    .";
        scriptText = scriptText.TrimEnd() + sep + verb;
    }

    private async Task Save()
    {
        saveMessage = "";
        if (string.IsNullOrWhiteSpace(title))   { saveMessage = "Title is required."; saveOk = false; return; }
        if (string.IsNullOrWhiteSpace(symbol))  { saveMessage = "Symbol is required."; saveOk = false; return; }
        if (string.IsNullOrWhiteSpace(scriptText)) { saveMessage = "Script is empty."; saveOk = false; return; }

        busy = true;
        try
        {
            Strategy? existing = StrategyId is { } id
                ? await StrategyRepo.GetByIdAsync(id)
                : null;

            // Ownership gate (IDOR guard): the route id is user-controlled, so
            // never let a Save resolve to another user's row. OnInitializedAsync
            // already clears foreign ids, but re-check here — the update below
            // writes whatever row `existing` resolves to.
            if (existing is not null && existing.OwnerUserId != userId)
            {
                saveOk = false;
                saveMessage = "You don't own this strategy.";
                return;
            }

            if (existing is null)
            {
                // Disambiguation: warn if the user already holds this ticker.
                if (!disambigConfirmed)
                {
                    var holdCount = await StrategyRepo.CountHoldingForSymbolAsync(userId, symbol.Trim());
                    if (holdCount > 0)
                    {
                        disambigSymbol       = symbol.Trim().ToUpperInvariant();
                        disambigHoldingCount = holdCount;
                        showDisambigModal    = true;
                        return;
                    }
                }

                var created = await StrategyRepo.CreateAsync(
                    ownerUserId: userId,
                    title:       title.Trim(),
                    symbol:      symbol.Trim(),
                    scriptText:  scriptText);
                if (isActive)
                    await StrategyRepo.SetActiveAsync(created.Id, true, userId);

                // "Close existing" intent: mark as already holding so Monitor manages exit.
                if (disambigCloseIntent)
                    await StrategyRepo.MarkAsExistingPositionAsync(created.Id, 1, userId);

                StrategyId = created.Id;
                loadedStrategyId = created.Id; // editor already shows this row
            }
            else
            {
                // Same open-position guard SetActiveAsync enforces (IP-A16):
                // this direct-Update path must not deactivate a holding row —
                // the Monitor only manages exits on active strategies.
                if (existing.PositionQty > 0 && existing.IsActive && !isActive)
                {
                    saveOk = false;
                    saveMessage = $"{existing.Symbol} is holding {existing.PositionQty} shares — the Monitor must stay active to manage the exit. Flatten first, then deactivate.";
                    return;
                }
                existing.Title      = title.Trim();
                existing.Symbol     = symbol.Trim().ToUpperInvariant();
                existing.ScriptText = scriptText;
                existing.IsActive   = isActive;
                var result = await StrategyRepo.UpdateAsync(existing);
                if (result == StrategyMutation.PositionOpen)
                {
                    // Repo-level re-check against the FRESH row (the pre-check
                    // above used a snapshot that may be seconds stale).
                    saveOk = false;
                    saveMessage = $"{existing.Symbol} is holding shares — the Monitor must stay active to manage the exit. Flatten first, then deactivate.";
                    return;
                }
                if (result != StrategyMutation.Ok)
                {
                    saveOk = false;
                    saveMessage = "Save failed — the strategy no longer exists (or isn't yours).";
                    return;
                }
            }

            saveOk = true;
            saveMessage = $"Saved. {(isActive ? "Monitor will evaluate on its next tick." : "Toggle Active to send it to the Monitor.")}";
        }
        catch (Exception ex)
        {
            saveOk = false;
            saveMessage = "Save failed: " + ex.Message;
        }
        finally
        {
            busy = false;
            disambigConfirmed = false;
            disambigCloseIntent = false;
        }
    }

    private void OnDisambigKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") showDisambigModal = false;
    }

    private async Task DisambigCloseExisting()
    {
        showDisambigModal = false;
        disambigConfirmed = true;
        disambigCloseIntent = true;
        await Save();
    }

    private async Task DisambigNewShort()
    {
        showDisambigModal = false;
        disambigConfirmed = true;
        disambigCloseIntent = false;
        await Save();
    }

    private async Task DisambigIgnore()
    {
        showDisambigModal = false;
        disambigConfirmed = true;
        disambigCloseIntent = false;
        await Save();
    }

    private async Task Generate()
    {
        aiError = "";
        if (string.IsNullOrWhiteSpace(aiProse))
        {
            aiError = "Describe the strategy in plain English first.";
            return;
        }

        aiBusy = true;
        try
        {
            var result = await ScriptGenerator.GenerateAsync(aiProse, symbol);
            if (result.Success)
            {
                scriptText = result.Script;
                // Parse-check what Claude produced: invented verbs are
                // silently dropped by the tolerant parser (IP-LAW-4 says they
                // "fail to parse", but nothing TOLD the user), so a
                // hallucinated condition would quietly vanish from the saved
                // strategy. Warning only — the script stays in the editor.
                try
                {
                    if (ScriptParser.ParseScript(result.Script) is null)
                        aiError = "Heads up: the generated script could not be parsed — review it (or regenerate) before saving.";
                }
                catch (Exception)
                {
                    aiError = "Heads up: the generated script did not fully parse — review the highlighted preview before saving; unrecognized verbs are ignored.";
                }
            }
            else
            {
                aiError = result.Error ?? "Generation failed.";
            }
        }
        catch (Exception ex)
        {
            aiError = ex.Message;
        }
        finally
        {
            aiBusy = false;
        }
    }

    // ── Preset (From Profile) tab ──────────────────────────────────────────────
    private string builderMode = "manual";
    private List<GapperProfile> profiles = new();
    private string? selectedProfileId;
    private GapperProfile? dial;
    private string maxGapText = "";
    private string trailingText = "";
    private bool presetInitialized = false;

    private GapperProfile? CurrentProfile =>
        profiles.FirstOrDefault(p => p.Id == selectedProfileId);

    private string PresetScriptPreview
    {
        get
        {
            if (dial is null || string.IsNullOrWhiteSpace(symbol)) return "(enter a symbol above to see the preview)";
            try
            {
                SyncNullableDialFields();
                return GapperScriptFactory.ToScript(symbol.Trim().ToUpperInvariant(), dial);
            }
            catch
            {
                return "(preview unavailable — check dial values)";
            }
        }
    }

    private void InitPresetTab()
    {
        if (presetInitialized) return;
        presetInitialized = true;
        profiles = ProfileService.GetProfiles().ToList();
        if (profiles.Count > 0)
        {
            selectedProfileId = profiles[0].Id;
            LoadDial(profiles[0]);
        }
    }

    private void OnPresetProfileSelected(ChangeEventArgs e)
    {
        selectedProfileId = e.Value?.ToString();
        var profile = profiles.FirstOrDefault(p => p.Id == selectedProfileId);
        if (profile is not null) LoadDial(profile);
    }

    private void LoadDial(GapperProfile profile)
    {
        dial = profile.Clone();
        maxGapText = dial.MaxGapPercent?.ToString(CultureInfo.InvariantCulture) ?? "";
        trailingText = dial.TrailingStopPercent?.ToString(CultureInfo.InvariantCulture) ?? "";
    }

    private void SyncNullableDialFields()
    {
        if (dial is null) return;
        dial.MaxGapPercent = string.IsNullOrWhiteSpace(maxGapText)
            ? null
            : double.TryParse(maxGapText, NumberStyles.Any, CultureInfo.InvariantCulture, out var mg) ? mg : dial.MaxGapPercent;
        dial.TrailingStopPercent = string.IsNullOrWhiteSpace(trailingText)
            ? null
            : double.TryParse(trailingText, NumberStyles.Any, CultureInfo.InvariantCulture, out var ts) ? ts : dial.TrailingStopPercent;
    }

    private void LoadPresetIntoEditor()
    {
        if (dial is null || string.IsNullOrWhiteSpace(symbol)) return;
        SyncNullableDialFields();
        scriptText = GapperScriptFactory.ToScript(symbol.Trim().ToUpperInvariant(), dial);
        builderMode = "manual";
    }

    // ── Verb palette ───────────────────────────────────────────────────────────
    private static (string Label, List<string> Verbs)[] BuildVerbGroups()
    {
        // Single source of truth (IP-LAW-4): the same reflected, phase-bucketed
        // catalog the LLM system prompt and Learning Center use. The palette
        // previously re-implemented the bucketing with drifted prefix rules
        // and lost verbs into an "Other" bucket (audit 2026-07-18, H3).
        var groups = StrategyScriptGenerator.GetVerbsByPhase()
            .Select(g => (g.Phase, g.Verbs.OrderBy(s => s, StringComparer.Ordinal).ToList()))
            .ToList();
        groups.Add(("Conditions", StrategyScriptGenerator.GetConditionCatalog()
            .OrderBy(s => s, StringComparer.Ordinal).ToList()));
        return groups.ToArray();
    }
}
