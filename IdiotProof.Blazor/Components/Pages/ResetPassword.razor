@page "/account/reset"
@attribute [AllowAnonymous]
@layout EmptyLayout
@using MindAttic.Authentication.Components

<PageTitle>Set a New Password — IdiotProof</PageTitle>

<main class="login-wrapper" id="main-content">
    <section class="login-card" aria-labelledby="reset-pw-heading">
        <div class="login-logo">
            <span class="logo-icon" aria-hidden="true">⚡</span>
            <h1 id="reset-pw-heading">IdiotProof</h1>
            <p class="logo-sub">Set a new password</p>
        </div>

        @* Target of the emailed reset link: MindAttic:Auth:Reset:PublicBaseUrl + the library's ResetPath
           (/account/reset) + ?token=. Static-SSR; MaResetPassword posts to /_ma-auth/reset/confirm, which
           redirects to /login?reset=ok on success or back here with ?error=1&token=... *@
        <MaResetPassword Token="@Token" Error="@(Error == 1)" />

        <p class="login-warning" style="margin-top:1rem">
            <a href="/login" style="color:#79c0ff">Back to sign in</a>
        </p>
    </section>
</main>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery] public int Error { get; set; }
}

<style>
.login-wrapper { min-height:100vh; display:flex; align-items:center; justify-content:center; background:var(--bg-primary,#0d1117); }
.login-card { width:100%; max-width:380px; background:var(--bg-card,#1c2128); border:1px solid var(--border,#30363d); border-radius:12px; padding:2.5rem; }
.login-logo { text-align:center; margin-bottom:2rem; }
.logo-icon { font-size:2.5rem; }
.login-logo h1 { font-size:1.8rem; font-weight:700; color:#e6edf3; margin:0.25rem 0; }
.logo-sub { color:#8b949e; font-size:0.85rem; }
.ma-auth-field { display:block; margin-bottom:1.25rem; }
.ma-auth-field span { display:block; color:#8b949e; font-size:0.85rem; margin-bottom:0.4rem; }
.ma-auth-field input { width:100%; padding:0.6rem 0.85rem; background:#0d1117; border:1px solid #30363d; border-radius:6px; color:#e6edf3; font-size:1rem; box-sizing:border-box; }
.ma-auth-field input:focus { outline:none; border-color:#388bfd; box-shadow:0 0 0 3px rgba(56,139,253,0.15); }
.ma-auth-submit { width:100%; padding:0.7rem; background:#238636; color:#fff; border:none; border-radius:6px; font-size:1rem; font-weight:600; cursor:pointer; transition:background 0.2s; margin-top:0.5rem; }
.ma-auth-submit:hover { background:#2ea043; }
.ma-auth-note { color:#3fb950; font-size:0.85rem; margin-bottom:1rem; }
.ma-auth-error { background:rgba(248,81,73,0.15); border:1px solid rgba(248,81,73,0.4); border-radius:6px; padding:0.75rem 1rem; font-size:0.85rem; color:#f85149; margin-bottom:1.25rem; }
.login-warning { margin-top:0.75rem; font-size:0.75rem; color:#6e7681; text-align:center; }
</style>
