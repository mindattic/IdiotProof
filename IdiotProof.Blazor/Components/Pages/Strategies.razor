@page "/"
@page "/dashboard"
@page "/strategies"
@rendermode InteractiveServer
@using IdiotProof.Blazor.Data
@using IdiotProof.Blazor.Services
@using IdiotProof.Scripting
@using IdiotProof.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject StrategyRepository StrategyRepo
@inject ConditionProgressRepository ProgressRepo
@inject ConditionProgressPusher ProgressPusher
@inject LiveModeElevationService ElevationSvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@implements IDisposable

@*
    Strategies — unified dashboard. All strategies for the signed-in user, with
    live condition progress, position state, P&L, and per-strategy paper/live routing.

    Cards view: card per strategy with inline state, broker mode badge, checkboxes for
    bulk actions (Activate/Deactivate/Paper/Live), and Blueprint expand on click.
    Table view: compact density, all rows visible at once (mirrors old Dashboard).

    Promoting a strategy to Live requires re-authentication (5-minute elevation window).
    Demoting Live → Paper is always immediate.
*@

<PageTitle>Strategies — IdiotProof</PageTitle>

<section aria-labelledby="strategies-heading">

    <!-- ── Page header ─────────────────────────────────────────────────────── -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h1 id="strategies-heading" class="h4 mb-0">
            <i class="bi bi-collection me-2" style="color:var(--brand)" aria-hidden="true"></i>Strategies
        </h1>

        <!-- Tabs in the header between title and actions -->
        <div class="btn-group btn-group-sm" role="group" aria-label="View mode">
            <button type="button"
                    class="btn @(viewMode == "cards" ? "btn-secondary" : "btn-outline-secondary")"
                    @onclick='() => SetViewModeAsync("cards")'>
                <i class="bi bi-grid-3x3-gap me-1" aria-hidden="true"></i>Cards
            </button>
            <button type="button"
                    class="btn @(viewMode == "table" ? "btn-secondary" : "btn-outline-secondary")"
                    @onclick='() => SetViewModeAsync("table")'>
                <i class="bi bi-table me-1" aria-hidden="true"></i>Table
            </button>
        </div>

        <div class="d-flex gap-2 align-items-stretch">
            <input class="form-control"
                   style="max-width:220px"
                   placeholder="Filter by title or ticker…"
                   @bind="filterText"
                   @bind:event="oninput"
                   aria-label="Filter strategies" />
            <button class="btn btn-success text-nowrap" type="button" @onclick="CreateNew">
                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Create New Strategy
            </button>
        </div>
    </div>

    <!-- ── Elevation status banner ─────────────────────────────────────────── -->
    @if (userId is not null && ElevationSvc.RemainingWindow(userId.Value) is { } window)
    {
        <div class="alert alert-warning py-2 small mb-2" role="status">
            <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>
            Live trading elevation active — @($"{(int)window.TotalMinutes}:{window.Seconds:D2}") remaining.
            <button class="btn btn-sm btn-outline-warning ms-2 py-0" @onclick="RevokeElevation">Revoke</button>
        </div>
    }

    <!-- ── Error ───────────────────────────────────────────────────────────── -->
    @if (loadError is not null)
    {
        <div class="alert alert-danger small">@loadError</div>
    }

    <!-- ── Bulk action bar (when selections exist) ─────────────────────────── -->
    @if (selectedIds.Count > 0)
    {
        <div class="d-flex align-items-center gap-2 mb-2 p-2 trading-card flex-wrap"
             style="border-left:3px solid var(--brand)">
            <span class="text-muted small fw-semibold">@selectedIds.Count selected</span>
            <div class="dropdown">
                <button class="btn btn-sm btn-secondary dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    Bulk Actions
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <button class="dropdown-item" @onclick="() => ApplyBulkActiveAsync(true)">
                            <i class="bi bi-play-fill me-2 text-success"></i>Activate Selected
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item" @onclick="() => ApplyBulkActiveAsync(false)">
                            <i class="bi bi-pause-fill me-2 text-muted"></i>Deactivate Selected
                        </button>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <button class="dropdown-item" @onclick='() => ApplyBulkBrokerModeAsync("Paper")'>
                            <i class="bi bi-shield-check me-2" style="color:var(--yellow)"></i>Toggle → Paper
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item text-danger" @onclick='() => ApplyBulkBrokerModeAsync("Live")'>
                            <i class="bi bi-broadcast me-2 text-danger"></i>Toggle → Live (requires auth)
                        </button>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <button class="dropdown-item" @onclick="() => selectedIds.Clear()">
                            <i class="bi bi-x-circle me-2"></i>Clear Selection
                        </button>
                    </li>
                </ul>
            </div>
            @if (!string.IsNullOrEmpty(bulkMessage))
            {
                <span class="small @(bulkMessage.StartsWith("⚠") ? "text-warning" : "text-success")">@bulkMessage</span>
            }
        </div>
    }

    <!-- ── Loading ────────────────────────────────────────────────────────── -->
    @if (loading)
    {
        <div class="text-muted small">
            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading…
        </div>
    }
    else if (filtered.Count == 0)
    {
        <div class="trading-card p-4 text-center">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-2" aria-hidden="true"></i>
            <div class="text-muted">No strategies yet.</div>
            <button class="btn btn-success btn-sm mt-3" type="button" @onclick="CreateNew">
                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Create your first strategy
            </button>
        </div>
    }

    <!-- ────────────────────────────────────────────────────────────────────── -->
    <!-- CARDS VIEW                                                             -->
    <!-- ────────────────────────────────────────────────────────────────────── -->
    @if (!loading && filtered.Count > 0 && viewMode == "cards")
    {
        <ul class="list-unstyled mb-0" role="list">
            @foreach (var s in filtered)
            {
                var loaded    = StrategyLoader.Load(s.ScriptJson, s.ScriptText);
                var hasPos    = s.PositionQty > 0;
                var posLabel  = loaded.Definition?.Direction == TradeDirection.Short
                    ? $"SHORT ×{s.PositionQty}"
                    : $"LONG ×{s.PositionQty}";
                decimal? pct  = null;
                if (hasPos && progress.TryGetValue(s.Id, out var cp) && cp.LastPrice.HasValue
                    && s.LastEntryPrice.HasValue && s.LastEntryPrice.Value != 0)
                    pct = (cp.LastPrice.Value - s.LastEntryPrice.Value) / s.LastEntryPrice.Value * 100m;

                <li @key="s.Id" class="trading-card mb-2" data-strategy-id="@s.Id">
                    <div class="d-flex align-items-center gap-2 p-3 strategy-row-header"
                         role="button"
                         tabindex="0"
                         aria-expanded="@expandedRows.Contains(s.Id).ToString().ToLower()"
                         @onclick="() => ToggleExpand(s.Id)"
                         @onkeydown="e => OnRowKeyNavigate(e, s.Id)">

                        <!-- Checkbox (does not expand row) -->
                        <div @onclick:stopPropagation class="d-flex align-items-center" style="flex-shrink:0">
                            <input type="checkbox" class="form-check-input m-0"
                                   checked="@selectedIds.Contains(s.Id)"
                                   @onchange="() => ToggleSelect(s.Id)"
                                   aria-label="Select @s.Title" />
                        </div>

                        <i class="bi bi-chevron-right text-muted"
                           style="transition:transform .18s;transform:@(expandedRows.Contains(s.Id) ? "rotate(90deg)" : "none")"
                           aria-hidden="true"></i>

                        <!-- Info area -->
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fw-semibold">@s.Title</span>
                                <span class="strategy-chip ticker-chip">@s.Symbol</span>

                                <!-- Broker mode badge -->
                                <button type="button"
                                        class="btn btn-sm py-0 @BrokerModeClass(s.BrokerMode)"
                                        style="font-size:.68rem;min-width:50px;line-height:1.3"
                                        title="@BrokerModeTitle(s.BrokerMode)"
                                        @onclick="() => ToggleBrokerModeAsync(s)"
                                        @onclick:stopPropagation>
                                    @if (s.BrokerMode == "Live")
                                    {
                                        <i class="bi bi-broadcast me-1" aria-hidden="true"></i>
                                    }
                                    @s.BrokerMode
                                </button>

                                <!-- Open position badge -->
                                @if (hasPos)
                                {
                                    <span class="strategy-chip long-chip">
                                        <i class="bi bi-currency-dollar" aria-hidden="true"></i>
                                        @posLabel @("@ $")@(s.LastEntryPrice?.ToString("0.00") ?? "—")
                                    </span>
                                    @if (pct.HasValue)
                                    {
                                        <span class="small fw-semibold @(pct > 0 ? "text-success" : "text-danger")">
                                            @(pct > 0 ? "+" : "")@pct.Value.ToString("0.0")%
                                        </span>
                                    }
                                }

                                <!-- Condition progress -->
                                @if (s.IsActive && progress.TryGetValue(s.Id, out var p))
                                {
                                    var fullPass = p.IsFullPass;
                                    <span class="strategy-chip @(fullPass ? "long-chip" : "filter-chip")"
                                          title="Last evaluated @EasternTime.Format(p.EvaluatedUtc, "HH:mm:ss 'ET'")">
                                        <i class="bi @(fullPass ? "bi-check-circle-fill" : "bi-hourglass-split")" aria-hidden="true"></i>
                                        @p.PassedCount/@p.TotalCount
                                        @if (!fullPass && !string.IsNullOrEmpty(p.FirstFailingVerb))
                                        {
                                            <span class="text-muted ms-1">· @p.FirstFailingVerb</span>
                                        }
                                    </span>
                                }
                                else if (s.IsActive && !hasPos)
                                {
                                    <span class="strategy-chip text-muted">
                                        <i class="bi bi-hourglass" aria-hidden="true"></i> awaiting
                                    </span>
                                }

                                @if (loaded.CanonicalError is not null)
                                {
                                    <span class="badge bg-danger" title="@loaded.CanonicalError">QUARANTINE</span>
                                }

                                @if (s.LastFiredUtc is { } lf)
                                {
                                    <span class="text-muted small">fired @EasternTime.Format(lf, "MMM d HH:mm 'ET'")</span>
                                }
                                <span class="text-muted small">created @EasternTime.Format(s.CreatedUtc, "MMM d, yyyy")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(s.Description))
                            {
                                <div class="text-muted small text-truncate" style="max-width:60ch">@s.Description</div>
                            }
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-2 align-items-center flex-shrink-0" @onclick:stopPropagation>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="@($"toggle-{s.Id}")"
                                       checked="@s.IsActive"
                                       aria-label="@(s.IsActive ? "Deactivate" : "Activate") @s.Title"
                                       @onchange="(e) => ToggleActive(s, (bool)(e.Value ?? false))" />
                                <label class="form-check-label small text-muted" for="@($"toggle-{s.Id}")">
                                    @(s.IsActive ? "Active" : "Paused")
                                </label>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary" type="button"
                                    aria-label="Edit @s.Title"
                                    @onclick="() => EditStrategy(s.Id)">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                            </button>
                            @if (s.IsActive)
                            {
                                <button class="btn btn-sm btn-outline-success" type="button"
                                        aria-label="Live chart for @s.Title"
                                        @onclick="@(() => Nav.NavigateTo($"/live/{s.Id}"))">
                                    <i class="bi bi-broadcast me-1" aria-hidden="true"></i>Live
                                </button>
                            }
                            <button class="btn btn-sm btn-outline-danger" type="button"
                                    aria-label="Delete @s.Title"
                                    @onclick="() => ConfirmDelete(s)">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    @if (expandedRows.Contains(s.Id))
                    {
                        <div style="border-top:1px solid rgba(255,255,255,.07)">
                            <StrategyBlueprintViz S="s" />
                        </div>
                    }
                </li>
            }
        </ul>
    }

    <!-- ────────────────────────────────────────────────────────────────────── -->
    <!-- TABLE VIEW (merged dashboard)                                          -->
    <!-- ────────────────────────────────────────────────────────────────────── -->
    @if (!loading && filtered.Count > 0 && viewMode == "table")
    {
        <div class="d-flex justify-content-end mb-2">
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-layout-three-columns me-1" aria-hidden="true"></i>Columns
                </button>
                <ul class="dropdown-menu dropdown-menu-end" style="min-width:160px">
                    @foreach (var col in AllTableCols)
                    {
                        <li>
                            <label class="dropdown-item d-flex align-items-center gap-2" style="cursor:pointer;user-select:none">
                                <input type="checkbox" checked="@visibleCols.Contains(col.Key)"
                                       @onchange="async () => await ToggleColumnAsync(col.Key)" />
                                @col.Label
                            </label>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0" style="font-size:0.88rem">
                <thead>
                    <tr>
                        <th style="width:30px">
                            <input type="checkbox" class="form-check-input m-0"
                                   @onchange="ToggleSelectAll"
                                   aria-label="Select all" />
                        </th>
                        <th style="white-space:nowrap">Symbol</th>
                        <th style="white-space:nowrap">Mode</th>
                        @if (visibleCols.Contains("price")) { <th class="text-end" style="white-space:nowrap">Price</th> }
                        @if (visibleCols.Contains("state")) { <th style="white-space:nowrap">State</th> }
                        @if (visibleCols.Contains("pnl"))   { <th class="text-end" style="white-space:nowrap">P&amp;L %</th> }
                        @if (visibleCols.Contains("sl"))    { <th class="text-end" style="white-space:nowrap">SL</th> }
                        @if (visibleCols.Contains("tp"))    { <th class="text-end" style="white-space:nowrap">TP</th> }
                        @if (visibleCols.Contains("cond"))  { <th class="text-center" style="white-space:nowrap">Conditions</th> }
                        @if (visibleCols.Contains("age"))   { <th style="white-space:nowrap">Updated</th> }
                        <th>Title</th>
                        <th style="white-space:nowrap">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in filtered)
                    {
                        var row = BuildTableRow(s);
                        <tr @key="s.Id" @onclick="() => EditStrategy(s.Id)" style="cursor:pointer">
                            <td @onclick:stopPropagation>
                                <input type="checkbox" class="form-check-input m-0"
                                       checked="@selectedIds.Contains(s.Id)"
                                       @onchange="() => ToggleSelect(s.Id)"
                                       aria-label="Select @s.Title" />
                            </td>
                            <td><span class="badge symbol-chip">@s.Symbol</span></td>
                            <td @onclick:stopPropagation>
                                <button type="button"
                                        class="btn btn-sm py-0 @BrokerModeClass(s.BrokerMode)"
                                        style="font-size:.65rem;min-width:46px;line-height:1.3"
                                        title="@BrokerModeTitle(s.BrokerMode)"
                                        @onclick="() => ToggleBrokerModeAsync(s)">
                                    @s.BrokerMode
                                </button>
                            </td>
                            @if (visibleCols.Contains("price"))
                            {
                                <td class="text-end" style="font-family:var(--font-mono);font-weight:600">
                                    @(row.LastPrice.HasValue ? $"${row.LastPrice.Value:0.00}" : "—")
                                </td>
                            }
                            @if (visibleCols.Contains("state"))
                            {
                                <td><span class="@TableStateClass(row.State) text-nowrap">@row.State</span></td>
                            }
                            @if (visibleCols.Contains("pnl"))
                            {
                                <td class="text-end @TablePnlClass(row.PnlPct)" style="font-family:var(--font-mono)">@row.PnlPct</td>
                            }
                            @if (visibleCols.Contains("sl"))
                            {
                                <td class="text-end text-muted" style="font-family:var(--font-mono)">@row.SlStr</td>
                            }
                            @if (visibleCols.Contains("tp"))
                            {
                                <td class="text-end text-muted" style="font-family:var(--font-mono)">@row.TpStr</td>
                            }
                            @if (visibleCols.Contains("cond"))
                            {
                                <td class="text-center">
                                    <span class="@TableCondClass(row)">@row.PassedCount/@row.TotalCount</span>
                                </td>
                            }
                            @if (visibleCols.Contains("age"))
                            {
                                <td class="text-muted" style="font-size:0.8rem">@TableAgeStr(row.LastPriceUtc)</td>
                            }
                            <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                                title="@s.Title" class="text-muted">@s.Title</td>
                            <td @onclick:stopPropagation>
                                <div class="d-flex gap-1">
                                    <div class="form-check form-switch m-0" style="min-width:60px">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               checked="@s.IsActive"
                                               @onchange="(e) => ToggleActive(s, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label small text-muted">
                                            @(s.IsActive ? "Active" : "Paused")
                                        </label>
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => ConfirmDelete(s)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- ── Delete modal ────────────────────────────────────────────────────── -->
    @if (deleteCandidate is not null)
    {
        <div class="modal-backdrop fade show" @onclick="() => deleteCandidate = null"></div>
        <div class="modal fade show d-block" role="dialog" aria-modal="true" aria-labelledby="del-title" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 id="del-title" class="h5 modal-title">Delete strategy?</h2>
                    </div>
                    <div class="modal-body">
                        <p>Permanently delete <strong>@deleteCandidate.Title</strong>? This cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary btn-sm" type="button" @onclick="() => deleteCandidate = null">Cancel</button>
                        <button class="btn btn-danger btn-sm" type="button" @onclick="DeleteConfirmed">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ── Password / elevation modal ─────────────────────────────────────── -->
    @if (showPasswordModal)
    {
        <div class="modal-backdrop fade show" @onclick="CancelPasswordModal"></div>
        <div class="modal fade show d-block" role="dialog" aria-modal="true"
             aria-labelledby="pw-modal-title" tabindex="-1"
             @onkeydown="OnPasswordModalKeyDown">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark border-danger">
                    <div class="modal-header border-danger">
                        <h2 id="pw-modal-title" class="h5 modal-title text-danger">
                            <i class="bi bi-shield-lock me-2" aria-hidden="true"></i>Enable Live Trading
                        </h2>
                    </div>
                    <div class="modal-body text-white">
                        <p class="text-warning small mb-2">
                            You are enabling <strong>live trading with real money</strong>.
                            Re-enter your password to open a 5-minute elevation window.
                        </p>
                        <input type="password" class="form-control bg-dark text-white border-secondary"
                               placeholder="Your password"
                               @bind="passwordInput"
                               @bind:event="oninput"
                               autocomplete="current-password" />
                        @if (!string.IsNullOrEmpty(passwordModalError))
                        {
                            <div class="alert alert-danger small py-1 mt-2">@passwordModalError</div>
                        }
                        @if (isVerifyingPassword)
                        {
                            <div class="text-muted small mt-2">
                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Verifying…
                            </div>
                        }
                    </div>
                    <div class="modal-footer border-danger">
                        <button class="btn btn-secondary" type="button" @onclick="CancelPasswordModal">Cancel</button>
                        <button class="btn btn-danger" type="button"
                                @onclick="ConfirmPasswordModalAsync"
                                disabled="@(isVerifyingPassword || string.IsNullOrEmpty(passwordInput))"
                                autofocus>
                            Confirm — Enable Live Trading
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

</section>

@code {
    // ── View state ────────────────────────────────────────────────────────────
    private bool loading = true;
    private string? loadError;
    private Guid? userId;
    private string filterText = "";
    private string viewMode = "cards";
    private bool viewModeLoaded;

    private List<Strategy> all = new();
    private readonly Dictionary<Guid, ConditionProgress> progress = new();
    private Strategy? deleteCandidate;
    private readonly HashSet<Guid> expandedRows = [];

    // ── Multi-select ──────────────────────────────────────────────────────────
    private readonly HashSet<Guid> selectedIds = [];
    private string bulkMessage = "";

    // ── Broker mode / elevation ───────────────────────────────────────────────
    private bool showPasswordModal;
    private string passwordInput = "";
    private string passwordModalError = "";
    private bool isVerifyingPassword;
    private Strategy? pendingLiveStrategy;   // single-strategy Live promotion
    private bool pendingBulkLive;            // bulk Live promotion

    // ── Table / dashboard view state ──────────────────────────────────────────
    private sealed record ColDef(string Key, string Label);
    private static readonly ColDef[] AllTableCols =
    [
        new("price", "Price"),
        new("state", "State"),
        new("pnl",   "P&L %"),
        new("sl",    "SL"),
        new("tp",    "TP"),
        new("cond",  "Conditions"),
        new("age",   "Last Update"),
    ];
    private static readonly HashSet<string> DefaultTableCols = ["state", "pnl", "cond", "price"];
    private const string ColsKey  = "idiotproof.dashboard.cols";
    private const string ViewKey  = "idiotproof.strategies.view";
    private HashSet<string> visibleCols = new(DefaultTableCols);
    private bool colsLoaded;

    private sealed record TableRow(
        Strategy Strategy, string State, string PnlPct, string SlStr, string TpStr,
        decimal? LastPrice, DateTime? LastPriceUtc, int PassedCount, int TotalCount);

    private List<Strategy> filtered => string.IsNullOrWhiteSpace(filterText)
        ? all
        : all.Where(s =>
            s.Title.Contains(filterText, StringComparison.OrdinalIgnoreCase)
         || s.Symbol.Contains(filterText, StringComparison.OrdinalIgnoreCase)
         || (s.Description?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var rawId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            userId = Guid.TryParse(rawId, out var uid) ? uid : null;
            if (userId is null) { loadError = "Sign in to view your strategies."; return; }

            all = await StrategyRepo.GetAllForUserAsync(userId.Value);
            await RefreshProgressAsync();
            ProgressPusher.ProgressChanged += OnProgressChanged;
        }
        catch (Exception ex) { loadError = ex.Message; }
        finally { loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || (viewModeLoaded && colsLoaded)) return;
        try
        {
            if (!viewModeLoaded)
            {
                viewModeLoaded = true;
                var savedView = await JS.InvokeAsync<string?>("localStorage.getItem", ViewKey);
                if (savedView is "cards" or "table") viewMode = savedView;
            }
            if (!colsLoaded)
            {
                colsLoaded = true;
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ColsKey);
                if (!string.IsNullOrWhiteSpace(saved))
                    visibleCols = saved.Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
            }
            StateHasChanged();
        }
        catch { }
    }

    private async void OnProgressChanged(IReadOnlyList<Guid> changedIds)
    {
        try { await InvokeAsync(async () => { await RefreshProgressAsync(); StateHasChanged(); }); }
        catch { /* circuit tearing down */ }
    }

    private async Task RefreshProgressAsync()
    {
        if (userId is not null)
        {
            var fresh = await StrategyRepo.GetAllForUserAsync(userId.Value);
            var byId = fresh.ToDictionary(s => s.Id);
            foreach (var s in all)
            {
                if (!byId.TryGetValue(s.Id, out var f)) continue;
                s.IsActive       = f.IsActive;
                s.BrokerMode     = f.BrokerMode;
                s.LastFiredUtc   = f.LastFiredUtc;
                s.FireCount      = f.FireCount;
                s.PositionQty    = f.PositionQty;
                s.LastEntryPrice = f.LastEntryPrice;
                s.EntryFilledUtc = f.EntryFilledUtc;
                s.LastExitPrice  = f.LastExitPrice;
                s.LastExitReason = f.LastExitReason;
                s.LastExitedUtc  = f.LastExitedUtc;
            }
        }

        var ids = all.Where(s => s.IsActive).Select(s => s.Id).ToList();
        if (ids.Count == 0) { progress.Clear(); return; }
        var rows = await ProgressRepo.GetForStrategyIdsAsync(ids);
        progress.Clear();
        foreach (var (k, v) in rows) progress[k] = v;
    }

    public void Dispose() => ProgressPusher.ProgressChanged -= OnProgressChanged;

    // ── View toggle ───────────────────────────────────────────────────────────

    private async Task SetViewModeAsync(string mode)
    {
        viewMode = mode;
        try { await JS.InvokeVoidAsync("localStorage.setItem", ViewKey, mode); } catch { }
