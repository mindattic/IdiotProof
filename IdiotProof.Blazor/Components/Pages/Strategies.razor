@page "/"
@page "/strategies"
@rendermode InteractiveServer
@using IdiotProof.Scripting
@using IdiotProof.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inherits StrategyListPageBase
@inject IJSRuntime JS

@*
    Strategies — cards view. All strategies for the signed-in user, with live
    condition progress, position state, P&L, and per-strategy paper/live routing.
    One card per strategy, checkboxes for bulk actions (Activate/Deactivate/Paper/Live),
    and Blueprint expand on click. The compact table view lives on the Dashboard tab.

    Promoting a strategy to Live requires re-authentication (5-minute elevation window).
    Demoting Live → Paper is always immediate.
*@

<PageTitle>Strategies — IdiotProof</PageTitle>

<section aria-labelledby="strategies-heading">

    <!-- ── Page header ─────────────────────────────────────────────────────── -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h1 id="strategies-heading" class="h4 mb-0">
            <i class="bi bi-collection me-2" style="color:var(--brand)" aria-hidden="true"></i>Strategies
        </h1>

        <div class="d-flex gap-2 align-items-stretch">
            <input class="form-control"
                   style="max-width:220px"
                   placeholder="Filter by title or ticker…"
                   @bind="filterText"
                   @bind:event="oninput"
                   aria-label="Filter strategies" />
            <button class="btn btn-success text-nowrap" type="button" @onclick="CreateNew">
                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Create New Strategy
            </button>
        </div>
    </div>

    <!-- ── Elevation status banner ─────────────────────────────────────────── -->
    @if (userId is not null && ElevationSvc.RemainingWindow(userId.Value) is { } window)
    {
        <div class="alert alert-warning py-2 small mb-2" role="status">
            <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>
            Live trading elevation active — @($"{(int)window.TotalMinutes}:{window.Seconds:D2}") remaining.
            <button class="btn btn-sm btn-outline-warning ms-2 py-0" @onclick="RevokeElevation">Revoke</button>
        </div>
    }

    <!-- ── Error ───────────────────────────────────────────────────────────── -->
    @if (loadError is not null)
    {
        <div class="alert alert-danger small">@loadError</div>
    }

    <!-- ── Bulk action bar (when selections exist) ─────────────────────────── -->
    @if (selectedIds.Count > 0)
    {
        <div class="d-flex align-items-center gap-2 mb-2 p-2 trading-card flex-wrap"
             style="border-left:3px solid var(--brand)">
            <span class="text-muted small fw-semibold">@selectedIds.Count selected</span>
            <div class="dropdown">
                <button class="btn btn-sm btn-secondary dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    Bulk Actions
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <button class="dropdown-item" @onclick="() => ApplyBulkActiveAsync(true)">
                            <i class="bi bi-play-fill me-2 text-success"></i>Activate Selected
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item" @onclick="() => ApplyBulkActiveAsync(false)">
                            <i class="bi bi-pause-fill me-2 text-muted"></i>Deactivate Selected
                        </button>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <button class="dropdown-item" @onclick='() => ApplyBulkBrokerModeAsync("Paper")'>
                            <i class="bi bi-shield-check me-2" style="color:var(--yellow)"></i>Toggle → Paper
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item text-danger" @onclick='() => ApplyBulkBrokerModeAsync("Live")'>
                            <i class="bi bi-broadcast me-2 text-danger"></i>Toggle → Live (requires auth)
                        </button>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <button class="dropdown-item" @onclick="() => selectedIds.Clear()">
                            <i class="bi bi-x-circle me-2"></i>Clear Selection
                        </button>
                    </li>
                </ul>
            </div>
            @if (!string.IsNullOrEmpty(bulkMessage))
            {
                <span class="small @(bulkMessage.StartsWith("⚠") ? "text-warning" : "text-success")">@bulkMessage</span>
            }
        </div>
    }

    <!-- ── Loading ────────────────────────────────────────────────────────── -->
    @if (loading)
    {
        <div class="text-muted small">
            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading…
        </div>
    }
    else if (filtered.Count == 0)
    {
        <div class="trading-card p-4 text-center">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-2" aria-hidden="true"></i>
            <div class="text-muted">No strategies yet.</div>
            <button class="btn btn-success btn-sm mt-3" type="button" @onclick="CreateNew">
                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Create your first strategy
            </button>
        </div>
    }
    else
    {
        <ul class="list-unstyled mb-0" role="list">
            @foreach (var s in filtered)
            {
                var loaded    = StrategyLoader.Load(s.ScriptJson, s.ScriptText);
                var hasPos    = s.PositionQty > 0;
                var posLabel  = loaded.Definition?.Direction == TradeDirection.Short
                    ? $"SHORT ×{s.PositionQty}"
                    : $"LONG ×{s.PositionQty}";
                decimal? pct  = null;
                if (hasPos && progress.TryGetValue(s.Id, out var cp) && cp.LastPrice.HasValue
                    && s.LastEntryPrice.HasValue && s.LastEntryPrice.Value != 0)
                    pct = (cp.LastPrice.Value - s.LastEntryPrice.Value) / s.LastEntryPrice.Value * 100m;

                <li @key="s.Id" class="trading-card mb-2" data-strategy-id="@s.Id">
                    <div class="d-flex align-items-center gap-2 p-3 strategy-row-header"
                         role="button"
                         tabindex="0"
                         aria-expanded="@expandedRows.Contains(s.Id).ToString().ToLower()"
                         @onclick="() => ToggleExpand(s.Id)"
                         @onkeydown="e => OnRowKeyNavigate(e, s.Id)">

                        <!-- Checkbox (does not expand row) -->
                        <div @onclick:stopPropagation class="d-flex align-items-center" style="flex-shrink:0">
                            <input type="checkbox" class="form-check-input m-0"
                                   checked="@selectedIds.Contains(s.Id)"
                                   @onchange="() => ToggleSelect(s.Id)"
                                   aria-label="Select @s.Title" />
                        </div>

                        <i class="bi bi-chevron-right text-muted"
                           style="transition:transform .18s;transform:@(expandedRows.Contains(s.Id) ? "rotate(90deg)" : "none")"
                           aria-hidden="true"></i>

                        <!-- Info area -->
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fw-semibold">@s.Title</span>
                                <span class="strategy-chip ticker-chip">@s.Symbol</span>

                                <!-- Broker mode badge -->
                                <button type="button"
                                        class="btn btn-sm py-0 @BrokerModeClass(s.BrokerMode)"
                                        style="font-size:.68rem;min-width:50px;line-height:1.3"
                                        title="@BrokerModeTitle(s.BrokerMode)"
                                        @onclick="() => ToggleBrokerModeAsync(s)"
                                        @onclick:stopPropagation>
                                    @if (s.BrokerMode == "Live")
                                    {
                                        <i class="bi bi-broadcast me-1" aria-hidden="true"></i>
                                    }
                                    @s.BrokerMode
                                </button>

                                <!-- Open position badge -->
                                @if (hasPos)
                                {
                                    <span class="strategy-chip long-chip">
                                        <i class="bi bi-currency-dollar" aria-hidden="true"></i>
                                        @posLabel @("@ $")@(s.LastEntryPrice?.ToString("0.00") ?? "—")
                                    </span>
                                    @if (pct.HasValue)
                                    {
                                        <span class="small fw-semibold @(pct > 0 ? "text-success" : "text-danger")">
                                            @(pct > 0 ? "+" : "")@pct.Value.ToString("0.0")%
                                        </span>
                                    }
                                }

                                <!-- Condition progress -->
                                @if (s.IsActive && progress.TryGetValue(s.Id, out var p))
                                {
                                    var fullPass = p.IsFullPass;
                                    <span class="strategy-chip @(fullPass ? "long-chip" : "filter-chip")"
                                          title="Last evaluated @EasternTime.Format(p.EvaluatedUtc, "HH:mm:ss 'ET'")">
                                        <i class="bi @(fullPass ? "bi-check-circle-fill" : "bi-hourglass-split")" aria-hidden="true"></i>
                                        @p.PassedCount/@p.TotalCount
                                        @if (!fullPass && !string.IsNullOrEmpty(p.FirstFailingVerb))
                                        {
                                            <span class="text-muted ms-1">· @p.FirstFailingVerb</span>
                                        }
                                    </span>
                                }
                                else if (s.IsActive && !hasPos)
                                {
                                    <span class="strategy-chip text-muted">
                                        <i class="bi bi-hourglass" aria-hidden="true"></i> awaiting
                                    </span>
                                }

                                @if (loaded.CanonicalError is not null)
                                {
                                    <span class="badge bg-danger" title="@loaded.CanonicalError">QUARANTINE</span>
                                }

                                @if (s.LastFiredUtc is { } lf)
                                {
                                    <span class="text-muted small">fired @EasternTime.Format(lf, "MMM d HH:mm 'ET'")</span>
                                }
                                <span class="text-muted small">created @EasternTime.Format(s.CreatedUtc, "MMM d, yyyy")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(s.Description))
                            {
                                <div class="text-muted small text-truncate" style="max-width:60ch">@s.Description</div>
                            }
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-2 align-items-center flex-shrink-0" @onclick:stopPropagation>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="@($"toggle-{s.Id}")"
                                       checked="@s.IsActive"
                                       aria-label="@(s.IsActive ? "Deactivate" : "Activate") @s.Title"
                                       @onchange="(e) => ToggleActive(s, (bool)(e.Value ?? false))" />
                                <label class="form-check-label small text-muted" for="@($"toggle-{s.Id}")">
                                    @(s.IsActive ? "Active" : "Paused")
                                </label>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary" type="button"
                                    aria-label="Edit @s.Title"
                                    @onclick="() => EditStrategy(s.Id)">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                            </button>
                            @if (s.IsActive)
                            {
                                <button class="btn btn-sm btn-outline-success" type="button"
                                        aria-label="Live chart for @s.Title"
                                        @onclick="@(() => Nav.NavigateTo($"/live/{s.Id}"))">
                                    <i class="bi bi-broadcast me-1" aria-hidden="true"></i>Live
                                </button>
                            }
                            <button class="btn btn-sm btn-outline-danger" type="button"
                                    aria-label="Delete @s.Title"
                                    @onclick="() => ConfirmDelete(s)">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    @if (expandedRows.Contains(s.Id))
                    {
                        <div style="border-top:1px solid rgba(255,255,255,.07)">
                            <StrategyBlueprintViz S="s" />
                        </div>
                    }
                </li>
            }
        </ul>
    }

    <!-- ── Delete modal ────────────────────────────────────────────────────── -->
    @if (deleteCandidate is not null)
    {
        <div class="modal-backdrop fade show" @onclick="() => deleteCandidate = null"></div>
        <div class="modal fade show d-block" role="dialog" aria-modal="true" aria-labelledby="del-title" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 id="del-title" class="h5 modal-title">Delete strategy?</h2>
                    </div>
                    <div class="modal-body">
                        <p>Permanently delete <strong>@deleteCandidate.Title</strong>? This cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary btn-sm" type="button" @onclick="() => deleteCandidate = null">Cancel</button>
                        <button class="btn btn-danger btn-sm" type="button" @onclick="DeleteConfirmed">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ── Password / elevation modal ─────────────────────────────────────── -->
    @if (showPasswordModal)
    {
        <div class="modal-backdrop fade show" @onclick="CancelPasswordModal"></div>
        <div class="modal fade show d-block" role="dialog" aria-modal="true"
             aria-labelledby="pw-modal-title" tabindex="-1"
             @onkeydown="OnPasswordModalKeyDown">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark border-danger">
                    <div class="modal-header border-danger">
                        <h2 id="pw-modal-title" class="h5 modal-title text-danger">
                            <i class="bi bi-shield-lock me-2" aria-hidden="true"></i>Enable Live Trading
                        </h2>
                    </div>
                    <div class="modal-body text-white">
                        <p class="text-warning small mb-2">
                            You are enabling <strong>live trading with real money</strong>.
                            Re-enter your password to open a 5-minute elevation window.
                        </p>
                        <input type="password" class="form-control bg-dark text-white border-secondary"
                               placeholder="Your password"
                               @bind="passwordInput"
                               @bind:event="oninput"
                               autocomplete="current-password" />
                        @if (!string.IsNullOrEmpty(passwordModalError))
                        {
                            <div class="alert alert-danger small py-1 mt-2">@passwordModalError</div>
                        }
                        @if (isVerifyingPassword)
                        {
                            <div class="text-muted small mt-2">
                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Verifying…
                            </div>
                        }
                    </div>
                    <div class="modal-footer border-danger">
                        <button class="btn btn-secondary" type="button" @onclick="CancelPasswordModal">Cancel</button>
                        <button class="btn btn-danger" type="button"
                                @onclick="ConfirmPasswordModalAsync"
                                disabled="@(isVerifyingPassword || string.IsNullOrEmpty(passwordInput))"
                                autofocus>
                            Confirm — Enable Live Trading
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

</section>

@code {
    private readonly HashSet<Guid> expandedRows = [];

    private void ToggleExpand(Guid id) { if (!expandedRows.Add(id)) expandedRows.Remove(id); }

    private void OnRowKeyNavigate(KeyboardEventArgs e, Guid id)
    {
        if (e.Key is "Enter" or " ") ToggleExpand(id);
    }
}
