@page "/"
@page "/strategies"
@rendermode InteractiveServer
@using IdiotProof.Blazor.Data
@using IdiotProof.Blazor.Services
@using IdiotProof.Scripting
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject StrategyRepository StrategyRepo
@inject ConditionProgressRepository ProgressRepo
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@implements IDisposable

@*
    Strategies — the front door of IdiotProof. List of every saved strategy for the
    signed-in user. Each row collapses to title/ticker/active toggle/edit; expanding
    a row reveals the full visual via StrategyBuilderRenderer. The Active toggle
    flips IsActive in SQL — when true, the IdiotProof.Monitor console picks the
    strategy up on its next tick (default 5s), evaluates it, and trades it.

    UI state (open expand-rows, last filter) is mirrored to localStorage under the
    "idiotproof.strategies.*" namespace so the user's place is preserved across
    page reloads and browser tabs.

    "Create New Strategy" → /builder (no preload)
    "Edit"               → /builder?strategyId={guid} (preloads existing script)
*@

<PageTitle>Strategies — IdiotProof</PageTitle>

<section aria-labelledby="strategies-heading">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 id="strategies-heading" class="h4 mb-0">
            <i class="bi bi-collection me-2" style="color:var(--brand)" aria-hidden="true"></i>Strategies
        </h1>
        <div class="d-flex gap-2 align-items-stretch">
            <input class="form-control"
                   style="max-width:240px"
                   placeholder="Filter by title or ticker..."
                   @bind="filterText"
                   @bind:event="oninput"
                   aria-label="Filter strategies" />
            <button class="btn btn-success text-nowrap" type="button" @onclick="CreateNew">
                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Create New Strategy
            </button>
        </div>
    </div>

    @if (loadError is not null)
    {
        <div class="alert alert-danger small">@loadError</div>
    }

    @if (loading)
    {
        <div class="text-muted small">
            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading...
        </div>
    }
    else if (filtered.Count == 0)
    {
        <div class="trading-card p-4 text-center">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-2" aria-hidden="true"></i>
            <div class="text-muted">No strategies yet.</div>
            <button class="btn btn-success btn-sm mt-3" type="button" @onclick="CreateNew">
                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Create your first strategy
            </button>
        </div>
    }
    else
    {
        <ul class="list-unstyled mb-0" role="list">
            @foreach (var s in filtered)
            {
                var isOpen  = openRows.Contains(s.Id);
                var preview = previews.GetValueOrDefault(s.Id);
                <li class="trading-card mb-2" data-strategy-id="@s.Id">
                    <div class="d-flex align-items-center gap-3 p-3">
                        <button class="btn btn-sm btn-link p-0"
                                type="button"
                                aria-expanded="@isOpen"
                                aria-label="@(isOpen ? "Collapse" : "Expand") @s.Title"
                                @onclick="() => ToggleRow(s.Id)">
                            <i class="bi @(isOpen ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></i>
                        </button>
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fw-semibold">@s.Title</span>
                                <span class="strategy-chip ticker-chip">@s.Symbol</span>
                                @if (s.IsActive && progress.TryGetValue(s.Id, out var p))
                                {
                                    var fullPass = p.IsFullPass;
                                    <span class="strategy-chip @(fullPass ? "long-chip" : "filter-chip")"
                                          title="Last evaluated @EasternTime.Format(p.EvaluatedUtc, "HH:mm:ss 'ET'")">
                                        <i class="bi @(fullPass ? "bi-check-circle-fill" : "bi-hourglass-split")" aria-hidden="true"></i>
                                        @p.PassedCount/@p.TotalCount
                                        @if (!fullPass && !string.IsNullOrEmpty(p.FirstFailingVerb))
                                        {
                                            <span class="text-muted ms-1">· @p.FirstFailingVerb</span>
                                        }
                                    </span>
                                }
                                else if (s.IsActive)
                                {
                                    <span class="strategy-chip text-muted">
                                        <i class="bi bi-hourglass" aria-hidden="true"></i> awaiting first evaluation
                                    </span>
                                }
                                @if (s.LastFiredUtc is { } lf)
                                {
                                    <span class="text-muted small">last fired @EasternTime.Format(lf, "MMM d HH:mm 'ET'")</span>
                                }
                                <span class="text-muted small">created @EasternTime.Format(s.CreatedUtc, "MMM d, yyyy")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(s.Description))
                            {
                                <div class="text-muted small text-truncate" style="max-width:60ch">@s.Description</div>
                            }
                        </div>
                        <div class="d-flex gap-2 align-items-center flex-shrink-0">
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="@($"toggle-{s.Id}")"
                                       checked="@s.IsActive"
                                       aria-label="@(s.IsActive ? "Deactivate" : "Activate") @s.Title"
                                       @onchange="(e) => ToggleActive(s, (bool)(e.Value ?? false))" />
                                <label class="form-check-label small text-muted" for="@($"toggle-{s.Id}")">
                                    @(s.IsActive ? "Active" : "Paused")
                                </label>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary" type="button"
                                    aria-label="Edit @s.Title"
                                    @onclick="() => EditStrategy(s.Id)">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                            </button>
                            @if (s.IsActive)
                            {
                                var liveUrl = $"/live/{s.Id}";
                                <button class="btn btn-sm btn-outline-success" type="button"
                                        aria-label="Live chart for @s.Title"
                                        @onclick="@(() => Nav.NavigateTo(liveUrl))">
                                    <i class="bi bi-broadcast me-1" aria-hidden="true"></i>Live
                                </button>
                            }
                            <button class="btn btn-sm btn-outline-danger" type="button"
                                    aria-label="Delete @s.Title"
                                    @onclick="() => ConfirmDelete(s)">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                    @if (isOpen)
                    {
                        <div class="border-top px-3 py-3" style="background:var(--bg-row-alt)">
                            <StrategyBuilderRenderer Strategy="preview"
                                                     EmptyMessage="Could not parse this script for preview." />
                            <details class="mt-2">
                                <summary class="text-muted small" style="cursor:pointer">Show raw IdiotScript</summary>
                                <pre class="small mt-2 p-2" style="background:var(--bg-card);border:1px solid var(--border);border-radius:6px;max-height:240px;overflow:auto">@s.ScriptText</pre>
                            </details>
                        </div>
                    }
                </li>
            }
        </ul>
    }

    @if (deleteCandidate is not null)
    {
        <div class="modal-backdrop fade show" @onclick="() => deleteCandidate = null"></div>
        <div class="modal fade show d-block" role="dialog" aria-modal="true" aria-labelledby="del-title" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 id="del-title" class="h5 modal-title">Delete strategy?</h2>
                    </div>
                    <div class="modal-body">
                        <p>Permanently delete <strong>@deleteCandidate.Title</strong>? This cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary btn-sm" type="button" @onclick="() => deleteCandidate = null">Cancel</button>
                        <button class="btn btn-danger btn-sm" type="button" @onclick="DeleteConfirmed">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private bool loading = true;
    private string? loadError;
    private Guid? userId;
    private string filterText = "";

    private List<Strategy> all = new();
    private readonly Dictionary<Guid, StrategyDefinition?> previews = new();
    private readonly Dictionary<Guid, ConditionProgress> progress = new();
    private readonly HashSet<Guid> openRows = new();
    private Strategy? deleteCandidate;
    private System.Threading.Timer? progressPoll;

    private List<Strategy> filtered => string.IsNullOrWhiteSpace(filterText)
        ? all
        : all.Where(s =>
            s.Title.Contains(filterText, StringComparison.OrdinalIgnoreCase)
         || s.Symbol.Contains(filterText, StringComparison.OrdinalIgnoreCase)
         || (s.Description?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var rawId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            userId = Guid.TryParse(rawId, out var uid) ? uid : null;
            if (userId is null) { loadError = "Sign in to view your strategies."; return; }

            all = await StrategyRepo.GetAllForUserAsync(userId.Value);
            foreach (var s in all)
            {
                previews[s.Id] = TryLoad(s);
            }
            await RefreshProgressAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally { loading = false; }

        // Poll progress every 5 seconds while the page is open. Cheap query
        // (one bulk read keyed on the visible strategy ids); writes happen on
        // the Monitor's tick (default 30s) so this rate is comfortably below
        // the producer.
        progressPoll = new System.Threading.Timer(async _ =>
        {
            try { await InvokeAsync(async () => { await RefreshProgressAsync(); StateHasChanged(); }); }
            catch { /* circuit may be tearing down */ }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    /// <summary>
    /// Pulls live ConditionProgress AND refreshes each row's volatile state in
    /// place (IsActive, fire/position/exit bookkeeping). Without the in-place
    /// refresh, chips like "last fired" and the toggle state froze at page
    /// load: the Monitor could fire and exit a strategy while the user
    /// watched a page still claiming it never fired. In-place (matched by id,
    /// no re-sort) so open rows and scroll position never jump.
    /// </summary>
    private async Task RefreshProgressAsync()
    {
        if (userId is not null)
        {
            var fresh = await StrategyRepo.GetAllForUserAsync(userId.Value);
            var byId = fresh.ToDictionary(s => s.Id);
            foreach (var s in all)
            {
                if (!byId.TryGetValue(s.Id, out var f)) continue;
                s.IsActive       = f.IsActive;
                s.LastFiredUtc   = f.LastFiredUtc;
                s.FireCount      = f.FireCount;
                s.PositionQty    = f.PositionQty;
                s.LastEntryPrice = f.LastEntryPrice;
                s.EntryFilledUtc = f.EntryFilledUtc;
                s.LastExitPrice  = f.LastExitPrice;
                s.LastExitReason = f.LastExitReason;
                s.LastExitedUtc  = f.LastExitedUtc;
            }
        }

        var ids = all.Where(s => s.IsActive).Select(s => s.Id).ToList();
        if (ids.Count == 0) { progress.Clear(); return; }

        var rows = await ProgressRepo.GetForStrategyIdsAsync(ids);
        progress.Clear();
        foreach (var (k, v) in rows) progress[k] = v;
    }

    public void Dispose()
    {
        progressPoll?.Dispose();
        progressPoll = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "idiotproof.strategies.openRows");
                if (!string.IsNullOrWhiteSpace(saved))
                {
                    foreach (var part in saved.Split(','))
                    {
                        if (Guid.TryParse(part, out var id)) openRows.Add(id);
                    }
                    StateHasChanged();
                }
            }
            catch { /* JS unavailable */ }
        }
    }

    private async Task ToggleRow(Guid id)
    {
        if (!openRows.Add(id)) openRows.Remove(id);
        try { await JS.InvokeVoidAsync("localStorage.setItem", "idiotproof.strategies.openRows", string.Join(",", openRows)); }
        catch { }
    }

    private async Task ToggleActive(Strategy s, bool isActive)
    {
        if (userId is null) return;

        // Gapper rows also live on this page — activating one here must obey
        // the same one-active-gapper-per-symbol rule the Gapper page enforces,
        // or this toggle is a bypass route to doubled exposure on one gap.
        var isGapper = s.ScriptText.Contains("PeakGiveback(", StringComparison.OrdinalIgnoreCase);
        if (isActive && !s.IsActive && isGapper
            && await StrategyRepo.CountActiveForSymbolAsync(userId.Value, s.Symbol) > 0)
        {
            loadError = $"{s.Symbol} already has an active gapper — pause it first (one active gapper per symbol).";
            return;
        }

        var result = await StrategyRepo.SetActiveAsync(s.Id, isActive, userId.Value);
        if (result == StrategyMutation.Ok)
        {
            s.IsActive = isActive;
            loadError = "";

            // Post-write recheck, same as the Gapper page: two tabs activating
            // rows for one symbol both pass the pre-check; the loser reverts.
            if (isActive && isGapper
                && await StrategyRepo.CountActiveForSymbolAsync(userId.Value, s.Symbol) > 1)
            {
                await StrategyRepo.SetActiveAsync(s.Id, false, userId.Value);
                s.IsActive = false;
                loadError = $"{s.Symbol} lost the race to another activation — left paused.";
            }
        }
        else if (result == StrategyMutation.PositionOpen)
        {
            // Pausing a holding strategy would orphan the position — the
            // Monitor only manages exits on active rows.
            loadError = $"{s.Symbol} is holding {s.PositionQty} shares — the Monitor must stay active to manage the exit. It re-arms tomorrow; flatten first if you need it off.";
        }
    }

    // Navigation only — the old AddOpenTabAsync bookkeeping wrote to a CSV
    // column nothing ever read (the BuilderTabBar it fed was never built);
    // removed per IP-A10. The /builder page derives its state entirely from
    // the route parameter.
    private void EditStrategy(Guid id) => Nav.NavigateTo($"/builder/{id}");

    private void CreateNew() => Nav.NavigateTo("/builder");

    private void ConfirmDelete(Strategy s) => deleteCandidate = s;

    private async Task DeleteConfirmed()
    {
        if (deleteCandidate is null || userId is null) return;
        var result = await StrategyRepo.DeleteAsync(deleteCandidate.Id, userId.Value);
        if (result == StrategyMutation.PositionOpen)
        {
            loadError = $"{deleteCandidate.Symbol} is holding {deleteCandidate.PositionQty} shares — deleting would discard the exit rules for a live position. Flatten first.";
            deleteCandidate = null;
            return;
        }
        all.RemoveAll(x => x.Id == deleteCandidate.Id);
        previews.Remove(deleteCandidate.Id);
        openRows.Remove(deleteCandidate.Id);
        deleteCandidate = null;
        loadError = "";
    }

    private static StrategyDefinition? TryLoad(Strategy s)
    {
        try
        {
            // Canonical JSON first (IP-LAW-8) — previews render exactly what
            // the Monitor will evaluate; text parse only for legacy rows.
            return StrategyLoader.Load(s.ScriptJson, s.ScriptText).Definition;
        }
        catch { return null; }
    }
}
