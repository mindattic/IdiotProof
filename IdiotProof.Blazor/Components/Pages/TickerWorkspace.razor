@page "/workspaces"
@page "/workspace/{TabId}"
@rendermode InteractiveServer
@inject WorkspaceManager WorkspaceManager
@inject TradingStateService TradingState
@inject UserKeyService UserKeyService
@inject StrategyRegistry StrategyRegistry
@inject AppSettings AppSettings
@inject AuditLogger AuditLogger
@inject AuditLogRepository AuditLogRepository
@inject RiskGuardianService RiskGuardianService
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Workspaces — IdiotProof</PageTitle>

@if (string.IsNullOrEmpty(TabId))
{
    <!-- Workspace List View -->
    <section aria-labelledby="workspaces-heading">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 id="workspaces-heading" class="h4 mb-0 text-white">
            <i class="bi bi-layers me-2" style="color:var(--blue)" aria-hidden="true"></i>Workspaces
        </h1>
        <button class="btn btn-success btn-sm" type="button" @onclick="ShowNewWorkspaceModal" aria-label="Create new workspace">
            <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>New Workspace
        </button>
    </div>

    <ul class="row g-3 list-unstyled" role="list">
        @foreach (var tab in userTabs)
        {
            <li class="col-md-6 col-lg-4">
                <article class="trading-card p-3 h-100" aria-labelledby="ws-name-@tab.TabId">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h2 id="ws-name-@tab.TabId" class="h6 text-white mb-0">@tab.Name</h2>
                        <div class="d-flex gap-1">
                            <a href="/workspace/@tab.TabId" class="btn btn-sm btn-outline-success" aria-label="Open workspace @tab.Name">Open</a>
                            <button class="btn btn-sm btn-outline-danger"
                                    type="button"
                                    aria-label="Delete workspace @tab.Name"
                                    @onclick="() => DeleteWorkspace(tab.TabId)">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                    <div class="text-muted small mb-2">
                        Created @tab.CreatedUtc.ToString("MMM d, yyyy")
                    </div>
                    <div class="d-flex flex-wrap gap-1 mb-2" aria-label="Watchlist preview">
                        @foreach (var sym in tab.Watchlist.Take(5))
                        {
                            <span class="badge bg-dark border border-secondary">@sym</span>
                        }
                        @if (tab.Watchlist.Count > 5)
                        {
                            <span class="badge bg-secondary" aria-label="@(tab.Watchlist.Count - 5) more tickers">+@(tab.Watchlist.Count - 5)</span>
                        }
                        @if (!tab.Watchlist.Any())
                        {
                            <span class="text-muted" style="font-size:0.75rem">No tickers</span>
                        }
                    </div>
                    <div class="small text-muted">
                        @tab.Strategies.Count(s => s.Enabled) active strategies &bull;
                        @if (tab.Settings.AutoTrade)
                        {
                            <span class="text-green">Auto-Trade ON</span>
                        }
                        else
                        {
                            <span>Manual</span>
                        }
                    </div>
                </article>
            </li>
        }
        @if (!userTabs.Any())
        {
            <li class="col-12 text-center py-5 text-muted">
                <i class="bi bi-layers fs-1 d-block mb-3" aria-hidden="true"></i>
                No workspaces yet. Create one to get started.
            </li>
        }
    </ul>
    </section>

    <!-- New Workspace Modal -->
    @if (showNewModal)
    {
        <div class="modal-backdrop fade show" @onclick="() => showNewModal = false"></div>
        <div class="modal fade show d-block"
             role="dialog"
             aria-modal="true"
             aria-labelledby="new-ws-title"
             tabindex="-1"
             @onkeydown="OnNewWorkspaceModalKey">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark border-secondary">
                    <div class="modal-header border-secondary">
                        <h2 id="new-ws-title" class="h5 modal-title text-white">New Workspace</h2>
                        <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="() => showNewModal = false"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label text-muted small" for="new-ws-name">Workspace Name</label>
                        <input id="new-ws-name"
                               class="form-control bg-dark text-white border-secondary"
                               placeholder="e.g. Momentum Plays"
                               aria-required="true"
                               autofocus
                               @bind="newWorkspaceName"
                               @onkeydown="OnNewWorkspaceKeyDown" />
                    </div>
                    <div class="modal-footer border-secondary">
                        <button class="btn btn-secondary" type="button" @onclick="() => showNewModal = false">Cancel</button>
                        <button class="btn btn-success" type="button" @onclick="CreateWorkspace">Create</button>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <!-- Single Workspace View -->
    @if (currentTab == null)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-exclamation-circle fs-1 d-block mb-3"></i>
            Workspace not found. <a href="/workspaces">Back to workspaces</a>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-2">
                <a href="/workspaces" class="btn btn-sm btn-outline-secondary" aria-label="Back to workspaces">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                </a>
                @if (editingName)
                {
                    <label class="visually-hidden" for="ws-name-edit">Workspace name</label>
                    <input id="ws-name-edit"
                           class="form-control form-control-sm bg-dark text-white border-secondary"
                           style="width:200px"
                           aria-label="Workspace name"
                           @bind="editNameValue"
                           @onblur="SaveName"
                           @onkeydown="OnNameKeyDown" />
                }
                else
                {
                    <h1 class="h4 mb-0 text-white" @ondblclick="StartEditName" style="cursor:pointer" title="Double-click to rename">
                        @currentTab.Name
                        <button type="button"
                                class="btn btn-link p-0 ms-1 align-baseline"
                                aria-label="Rename workspace"
                                @onclick="StartEditName"
                                @onclick:stopPropagation="true">
                            <i class="bi bi-pencil text-muted" style="font-size:0.7rem" aria-hidden="true"></i>
                        </button>
                    </h1>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                <!-- Auto-Trade Toggle -->
                <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                    <label class="form-check-label text-muted small" for="autoTradeSwitch">Auto-Trade</label>
                    <input class="form-check-input" type="checkbox" id="autoTradeSwitch"
                           checked="@currentTab.Settings.AutoTrade"
                           aria-describedby="auto-trade-status"
                           @onchange="OnAutoTradeToggle" />
                    @if (currentTab.Settings.AutoTrade)
                    {
                        <span id="auto-trade-status" class="badge bg-danger" role="status">LIVE</span>
                    }
                </div>
            </div>
        </div>

        <!-- Watchlist + Broker Selectors -->
        <section class="trading-card p-3 mb-3" aria-labelledby="watchlist-heading">
            <h2 id="watchlist-heading" class="visually-hidden">Watchlist and broker settings</h2>
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label text-muted small" for="new-ticker-input">Watchlist</label>
                    <ul class="d-flex flex-wrap gap-2 mb-2 list-unstyled" aria-label="Watched tickers">
                        @foreach (var sym in currentTab.Watchlist)
                        {
                            <li>
                                <span class="badge bg-dark border border-secondary d-flex align-items-center gap-1">
                                    @sym
                                    <button class="btn btn-sm p-0 text-danger"
                                            type="button"
                                            style="line-height:1"
                                            aria-label="Remove @sym from watchlist"
                                            @onclick="() => RemoveTicker(sym)">
                                        <i class="bi bi-x" style="font-size:0.8rem" aria-hidden="true"></i>
                                    </button>
                                </span>
                            </li>
                        }
                    </ul>
                    <div class="input-group input-group-sm">
                        <input id="new-ticker-input"
                               class="form-control bg-dark text-white border-secondary"
                               placeholder="Add ticker..."
                               aria-label="Ticker symbol"
                               @bind="newTickerInput"
                               @onkeydown="OnAddTickerKeyDown" />
                        <button class="btn btn-outline-success" type="button" @onclick="AddTicker" aria-label="Add ticker to watchlist">+</button>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small" for="broker-select">Broker</label>
                    <select id="broker-select"
                            class="form-select form-select-sm bg-dark text-white border-secondary"
                            @bind="currentTab.BrokerOverride"
                            @bind:after="SaveTab">
                        <option value="">Default (@AppSettings.DefaultBroker)</option>
                        <option value="Sandbox">Sandbox</option>
                        <option value="Alpaca">Alpaca</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small" for="datafeed-select">Data Feed</label>
                    <select id="datafeed-select"
                            class="form-select form-select-sm bg-dark text-white border-secondary"
                            @bind="currentTab.DataFeedOverride"
                            @bind:after="SaveTab">
                        <option value="">Default (@AppSettings.DefaultDataFeed)</option>
                        <option value="Polygon">Polygon</option>
                    </select>
                </div>
            </div>
        </section>

        <!-- Risk Parameters (collapsible) -->
        <section class="trading-card p-3 mb-3" aria-labelledby="risk-toggle">
            <button id="risk-toggle"
                    class="btn btn-sm btn-link text-muted p-0 d-flex align-items-center gap-1"
                    type="button"
                    aria-expanded="@riskExpanded"
                    aria-controls="risk-panel"
                    @onclick="() => riskExpanded = !riskExpanded">
                <i class="bi @(riskExpanded ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></i>
                <span class="small">Risk Parameters</span>
            </button>
            <div id="risk-panel" hidden="@(!riskExpanded)">
            @if (riskExpanded)
            {
                <div class="row g-2 mt-2">
                    <div class="col-md-3">
                        <label class="form-label text-muted" style="font-size:0.7rem" for="risk-max-position">Max Position Size ($)</label>
                        <input id="risk-max-position"
                               type="number" class="form-control form-control-sm bg-dark text-white border-secondary"
                               @bind="currentTab.Settings.MaxPositionSize"
                               @bind:after="SaveTab" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted" style="font-size:0.7rem" for="risk-max-loss-trade">Max Loss / Trade ($)</label>
                        <input id="risk-max-loss-trade"
                               type="number" class="form-control form-control-sm bg-dark text-white border-secondary"
                               @bind="currentTab.Settings.RiskLimits.MaxLossPerTrade"
                               @bind:after="SaveTab" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted" style="font-size:0.7rem" for="risk-max-loss-day">Max Loss / Day ($)</label>
                        <input id="risk-max-loss-day"
                               type="number" class="form-control form-control-sm bg-dark text-white border-secondary"
                               @bind="currentTab.Settings.RiskLimits.MaxLossPerDay"
                               @bind:after="SaveTab" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted" style="font-size:0.7rem" for="risk-allowed-sessions">Allowed Sessions</label>
                        <select id="risk-allowed-sessions"
                                class="form-select form-select-sm bg-dark text-white border-secondary"
                                @bind="currentTab.Settings.AllowedSessions"
                                @bind:after="SaveTab">
                            @foreach (var session in Enum.GetValues<TradingSession>())
                            {
                                <option value="@session">@session</option>
                            }
                        </select>
                    </div>
                </div>
            }
            </div>
        </section>

        <div role="status" aria-live="polite" aria-atomic="true">
        @if (!string.IsNullOrEmpty(orderFeedback))
        {
            <div class="alert alert-info small py-2 mb-3">@orderFeedback</div>
        }
        </div>

        <!-- Per-Ticker Tabs -->
        @if (!currentTab.Watchlist.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-search fs-1 d-block mb-3" aria-hidden="true"></i>
                Add tickers to the watchlist to see strategy signals.
            </div>
        }
        else
        {
            <ul class="nav nav-tabs mb-3"
                role="tablist"
                aria-label="Tickers in watchlist"
                style="border-color:var(--border)">
                @foreach (var sym in currentTab.Watchlist)
                {
                    var isSelected = selectedTicker == sym;
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(isSelected ? "active" : "")"
                                type="button"
                                role="tab"
                                aria-selected="@isSelected"
                                aria-controls="ticker-panel-@sym"
                                id="ticker-tab-@sym"
                                tabindex="@(isSelected ? "0" : "-1")"
                                style="@(isSelected ? "background:var(--bg-card);border-color:var(--border);color:var(--text-primary)" : "color:var(--text-muted)")"
                                @onclick="() => selectedTicker = sym">
                            @sym
                            @if (TradingState.LivePrices.TryGetValue(sym, out var lp))
                            {
                                <span class="ms-1 text-muted small" aria-label="Price $@lp.Price.ToString("0.00")">$@lp.Price.ToString("0.00")</span>
                            }
                        </button>
                    </li>
                }
            </ul>

            @if (!string.IsNullOrEmpty(selectedTicker))
            {
                <div class="row g-3"
                     role="tabpanel"
                     id="ticker-panel-@selectedTicker"
                     aria-labelledby="ticker-tab-@selectedTicker">
                    <div class="col-md-4">
                        <div class="trading-card p-3 mb-3">
                            @if (TradingState.LivePrices.TryGetValue(selectedTicker, out var price))
                            {
                                <PriceDisplay Symbol="@selectedTicker"
                                              Price="@price.Price"
                                              PriceChange="0"
                                              PriceChangePct="0" />
                            }
                            else
                            {
                                <div class="text-muted small" role="status">Price loading...</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-8">
                        <!-- Strategies for selected ticker -->
                        <section class="trading-card p-3 mb-3" aria-labelledby="strategies-heading">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 id="strategies-heading" class="h6 mb-0 text-white">Strategies</h2>
                                <div class="d-flex gap-2 align-items-center">
                                    <label class="visually-hidden" for="add-strategy-select">Strategy to add</label>
                                    <select id="add-strategy-select"
                                            class="form-select form-select-sm bg-dark text-white border-secondary"
                                            style="width:auto"
                                            @bind="strategyToAdd">
                                        <option value="">Add strategy...</option>
                                        @foreach (var s in StrategyRegistry.GetAll())
                                        {
                                            <option value="@s.Name">@s.Name</option>
                                        }
                                    </select>
                                    <button class="btn btn-sm btn-outline-success" type="button" @onclick="AddStrategy" aria-label="Add selected strategy">+</button>
                                </div>
                            </div>
                            @foreach (var binding in currentTab.Strategies)
                            {
                                <div class="border border-secondary rounded p-3 mb-2">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <input type="checkbox" class="form-check-input"
                                                   id="strat-toggle-@binding.StrategyName"
                                                   checked="@binding.Enabled"
                                                   @onchange="(e) => ToggleStrategy(binding, (bool)(e.Value ?? false))" />
                                            <label class="text-white small fw-semibold mb-0" for="strat-toggle-@binding.StrategyName">@binding.StrategyName</label>
                                        </div>
                                        <button class="btn btn-sm btn-outline-danger py-0"
                                                type="button"
                                                aria-label="Remove strategy @binding.StrategyName"
                                                @onclick="() => RemoveStrategy(binding)">
                                            <i class="bi bi-trash" style="font-size:0.7rem" aria-hidden="true"></i>
                                        </button>
                                    </div>

                                    @{
                                        var signals = TradingState.GetSignalsFor(selectedTicker, userId)
                                            .Where(s => s.StrategyName == binding.StrategyName)
                                            .Take(1).ToList();
                                    }
                                    @if (signals.Any())
                                    {
                                        var sig = signals[0];
                                        TradingState.SignalVotes.TryGetValue(
                                            $"{sig.Symbol}_{sig.StrategyName}_{sig.GeneratedUtc:yyyyMMddHHmmss}",
                                            out var vote);
                                        <SignalCard Signal="@sig"
                                                    VotingResult="@vote"
                                                    OnExecute="@(EventCallback.Factory.Create<TradeSignal>(this, FireSignal))" />
                                    }
                                    else
                                    {
                                        <div class="text-muted" style="font-size:0.75rem" role="status">Waiting for next evaluation...</div>
                                    }
                                </div>
                            }
                        </section>
                    </div>
                </div>
            }
        }
    }

    <!-- Auto-Trade Confirm Modal -->
    @if (showAutoTradeModal)
    {
        <div class="modal-backdrop fade show" @onclick="CancelAutoTrade"></div>
        <div class="modal fade show d-block"
             role="dialog"
             aria-modal="true"
             aria-labelledby="auto-trade-title"
             aria-describedby="auto-trade-desc"
             tabindex="-1"
             @onkeydown="OnAutoTradeModalKey">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark border-danger">
                    <div class="modal-header border-danger">
                        <h2 id="auto-trade-title" class="h5 modal-title text-danger">
                            <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>Enable Auto-Trade?
                        </h2>
                    </div>
                    <div class="modal-body text-white" id="auto-trade-desc">
                        <p>Auto-trading will place <strong>real orders</strong> automatically when strategy signals are generated and approved by LLM voting.</p>
                        <p class="text-warning small">This uses real money. Ensure your broker is configured correctly and risk limits are set.</p>
                        <div class="alert alert-danger small">
                            <strong>Broker:</strong> @(currentTab?.BrokerOverride ?? AppSettings.DefaultBroker) &bull;
                            <strong>Max Loss/Trade:</strong> $@currentTab?.Settings.RiskLimits.MaxLossPerTrade.ToString("0")
                        </div>
                    </div>
                    <div class="modal-footer border-danger">
                        <button class="btn btn-secondary" type="button" @onclick="CancelAutoTrade" autofocus>Cancel</button>
                        <button class="btn btn-danger" type="button" @onclick="ConfirmAutoTrade">Yes, Enable Auto-Trade</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public string? TabId { get; set; }

    private string userId = "";
    private IReadOnlyList<WorkspaceTab> userTabs = [];
    private WorkspaceTab? currentTab;
    private bool showNewModal;
    private bool showAutoTradeModal;
    private string newWorkspaceName = "";
    private string newTickerInput = "";
    private string selectedTicker = "";
    private string strategyToAdd = "";
    private bool editingName;
    private string editNameValue = "";
    private bool riskExpanded;
    private string? orderFeedback;
    private System.Threading.Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        userTabs = WorkspaceManager.GetTabsForUser(userId);

        refreshTimer = new System.Threading.Timer(_ =>
        {
            userTabs = WorkspaceManager.GetTabsForUser(userId);
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(TabId))
        {
            currentTab = WorkspaceManager.Get(userId, TabId);
            if (currentTab?.Watchlist.Any() == true && string.IsNullOrEmpty(selectedTicker))
                selectedTicker = currentTab.Watchlist[0];
        }
    }

    private void ShowNewWorkspaceModal() => showNewModal = true;

    private void OnNewWorkspaceKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") CreateWorkspace();
    }

    private void OnNewWorkspaceModalKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") showNewModal = false;
    }

    private void OnAutoTradeModalKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CancelAutoTrade();
    }

    private void CreateWorkspace()
    {
        if (string.IsNullOrWhiteSpace(newWorkspaceName)) return;
        WorkspaceManager.Create(userId, newWorkspaceName.Trim());
        userTabs = WorkspaceManager.GetTabsForUser(userId);
        newWorkspaceName = "";
        showNewModal = false;
    }

    private void DeleteWorkspace(string tabId)
    {
        WorkspaceManager.Delete(userId, tabId);
        userTabs = WorkspaceManager.GetTabsForUser(userId);
    }

    private void StartEditName()
    {
        editNameValue = currentTab?.Name ?? "";
        editingName = true;
    }

    private void SaveName()
    {
        if (currentTab != null && !string.IsNullOrWhiteSpace(editNameValue))
        {
            currentTab.Name = editNameValue.Trim();
            WorkspaceManager.Save(userId, currentTab);
        }
        editingName = false;
    }

    private void OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SaveName();
        if (e.Key == "Escape") editingName = false;
    }

    private void AddTicker()
    {
        var sym = newTickerInput.Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(sym) || currentTab == null) return;
        if (!currentTab.Watchlist.Contains(sym))
        {
            currentTab.Watchlist.Add(sym);
            selectedTicker = sym;
            WorkspaceManager.Save(userId, currentTab);
        }
        newTickerInput = "";
    }

    private async Task OnAddTickerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { AddTicker(); await Task.CompletedTask; }
    }

    private void RemoveTicker(string sym)
    {
        if (currentTab == null) return;
        currentTab.Watchlist.Remove(sym);
        if (selectedTicker == sym)
            selectedTicker = currentTab.Watchlist.FirstOrDefault() ?? "";
        WorkspaceManager.Save(userId, currentTab);
    }

    private void AddStrategy()
    {
        if (string.IsNullOrEmpty(strategyToAdd) || currentTab == null) return;
        if (!currentTab.Strategies.Any(s => s.StrategyName == strategyToAdd))
        {
            currentTab.Strategies.Add(new StrategyBinding { StrategyName = strategyToAdd, Enabled = true });
            WorkspaceManager.Save(userId, currentTab);
        }
        strategyToAdd = "";
    }

    private void RemoveStrategy(StrategyBinding binding)
    {
        if (currentTab == null) return;
        currentTab.Strategies.Remove(binding);
        WorkspaceManager.Save(userId, currentTab);
    }

    private void ToggleStrategy(StrategyBinding binding, bool enabled)
    {
        binding.Enabled = enabled;
        if (currentTab != null) WorkspaceManager.Save(userId, currentTab);
    }

    private void OnAutoTradeToggle(ChangeEventArgs e)
    {
        var newVal = (bool)(e.Value ?? false);
        if (newVal && currentTab != null)
            showAutoTradeModal = true;
        else if (currentTab != null)
        {
            currentTab.Settings.AutoTrade = false;
            WorkspaceManager.Save(userId, currentTab);
        }
    }

    private void ConfirmAutoTrade()
    {
        if (currentTab != null)
        {
            currentTab.Settings.AutoTrade = true;
            WorkspaceManager.Save(userId, currentTab);
        }
        showAutoTradeModal = false;
    }

    private void CancelAutoTrade() => showAutoTradeModal = false;

    private void SaveTab()
    {
        if (currentTab != null)
            WorkspaceManager.Save(userId, currentTab);
    }

    /// <summary>
    /// Manual "Fire Signal" handler. Real money path — every check below is
    /// load-bearing.
    ///
    /// Replaces the legacy hardcoded <c>Quantity = 1, OrderType.Market</c>
    /// with Guardian-driven sizing + a Limit order at the validated entry:
    ///   1. <see cref="RiskGuardian.CalculateMaxQuantity"/> derives a safe
    ///      share count from the signal's stop and the user's global config.
    ///   2. <see cref="RiskGuardian.ValidateTrade"/> runs the full check
    ///      (stop side, daily-loss, account %, stop-distance bounds).
    ///   3. Only if Guardian approves does the broker call happen.
    ///   4. Limit (not Market) so the entry price the Guardian validated
    ///      actually holds at fill — a market gap could otherwise blow past
    ///      the validated risk.
    ///
    /// Block path surfaces reasons in <c>orderFeedback</c> AND writes
    /// "MANUAL_TRADE_BLOCKED" to the audit DB (with structured dataJson).
    /// </summary>
    private async Task FireSignal(TradeSignal signal)
    {
        orderFeedback = null;
        if (string.IsNullOrEmpty(userId))
        {
            orderFeedback = "Sign in to place trades.";
            return;
        }

        try
        {
            var riskPerShare = Math.Abs(signal.SuggestedEntry - signal.SuggestedStop);
            if (riskPerShare <= 0)
            {
                orderFeedback = "Cannot fire — signal has no stop or stop equals entry.";
                return;
            }

            var guardian = await RiskGuardianService.GetForUserAsync(userId);
            var qty = guardian.CalculateMaxQuantity(signal.SuggestedEntry, signal.SuggestedStop);
            if (qty <= 0)
            {
                orderFeedback = "🛑 Risk Guardian blocked: computed quantity ≤ 0 (per-trade or daily cap reached).";
                AuditLogger.Log("MANUAL_TRADE_BLOCKED", $"Symbol={signal.Symbol} Reason=qty<=0", signal.Symbol);
                await SafeAuditAsync("MANUAL_TRADE_BLOCKED",
                    $"[{signal.StrategyName}] {signal.Symbol} blocked: qty<=0 after Guardian sizing",
                    userId);
                return;
            }

            var takeProfit = signal.Targets.Count > 0
                ? signal.Targets[0]
                : signal.Direction == TradeDirection.Long
                    ? signal.SuggestedEntry + (signal.SuggestedEntry - signal.SuggestedStop)
                    : signal.SuggestedEntry - (signal.SuggestedStop - signal.SuggestedEntry);

            var setup = new TradeSetup
            {
                Symbol          = signal.Symbol,
                Direction       = signal.Direction,
                EntryPrice      = signal.SuggestedEntry,
                EntryType       = OrderType.Limit,
                StopLoss        = signal.SuggestedStop,
                TakeProfit      = takeProfit,
                Quantity        = qty,
                ConfidenceScore = (int)Math.Clamp(signal.ConfidencePercent, 0m, 100m),
                Rationale       = signal.Reason,
            };

            var verdict = guardian.ValidateTrade(setup);
            if (!verdict.IsApproved)
            {
                var reasons = string.Join("; ", verdict.BlockReasons);
                orderFeedback = $"🛑 Risk Guardian BLOCKED this trade: {reasons}";
                AuditLogger.Log("MANUAL_TRADE_BLOCKED", $"Symbol={signal.Symbol} Reasons={reasons}", signal.Symbol);
                await SafeAuditAsync("MANUAL_TRADE_BLOCKED",
                    message: $"[{signal.StrategyName}] {signal.Symbol} ({signal.Direction}) blocked by RiskGuardian: {reasons}",
                    userId: userId,
                    dataJson: System.Text.Json.JsonSerializer.Serialize(new
                    {
                        blockReasons = verdict.BlockReasons,
                        warnings     = verdict.Warnings,
                        expectedLoss = verdict.ExpectedLoss,
                        worstCase    = verdict.WorstCaseLoss,
                        quantity     = qty,
                        entry        = signal.SuggestedEntry,
                        stop         = signal.SuggestedStop,
                    }));
                return;
            }

            var keys = await UserKeyService.GetOrCreateAsync(userId);
            IBrokerClient broker = !string.IsNullOrWhiteSpace(keys.AlpacaApiKeyId)
                ? new AlpacaBrokerClient(keys.AlpacaApiKeyId, keys.AlpacaApiSecretKey ?? "", keys.AlpacaIsPaper)
                : new SandboxBrokerClient();

            var brokerName = !string.IsNullOrWhiteSpace(keys.AlpacaApiKeyId) ? "Alpaca" : "Sandbox";
            var request = new OrderRequest
            {
                Symbol     = signal.Symbol,
                Quantity   = qty,
                Side       = signal.Direction == TradeDirection.Long ? OrderSide.Buy : OrderSide.Sell,
                Type       = OrderType.Limit,
                LimitPrice = signal.SuggestedEntry,
                TimeInForce = "DAY"
            };

            var result = await broker.PlaceOrderAsync(request);
            AuditLogger.Log("MANUAL_TRADE",
                $"BrokerOrderId={result.BrokerOrderId} Symbol={signal.Symbol} Side={request.Side} Qty={qty} Strategy={signal.StrategyName}",
                signal.Symbol);
            await SafeAuditAsync("MANUAL_TRADE",
                $"[{signal.StrategyName}] {signal.Symbol} {request.Side} qty={qty} @ ${signal.SuggestedEntry:F2} via {brokerName} — broker order {result.BrokerOrderId}",
                userId);

            var warningSuffix = verdict.Warnings.Count > 0
                ? $" (warnings: {string.Join(", ", verdict.Warnings)})"
                : "";
            orderFeedback = $"Order placed: {request.Side} {qty} {signal.Symbol} @ ${signal.SuggestedEntry:F2} via {brokerName} (ID: {result.BrokerOrderId}){warningSuffix}";
        }
        catch (Exception ex)
        {
            AuditLogger.Log("MANUAL_TRADE_FAIL", $"Symbol={signal.Symbol} Error={ex.Message}", signal.Symbol);
            await SafeAuditAsync("MANUAL_TRADE_FAIL",
                message: $"[{signal.StrategyName}] {signal.Symbol} threw during placement: {ex.Message}",
                userId: userId,
                dataJson: System.Text.Json.JsonSerializer.Serialize(new { exception = ex.ToString() }));
            orderFeedback = $"Order failed: {ex.Message}";
        }
    }

    /// <summary>
    /// Wraps the audit-DB write so a failing repository call never bubbles
    /// out of the trade path. The legacy file-based <see cref="AuditLogger"/>
    /// has already captured the event by the time we reach here.
    /// </summary>
    private async Task SafeAuditAsync(string category, string message, string userId, string? dataJson = null)
    {
        try { await AuditLogRepository.LogAsync(category, message, userId, dataJson); }
        catch { /* audit DB outage must not mask broker-call results */ }
    }

    public void Dispose() => refreshTimer?.Dispose();
}
