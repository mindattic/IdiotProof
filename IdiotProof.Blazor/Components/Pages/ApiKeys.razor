@page "/api-keys"
@rendermode InteractiveServer
@using IdiotProof.Blazor.Data
@using IdiotProof.Engine.Settings
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject UserKeyService UserKeyService
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>API Keys — IdiotProof</PageTitle>

<section aria-labelledby="api-keys-heading">
<div class="alert alert-warning d-flex align-items-start gap-2 mb-4" role="alert">
    <i class="bi bi-shield-exclamation fs-4 flex-shrink-0" aria-hidden="true"></i>
    <div>
        <strong>Security Notice:</strong> keys are stored only in MindAttic.Vault on this machine
        (<code>%APPDATA%\MindAttic\Brokers</code> and <code>Tokens</code>), never in the database, and a stored key is never sent
        back to this page (only its first characters). Leave a field blank to keep what is stored.
        Treat your live broker keys like passwords — never share them.
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 id="api-keys-heading" class="h4 mb-0 text-white">
        <i class="bi bi-key me-2" style="color:var(--yellow)" aria-hidden="true"></i>API Keys &amp; Connections
    </h1>
    <button class="btn btn-success btn-sm" type="button" @onclick="() => SaveAll()" aria-label="Save all API keys and connection settings">
        <i class="bi bi-floppy me-1" aria-hidden="true"></i>Save All
    </button>
</div>

<div role="status" aria-live="polite" aria-atomic="true">
@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="alert alert-success small py-2 mb-3">@saveMessage</div>
}
</div>

<!-- Alpaca Section -->
<section class="trading-card p-3 mb-3" aria-labelledby="alpaca-heading">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 id="alpaca-heading" class="h6 text-white mb-0">
            <i class="bi bi-graph-up me-1" aria-hidden="true"></i>Alpaca
        </h2>
    </div>
    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" id="routeToAlpaca"
               checked="@routeToMyAlpaca"
               @onchange="e => routeToMyAlpaca = (bool)(e.Value ?? false)" />
        <label class="form-check-label text-muted small" for="routeToAlpaca">
            Route my orders to this Alpaca account — paper vs. live is set per strategy on the Strategies page.
            Off = all orders go to the safe Sandbox default.
        </label>
    </div>

    <!-- Paper keys -->
    <div class="mb-3 pb-3" style="border-bottom:1px solid rgba(255,255,255,.08)">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h3 class="h6 small fw-semibold mb-0" style="color:var(--yellow)">
                <i class="bi bi-shield-check me-1" aria-hidden="true"></i>Paper Trading Keys
            </h3>
            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => TestAlpaca(isPaper: true)" aria-label="Test Alpaca paper connection">
                <i class="bi bi-broadcast me-1" aria-hidden="true"></i>Test Connection
            </button>
        </div>
        <div class="small text-muted mb-2">
            Stored: <code>@paperStored</code>
            @if (paperHasStored)
            {
                <button class="btn btn-link btn-sm text-danger p-0 ms-2" type="button" @onclick="() => RemoveAlpaca(isPaper: true)"
                        aria-label="Remove the stored paper Alpaca keys from Vault">Remove</button>
            }
        </div>
        <div role="status" aria-live="polite" aria-atomic="true">
        @if (!string.IsNullOrEmpty(alpacaPaperTestResult))
        {
            <div class="alert @(alpacaPaperTestOk ? "alert-success" : "alert-danger") small py-1 mb-2">@alpacaPaperTestResult</div>
        }
        </div>
        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label text-muted small" for="alpaca-paper-key-id">API Key ID</label>
                <div class="input-group">
                    <input id="alpaca-paper-key-id"
                           class="form-control bg-dark text-white border-secondary"
                           type="@(showAlpacaPaperKey ? "text" : "password")"
                           @bind="alpacaPaperKeyId"
                           autocomplete="off"
                           placeholder="@(paperHasStored ? "keep stored key" : "PK...")" />
                    <button class="btn btn-outline-secondary"
                            type="button"
                            @onclick="() => showAlpacaPaperKey = !showAlpacaPaperKey"
                            aria-label="@(showAlpacaPaperKey ? "Hide paper API key ID" : "Show paper API key ID")"
                            aria-pressed="@showAlpacaPaperKey">
                        <i class="bi @(showAlpacaPaperKey ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted small" for="alpaca-paper-secret">Secret Key</label>
                <div class="input-group">
                    <input id="alpaca-paper-secret"
                           class="form-control bg-dark text-white border-secondary"
                           type="@(showAlpacaPaperSecret ? "text" : "password")"
                           @bind="alpacaPaperSecret"
                           autocomplete="off"
                           placeholder="@(paperHasStored ? "keep stored secret" : "secret")" />
                    <button class="btn btn-outline-secondary"
                            type="button"
                            @onclick="() => showAlpacaPaperSecret = !showAlpacaPaperSecret"
                            aria-label="@(showAlpacaPaperSecret ? "Hide paper secret key" : "Show paper secret key")"
                            aria-pressed="@showAlpacaPaperSecret">
                        <i class="bi @(showAlpacaPaperSecret ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Live keys -->
    <div>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h3 class="h6 small fw-semibold mb-0 text-danger">
                <i class="bi bi-broadcast me-1" aria-hidden="true"></i>Live Trading Keys
            </h3>
            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => TestAlpaca(isPaper: false)" aria-label="Test Alpaca live connection">
                <i class="bi bi-broadcast me-1" aria-hidden="true"></i>Test Connection
            </button>
        </div>
        <div class="alert alert-danger small py-2 mb-2" role="alert">
            These authorize <strong>real-money</strong> trades on your live Alpaca account. Only strategies
            explicitly switched to Live mode (with re-authentication) will ever use them.
        </div>
        <div class="small text-muted mb-2">
            Stored: <code>@liveStored</code>
            @if (liveHasStored)
            {
                <button class="btn btn-link btn-sm text-danger p-0 ms-2" type="button" @onclick="() => RemoveAlpaca(isPaper: false)"
                        aria-label="Remove the stored live Alpaca keys from Vault">Remove</button>
            }
        </div>
        <div role="status" aria-live="polite" aria-atomic="true">
        @if (!string.IsNullOrEmpty(alpacaLiveTestResult))
        {
            <div class="alert @(alpacaLiveTestOk ? "alert-success" : "alert-danger") small py-1 mb-2">@alpacaLiveTestResult</div>
        }
        </div>
        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label text-muted small" for="alpaca-live-key-id">API Key ID</label>
                <div class="input-group">
                    <input id="alpaca-live-key-id"
                           class="form-control bg-dark text-white border-secondary"
                           type="@(showAlpacaLiveKey ? "text" : "password")"
                           @bind="alpacaLiveKeyId"
                           autocomplete="off"
                           placeholder="@(liveHasStored ? "keep stored key" : "AK...")" />
                    <button class="btn btn-outline-secondary"
                            type="button"
                            @onclick="() => showAlpacaLiveKey = !showAlpacaLiveKey"
                            aria-label="@(showAlpacaLiveKey ? "Hide live API key ID" : "Show live API key ID")"
                            aria-pressed="@showAlpacaLiveKey">
                        <i class="bi @(showAlpacaLiveKey ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted small" for="alpaca-live-secret">Secret Key</label>
                <div class="input-group">
                    <input id="alpaca-live-secret"
                           class="form-control bg-dark text-white border-secondary"
                           type="@(showAlpacaLiveSecret ? "text" : "password")"
                           @bind="alpacaLiveSecret"
                           autocomplete="off"
                           placeholder="@(liveHasStored ? "keep stored secret" : "secret")" />
                    <button class="btn btn-outline-secondary"
                            type="button"
                            @onclick="() => showAlpacaLiveSecret = !showAlpacaLiveSecret"
                            aria-label="@(showAlpacaLiveSecret ? "Hide live secret key" : "Show live secret key")"
                            aria-pressed="@showAlpacaLiveSecret">
                        <i class="bi @(showAlpacaLiveSecret ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- Claude / AI Section -->
<section class="trading-card p-3 mb-3" aria-labelledby="claude-heading">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 id="claude-heading" class="h6 text-white mb-0">
            <i class="bi bi-robot me-1" aria-hidden="true"></i>AI (Claude) — LLM Signal Voting
        </h2>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label text-muted small" for="claude-key">Claude API Key</label>
            <div class="input-group">
                <input id="claude-key"
                       class="form-control bg-dark text-white border-secondary"
                       type="@(showClaudeKey ? "text" : "password")"
                       @bind="claudeKey"
                       autocomplete="off"
                       placeholder="@(claudeStored is null ? "sk-ant-..." : "keep stored key (" + claudeStored + ")")" />
                <button class="btn btn-outline-secondary"
                        type="button"
                        @onclick="() => showClaudeKey = !showClaudeKey"
                        aria-label="@(showClaudeKey ? "Hide Claude API key" : "Show Claude API key")"
                        aria-pressed="@showClaudeKey">
                    <i class="bi @(showClaudeKey ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                </button>
            </div>
            <div class="form-text text-muted small" id="claude-key-scope">
                Stored in Vault for your account only (Tokens bucket). The Monitor uses it to vote on your strategies;
                it never becomes another user's key or the app's shared key.
                @if (claudeStored is not null)
                {
                    <button class="btn btn-link btn-sm text-danger p-0 ms-1" type="button" @onclick="RemoveClaude" aria-label="Remove the stored Claude key">Remove</button>
                }
            </div>
        </div>
        <div class="col-md-4">
            <label class="form-label text-muted small" for="claude-model">Primary Model</label>
            <select id="claude-model" class="form-select bg-dark text-white border-secondary" @bind="claudeModel">
                <option value="claude-sonnet-5">claude-sonnet-5 (Recommended)</option>
                <option value="claude-haiku-4-5-20251001">claude-haiku-4-5-20251001</option>
                @* legacy id kept selectable so rows saved before the rename still bind *@
                <option value="claude-sonnet-4-6">claude-sonnet-4-6 (legacy)</option>
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="llmEnabled" @bind="llmVotingEnabled" />
                <label class="form-check-label text-muted small" for="llmEnabled">Enabled</label>
            </div>
        </div>
    </div>
    @if (llmVotingEnabled && string.IsNullOrWhiteSpace(claudeKey) && claudeStored is null)
    {
        <div class="alert alert-warning small py-1 mt-2" role="alert">
            LLM voting is enabled but no API key is set here. The Monitor will vote on the host's shared Claude key if one is configured; otherwise voting is skipped.
        </div>
    }
</section>
</section>

@code {
    // Typed-in values only: stored secrets are never loaded into these fields (IP-T330), so a
    // secret never travels back to the browser. Blank = keep what Vault holds.
    private string alpacaPaperKeyId = "";
    private string alpacaPaperSecret = "";
    private bool showAlpacaPaperKey;
    private bool showAlpacaPaperSecret;

    private string alpacaLiveKeyId = "";
    private string alpacaLiveSecret = "";
    private bool showAlpacaLiveKey;
    private bool showAlpacaLiveSecret;

    private string claudeKey = "";
    private string claudeModel = "claude-sonnet-5";
    private bool showClaudeKey;
    private bool llmVotingEnabled;

    private string alpacaPaperTestResult = "";
    private bool alpacaPaperTestOk;
    private string alpacaLiveTestResult = "";
    private bool alpacaLiveTestOk;
    private string saveMessage = "";
    private bool routeToMyAlpaca;
    private string? loadedDataFeed;

    // What Vault holds, masked (first characters of the key id only).
    private string paperStored = "not set";
    private string liveStored = "not set";
    private bool paperHasStored;
    private bool liveHasStored;
    private string? claudeStored;

    private Guid? userId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var rawId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        userId = Guid.TryParse(rawId, out var uid) ? uid : null;
        if (userId is null) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var keys = await UserKeyService.GetOrCreateAsync(userId!.Value);
        claudeModel      = string.IsNullOrWhiteSpace(keys.ClaudeModel) ? "claude-sonnet-5" : keys.ClaudeModel;
        llmVotingEnabled = keys.LlmVotingEnabled;
        routeToMyAlpaca  = string.Equals(keys.DefaultBroker, "alpaca", StringComparison.OrdinalIgnoreCase);
        loadedDataFeed   = keys.DefaultDataFeed;

        var vault = UserKeyService.Vault;
        paperHasStored = keys.AlpacaApiKeyId is not null;
        liveHasStored  = keys.AlpacaLiveApiKeyId is not null;
        paperStored = paperHasStored ? $"{Mask(keys.AlpacaApiKeyId)} (Vault Brokers/{vault.AlpacaEntry(userId.Value, true)})" : "not set";
        liveStored  = liveHasStored ? $"{Mask(keys.AlpacaLiveApiKeyId)} (Vault Brokers/{vault.AlpacaEntry(userId.Value, false)})" : "not set";
        claudeStored = keys.ClaudeApiKey is null ? null : Mask(keys.ClaudeApiKey);
    }

    private static string Mask(string? value) =>
        string.IsNullOrEmpty(value) ? "" : value.Length <= 8 ? "***" : value[..4] + "...";

    private async Task TestAlpaca(bool isPaper)
    {
        void SetResult(string msg, bool ok)
        {
            if (isPaper) { alpacaPaperTestResult = msg; alpacaPaperTestOk = ok; }
            else         { alpacaLiveTestResult  = msg; alpacaLiveTestOk  = ok; }
        }
        if (userId is null) return;

        // Typed values when given, else what Vault holds.
        var stored = await UserKeyService.GetOrCreateAsync(userId.Value);
        var keyId  = Pick(isPaper ? alpacaPaperKeyId : alpacaLiveKeyId, isPaper ? stored.AlpacaApiKeyId : stored.AlpacaLiveApiKeyId);
        var secret = Pick(isPaper ? alpacaPaperSecret : alpacaLiveSecret, isPaper ? stored.AlpacaApiSecretKey : stored.AlpacaLiveApiSecretKey);

        if (string.IsNullOrWhiteSpace(keyId) || string.IsNullOrWhiteSpace(secret))
        {
            SetResult("Enter API Key ID and Secret Key first.", false);
            return;
        }
        SetResult("Testing...", false);
        StateHasChanged();
        try
        {
            using var client = HttpClientFactory.CreateClient();
            client.DefaultRequestHeaders.Add("APCA-API-KEY-ID", keyId);
            client.DefaultRequestHeaders.Add("APCA-API-SECRET-KEY", secret);
            var baseUrl = isPaper ? "https://paper-api.alpaca.markets" : "https://api.alpaca.markets";
            var resp = await client.GetAsync($"{baseUrl}/v2/account");
            SetResult(resp.IsSuccessStatusCode ? "Connected!" : $"Failed: HTTP {(int)resp.StatusCode} — check your keys.", resp.IsSuccessStatusCode);
        }
        catch (Exception ex)
        {
            SetResult($"Error: {ex.Message}", false);
        }
    }

    private static string? Pick(string typed, string? stored) =>
        string.IsNullOrWhiteSpace(typed) ? stored : typed.Trim();

    private async Task SaveAll()
    {
        if (userId is null) return;

        // Guarded: an unhandled exception here (Vault file locked, SQL blip) used to tear down
        // the whole circuit — the user got the generic error banner and lost what they typed.
        try
        {
            var keys = await UserKeyService.GetOrCreateAsync(userId.Value);
            // A typed half replaces just that half of the stored pair; blank keeps what is stored.
            keys.AlpacaApiKeyId         = Pick(alpacaPaperKeyId, keys.AlpacaApiKeyId);
            keys.AlpacaApiSecretKey     = Pick(alpacaPaperSecret, keys.AlpacaApiSecretKey);
            keys.AlpacaLiveApiKeyId     = Pick(alpacaLiveKeyId, keys.AlpacaLiveApiKeyId);
            keys.AlpacaLiveApiSecretKey = Pick(alpacaLiveSecret, keys.AlpacaLiveApiSecretKey);
            keys.ClaudeApiKey           = Pick(claudeKey, keys.ClaudeApiKey);
            keys.ClaudeModel            = claudeModel;
            keys.LlmVotingEnabled       = llmVotingEnabled;
            keys.DefaultBroker          = routeToMyAlpaca ? "alpaca" : "Sandbox";
            keys.DefaultDataFeed        = string.IsNullOrWhiteSpace(loadedDataFeed) ? "Mock" : loadedDataFeed;
            // OAuth tokens and scope come back from GetOrCreateAsync untouched, so Save keeps them.

            await UserKeyService.SaveAsync(userId.Value, keys);
            ClearTyped();
            await LoadAsync();
            saveMessage = "Keys saved to Vault.";
        }
        catch (Exception ex)
        {
            saveMessage = $"Save failed: {ex.Message}";
        }

        // The Claude key is stored ONLY under this user's own Vault Tokens entry. It is never
        // written to the Vault LLM keyring: that keyring is the host key every user falls back
        // to, and the host key changes only through Vault or configuration, never from a user page.
    }

    private async Task RemoveAlpaca(bool isPaper)
    {
        if (userId is null) return;
        try
        {
            var keys = await UserKeyService.GetOrCreateAsync(userId.Value);
            if (isPaper) { keys.AlpacaApiKeyId = null; keys.AlpacaApiSecretKey = null; }
            else { keys.AlpacaLiveApiKeyId = null; keys.AlpacaLiveApiSecretKey = null; }
            await UserKeyService.SaveAsync(userId.Value, keys);
            await LoadAsync();
            saveMessage = $"{(isPaper ? "Paper" : "Live")} keys removed from Vault.";
        }
        catch (Exception ex)
        {
            saveMessage = $"Remove failed: {ex.Message}";
        }
    }

    private async Task RemoveClaude()
    {
        if (userId is null) return;
        try
        {
            var keys = await UserKeyService.GetOrCreateAsync(userId.Value);
            keys.ClaudeApiKey = null;
            await UserKeyService.SaveAsync(userId.Value, keys);
            claudeKey = "";
            await LoadAsync();
            saveMessage = "Claude key removed from Vault.";
        }
        catch (Exception ex)
        {
            saveMessage = $"Remove failed: {ex.Message}";
        }
    }

    private void ClearTyped()
    {
        alpacaPaperKeyId = alpacaPaperSecret = alpacaLiveKeyId = alpacaLiveSecret = claudeKey = "";
    }
}
