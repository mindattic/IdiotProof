@page "/api-keys"
@rendermode InteractiveServer
@using IdiotProof.Blazor.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject UserKeyService UserKeyService
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>API Keys — IdiotProof</PageTitle>

<section aria-labelledby="api-keys-heading">
<div class="alert alert-warning d-flex align-items-start gap-2 mb-4" role="alert">
    <i class="bi bi-shield-exclamation fs-4 flex-shrink-0" aria-hidden="true"></i>
    <div>
        <strong>Security Notice:</strong> API keys are stored locally in your AppData folder and never transmitted to any third party.
        Keys are masked in this interface. Treat your live broker keys like passwords — never share them.
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 id="api-keys-heading" class="h4 mb-0 text-white">
        <i class="bi bi-key me-2" style="color:var(--yellow)" aria-hidden="true"></i>API Keys &amp; Connections
    </h1>
    <button class="btn btn-success btn-sm" type="button" @onclick="() => SaveAll()" aria-label="Save all API keys and connection settings">
        <i class="bi bi-floppy me-1" aria-hidden="true"></i>Save All
    </button>
</div>

<div role="status" aria-live="polite" aria-atomic="true">
@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="alert alert-success small py-2 mb-3">@saveMessage</div>
}
</div>

<!-- Alpaca Section -->
<section class="trading-card p-3 mb-3" aria-labelledby="alpaca-heading">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 id="alpaca-heading" class="h6 text-white mb-0">
            <i class="bi bi-graph-up me-1" aria-hidden="true"></i>Alpaca
        </h2>
        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="TestAlpaca" aria-label="Test Alpaca connection">
            <i class="bi bi-broadcast me-1" aria-hidden="true"></i>Test Connection
        </button>
    </div>
    <div role="status" aria-live="polite" aria-atomic="true">
    @if (!string.IsNullOrEmpty(alpacaTestResult))
    {
        <div class="alert @(alpacaTestOk ? "alert-success" : "alert-danger") small py-1 mb-2">@alpacaTestResult</div>
    }
    </div>
    <div class="row g-3">
        <div class="col-md-5">
            <label class="form-label text-muted small" for="alpaca-key-id">API Key ID</label>
            <div class="input-group">
                <input id="alpaca-key-id"
                       class="form-control bg-dark text-white border-secondary"
                       type="@(showAlpacaKey ? "text" : "password")"
                       @bind="alpacaKeyId"
                       autocomplete="off"
                       placeholder="PK..." />
                <button class="btn btn-outline-secondary"
                        type="button"
                        @onclick="() => showAlpacaKey = !showAlpacaKey"
                        aria-label="@(showAlpacaKey ? "Hide Alpaca API key ID" : "Show Alpaca API key ID")"
                        aria-pressed="@showAlpacaKey">
                    <i class="bi @(showAlpacaKey ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="col-md-5">
            <label class="form-label text-muted small" for="alpaca-secret">Secret Key</label>
            <div class="input-group">
                <input id="alpaca-secret"
                       class="form-control bg-dark text-white border-secondary"
                       type="@(showAlpacaSecret ? "text" : "password")"
                       @bind="alpacaSecret"
                       autocomplete="off"
                       placeholder="••••••••••••" />
                <button class="btn btn-outline-secondary"
                        type="button"
                        @onclick="() => showAlpacaSecret = !showAlpacaSecret"
                        aria-label="@(showAlpacaSecret ? "Hide Alpaca secret key" : "Show Alpaca secret key")"
                        aria-pressed="@showAlpacaSecret">
                    <i class="bi @(showAlpacaSecret ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="alpacaPaper"
                       checked="@alpacaIsPaper"
                       @onchange="OnAlpacaPaperChange" />
                <label class="form-check-label text-muted small" for="alpacaPaper">Paper</label>
            </div>
        </div>
    </div>
    <div class="form-check form-switch mt-3">
        <input class="form-check-input" type="checkbox" id="routeToAlpaca"
               checked="@routeToMyAlpaca"
               @onchange="e => routeToMyAlpaca = (bool)(e.Value ?? false)" />
        <label class="form-check-label text-muted small" for="routeToAlpaca">
            Route my orders to this Alpaca account — the console Monitor trades with these keys
            (@(alpacaIsPaper ? "paper" : "LIVE")). Off = orders go to the safe Sandbox default.
        </label>
    </div>
    @if (!alpacaIsPaper)
    {
        <div class="alert alert-danger small py-1 mt-2" role="alert">
            <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
            <strong>LIVE Alpaca trading.</strong> Real money will be used.
        </div>
    }
</section>

<!-- Polygon.io Section -->
<section class="trading-card p-3 mb-3" aria-labelledby="polygon-heading">
    <h2 id="polygon-heading" class="h6 text-white mb-3">
        <i class="bi bi-bar-chart-line me-1" aria-hidden="true"></i>Polygon.io — Historical Market Data (Backtest)
    </h2>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label text-muted small" for="polygon-key">API Key</label>
            <div class="input-group">
                <input id="polygon-key"
                       class="form-control bg-dark text-white border-secondary"
                       type="@(showPolygonKey ? "text" : "password")"
                       @bind="polygonKey"
                       autocomplete="off"
                       placeholder="Optional — enables live historical data in Backtest" />
                <button class="btn btn-outline-secondary"
                        type="button"
                        @onclick="() => showPolygonKey = !showPolygonKey"
                        aria-label="@(showPolygonKey ? "Hide Polygon API key" : "Show Polygon API key")"
                        aria-pressed="@showPolygonKey">
                    <i class="bi @(showPolygonKey ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                </button>
            </div>
            <div class="form-text text-muted small">
                Free tier provides historical OHLCV data. Without a key the backtest uses simulated candles.
            </div>
        </div>
    </div>
</section>

<!-- Claude / AI Section -->
<section class="trading-card p-3 mb-3" aria-labelledby="claude-heading">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 id="claude-heading" class="h6 text-white mb-0">
            <i class="bi bi-robot me-1" aria-hidden="true"></i>AI (Claude) — LLM Signal Voting
        </h2>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label text-muted small" for="claude-key">Claude API Key</label>
            <div class="input-group">
                <input id="claude-key"
                       class="form-control bg-dark text-white border-secondary"
                       type="@(showClaudeKey ? "text" : "password")"
                       @bind="claudeKey"
                       autocomplete="off"
                       placeholder="sk-ant-..." />
                <button class="btn btn-outline-secondary"
                        type="button"
                        @onclick="() => showClaudeKey = !showClaudeKey"
                        aria-label="@(showClaudeKey ? "Hide Claude API key" : "Show Claude API key")"
                        aria-pressed="@showClaudeKey">
                    <i class="bi @(showClaudeKey ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div class="col-md-4">
            <label class="form-label text-muted small" for="claude-model">Primary Model</label>
            <select id="claude-model" class="form-select bg-dark text-white border-secondary" @bind="claudeModel">
                <option value="claude-sonnet-5">claude-sonnet-5 (Recommended)</option>
                <option value="claude-haiku-4-5-20251001">claude-haiku-4-5-20251001</option>
                @* legacy id kept selectable so rows saved before the rename still bind *@
                <option value="claude-sonnet-4-6">claude-sonnet-4-6 (legacy)</option>
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="llmEnabled" @bind="llmVotingEnabled" />
                <label class="form-check-label text-muted small" for="llmEnabled">Enabled</label>
            </div>
        </div>
    </div>
    @if (llmVotingEnabled && string.IsNullOrWhiteSpace(claudeKey))
    {
        <div class="alert alert-warning small py-1 mt-2" role="alert">
            LLM voting is enabled but no API key is set. Voting will be skipped.
        </div>
    }
</section>
</section>

<!-- Alpaca Live Mode Confirm Modal -->
@if (showLiveModeModal)
{
    <div class="modal-backdrop fade show" @onclick="CancelLiveMode"></div>
    <div class="modal fade show d-block"
         role="dialog"
         aria-modal="true"
         aria-labelledby="live-mode-title"
         aria-describedby="live-mode-desc"
         tabindex="-1"
         @onkeydown="HandleLiveModeKey">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-danger">
                <div class="modal-header border-danger">
                    <h2 id="live-mode-title" class="h5 modal-title text-danger">
                        <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>Enable Live Trading?
                    </h2>
                </div>
                <div class="modal-body text-white" id="live-mode-desc">
                    <p>Disabling paper mode for Alpaca means orders will be placed with <strong>real money</strong>.</p>
                    <p class="text-warning">Are you absolutely sure you want to continue?</p>
                </div>
                <div class="modal-footer border-danger">
                    <button class="btn btn-secondary" type="button" @onclick="CancelLiveMode">Cancel</button>
                    <button class="btn btn-danger" type="button" @onclick="ConfirmLiveMode" autofocus>Yes, Use Real Money</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string alpacaKeyId = "";
    private string alpacaSecret = "";
    private bool alpacaIsPaper = true;
    private bool showAlpacaKey;
    private bool showAlpacaSecret;
    private bool showLiveModeModal;

    private string polygonKey = "";
    private bool showPolygonKey;

    private string claudeKey = "";
    private string claudeModel = "claude-sonnet-5";
    private bool showClaudeKey;
    private bool llmVotingEnabled;

    private string alpacaTestResult = "";
    private bool alpacaTestOk;
    private string saveMessage = "";
    private bool routeToMyAlpaca;
    private string? loadedDataFeed;

    private Guid? userId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var rawId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        userId = Guid.TryParse(rawId, out var uid) ? uid : null;
        if (userId is null) return;

        var keys = await UserKeyService.GetOrCreateAsync(userId.Value);
        alpacaKeyId    = keys.AlpacaApiKeyId ?? "";
        alpacaSecret   = keys.AlpacaApiSecretKey ?? "";
        alpacaIsPaper  = keys.AlpacaIsPaper;
        polygonKey     = keys.PolygonApiKey ?? "";
        claudeKey      = keys.ClaudeApiKey ?? "";
        claudeModel    = string.IsNullOrWhiteSpace(keys.ClaudeModel) ? "claude-sonnet-5" : keys.ClaudeModel;
        llmVotingEnabled = keys.LlmVotingEnabled;
        routeToMyAlpaca  = string.Equals(keys.DefaultBroker, "alpaca", StringComparison.OrdinalIgnoreCase);
        loadedDataFeed   = keys.DefaultDataFeed;
    }

    private void OnAlpacaPaperChange(ChangeEventArgs e)
    {
        var newVal = (bool)(e.Value ?? true);
        if (!newVal)
            showLiveModeModal = true;
        else
            alpacaIsPaper = true;
    }

    private void ConfirmLiveMode() { alpacaIsPaper = false; showLiveModeModal = false; }
    private void CancelLiveMode() { alpacaIsPaper = true; showLiveModeModal = false; }

    private void HandleLiveModeKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CancelLiveMode();
    }

    private async Task TestAlpaca()
    {
        if (string.IsNullOrWhiteSpace(alpacaKeyId) || string.IsNullOrWhiteSpace(alpacaSecret))
        {
            alpacaTestResult = "Enter API Key ID and Secret Key first.";
            alpacaTestOk = false;
            return;
        }
        alpacaTestResult = "Testing...";
        alpacaTestOk = false;
        StateHasChanged();
        try
        {
            using var client = HttpClientFactory.CreateClient();
            var baseUrl = alpacaIsPaper
                ? "https://paper-api.alpaca.markets"
                : "https://api.alpaca.markets";
            client.DefaultRequestHeaders.Add("APCA-API-KEY-ID", alpacaKeyId);
            client.DefaultRequestHeaders.Add("APCA-API-SECRET-KEY", alpacaSecret);
            var resp = await client.GetAsync($"{baseUrl}/v2/account");
            if (resp.IsSuccessStatusCode)
            {
                alpacaTestResult = $"Connected! ({(alpacaIsPaper ? "Paper" : "Live")})";
                alpacaTestOk = true;
            }
            else
            {
                alpacaTestResult = $"Failed: HTTP {(int)resp.StatusCode} — check your keys.";
                alpacaTestOk = false;
            }
        }
        catch (Exception ex)
        {
            alpacaTestResult = $"Error: {ex.Message}";
            alpacaTestOk = false;
        }
    }

    private async Task SaveAll()
    {
        if (userId is null) return;

        var keys = new UserApiKeys
        {
            UserId             = userId.Value,
            AlpacaApiKeyId     = alpacaKeyId,
            AlpacaApiSecretKey = alpacaSecret,
            AlpacaIsPaper      = alpacaIsPaper,
            PolygonApiKey      = polygonKey,
            ClaudeApiKey       = claudeKey,
            ClaudeModel        = claudeModel,
            LlmVotingEnabled   = llmVotingEnabled,
            // SaveAsync overwrites the WHOLE row — omitting these silently
            // reset the user's broker routing to the class defaults on every
            // unrelated key edit (IP-A11), which also made the per-user
            // Alpaca routing (IP-A9) unreachable: nothing ever set "alpaca".
            DefaultBroker      = routeToMyAlpaca ? "alpaca" : "Sandbox",
            DefaultDataFeed    = string.IsNullOrWhiteSpace(loadedDataFeed) ? "Mock" : loadedDataFeed,
        };

        // Guarded: an unhandled exception here (Data Protection key-ring
        // issue, SQL blip) used to tear down the whole circuit — the user got
        // the generic error banner and lost everything they had typed.
        try
        {
            await UserKeyService.SaveAsync(userId.Value, keys);
            saveMessage = "Keys saved successfully.";
        }
        catch (Exception ex)
        {
            saveMessage = $"Save failed: {ex.Message}";
        }
    }
}
