@page "/gapper"
@rendermode InteractiveServer
@using IdiotProof.Blazor.Data
@using IdiotProof.Blazor.Services
@using IdiotProof.Scripting
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@using IdiotProof.DataFeeds
@using IdiotProof.Strategies
@inject StrategyRepository StrategyRepo
@inject ConditionProgressRepository ProgressRepo
@inject GapperProfileService ProfileService
@inject GapperInterpreter Interpreter
@inject IdiotProof.Engine.Settings.AppSettings AppSettings
@inject UserKeyService UserKeys
@inject AuthenticationStateProvider AuthState
@implements IDisposable

@*
    Gapper — the one thing done well (RFC 0002 / IP-A8). Pick up to three
    tickers, select an adjustable gapper profile per ticker, dial it in (all
    gappers are not the same), and queue. Queued gappers become ordinary
    Strategy rows: the console Monitor re-reads them every tick, buys the gap
    through the three gates in the 4AM premarket window, and sells off before
    the 9:30 bell once momentum rolls over (peak-giveback) — hard sell-by as
    the fallback. This page polls SQL every 5s, so the console's doings
    (condition progress, holding, sold) render here live.
*@

<PageTitle>Gapper — IdiotProof</PageTitle>

<section aria-labelledby="gapper-heading">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h1 id="gapper-heading" class="h4 mb-0">
            <i class="bi bi-sunrise me-2" style="color:var(--brand)" aria-hidden="true"></i>Gapper
        </h1>
        <div class="d-flex align-items-center gap-3">
            <span class="text-muted small">Buy the gap at 4AM · sell it off before the bell</span>
            <a class="btn btn-sm btn-outline-secondary" href="/user-guide.htm" target="_blank" rel="noopener"
               aria-label="Open the gapper user guide in a new tab">
                <i class="bi bi-book me-1" aria-hidden="true"></i>User Guide
            </a>
        </div>
    </div>
    <p class="text-muted small mb-3">
        Queue up to <strong>3 tickers</strong>. Each runs its own dial-in profile: gap screen → premarket entry →
        stop rails → momentum-rollover sell-off armed in the final minutes before 9:30 ET.
    </p>

    @if (loadError is not null)
    {
        <div class="alert alert-danger small">@loadError</div>
    }

    <!-- ── Interpret a transcript (Claude via Legion) ─────────────── -->
    <div class="trading-card p-3 mb-3">
        <div class="d-flex align-items-center gap-2 mb-2">
            <h2 class="h6 mb-0"><i class="bi bi-magic me-1" style="color:var(--brand)" aria-hidden="true"></i>From a transcript</h2>
            <span class="text-muted small">paste a video transcript or describe the plays — Claude turns them into gapper candidates you review before queueing</span>
        </div>
        <textarea class="form-control mb-2"
                  rows="6"
                  placeholder="e.g. “...watch ACME tomorrow, it's gapping huge on the FDA news, easily 10%+ premarket on massive volume. I'd keep a tight stop and take profits fast before the open. BETA is the slower play, big cap, gap and go...”"
                  @bind="transcriptText"
                  @bind:event="oninput"
                  aria-label="Transcript or natural-language description"></textarea>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-primary" type="button"
                    disabled="@(interpreting || string.IsNullOrWhiteSpace(transcriptText))"
                    @onclick="InterpretTranscript">
                @if (interpreting)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-stars me-1" aria-hidden="true"></i>
                }
                Interpret
            </button>
            @if (candidates.Count > 0)
            {
                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="ClearCandidates">Clear results</button>
            }
        </div>

        @if (interpretError is not null)
        {
            <div class="alert alert-warning small mt-2 mb-0">@interpretError</div>
        }
        @if (interpretWarnings.Count > 0)
        {
            <div class="text-muted small mt-2">
                @foreach (var w in interpretWarnings)
                {
                    <div><i class="bi bi-info-circle me-1" aria-hidden="true"></i>@w</div>
                }
            </div>
        }

        @foreach (var c in candidates)
        {
            <div class="border-top pt-3 mt-3" data-candidate="@c.Symbol">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="strategy-chip ticker-chip">@c.Symbol</span>
                    <span class="text-muted small flex-grow-1">@c.Rationale</span>
                    <button class="btn btn-sm btn-outline-secondary" type="button"
                            @onclick="() => LoadCandidateIntoDials(c)">
                        <i class="bi bi-sliders me-1" aria-hidden="true"></i>Load into dials
                    </button>
                    <button class="btn btn-sm btn-success" type="button"
                            disabled="@(ActiveGapperCount >= MaxGappers)"
                            @onclick="() => QueueCandidate(c)">
                        <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Queue
                    </button>
                </div>
                <div class="text-muted small mt-1">
                    gap ≥@c.Profile.MinGapPercent%@(c.Profile.MaxGapPercent is { } mx ? $" (≤{mx}%)" : "") ·
                    vol ≥@(c.Profile.MinVolumeRatio)× ·
                    $@c.Profile.MinPrice–$@c.Profile.MaxPrice ·
                    entry @c.Profile.EntryWindowStartEt–@c.Profile.EntryWindowEndEt ET ·
                    SL @c.Profile.StopLossPercent%@(c.Profile.TrailingStopPercent is { } tsl ? $" · TSL {tsl}%" : "") ·
                    giveback @c.Profile.PeakGivebackPercent% armed @c.Profile.ArmExitAtEt ·
                    flat by @c.Profile.SellByEt ·
                    $@c.Profile.DefaultNotional
                </div>
                <details class="mt-1">
                    <summary class="text-muted small" style="cursor:pointer">Show generated IdiotScript</summary>
                    <pre class="small mt-2 p-2" style="background:var(--bg-row-alt);border:1px solid var(--border);border-radius:6px;overflow:auto">@CandidateScript(c)</pre>
                </details>
            </div>
        }
    </div>

    <!-- ── Queue form ─────────────────────────────────────────────── -->
    <div class="trading-card p-3 mb-3">
        <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
            <input class="form-control text-uppercase fw-semibold"
                   style="max-width:140px"
                   placeholder="TICKER"
                   maxlength="10"
                   @bind="symbolInput"
                   @bind:event="oninput"
                   aria-label="Ticker symbol" />
            <select class="form-select" style="max-width:220px" aria-label="Gapper profile"
                    value="@selectedProfileId" @onchange="OnProfileSelected">
                @foreach (var p in ProfileService.GetProfiles())
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => showDials = !showDials"
                    aria-expanded="@showDials">
                <i class="bi bi-sliders me-1" aria-hidden="true"></i>Dial in
            </button>
            <button class="btn btn-success ms-auto" type="button"
                    disabled="@(!CanQueue)"
                    title="@(ActiveGapperCount >= MaxGappers ? "3 gappers already queued — remove one first" : null)"
                    @onclick="QueueGapper">
                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Queue Gapper
            </button>
        </div>
        <div class="text-muted small mb-2">@CurrentProfile.Description</div>

        @if (showDials)
        {
            <div class="border-top pt-3 mt-1">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <div class="fw-semibold small mb-2"><i class="bi bi-funnel me-1" aria-hidden="true"></i>Gap screen</div>
                        <label class="form-label small mb-0">Min gap %</label>
                        <input class="form-control form-control-sm" type="number" step="0.5" @bind="dial.MinGapPercent" />
                        <label class="form-label small mb-0 mt-2">Max gap % (blank = no cap)</label>
                        <input class="form-control form-control-sm" type="number" step="0.5" @bind="maxGapText" />
                        <label class="form-label small mb-0 mt-2">Min volume ratio (× average)</label>
                        <input class="form-control form-control-sm" type="number" step="0.1" @bind="dial.MinVolumeRatio" />
                        <div class="d-flex gap-2 mt-2">
                            <div>
                                <label class="form-label small mb-0">Min price $</label>
                                <input class="form-control form-control-sm" type="number" step="0.1" @bind="dial.MinPrice" />
                            </div>
                            <div>
                                <label class="form-label small mb-0">Max price $</label>
                                <input class="form-control form-control-sm" type="number" step="1" @bind="dial.MaxPrice" />
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="fw-semibold small mb-2"><i class="bi bi-clock me-1" aria-hidden="true"></i>Windows (ET)</div>
                        <label class="form-label small mb-0">Entry window start</label>
                        <input class="form-control form-control-sm" @bind="dial.EntryWindowStartEt" placeholder="04:00" />
                        <label class="form-label small mb-0 mt-2">Entry window end</label>
                        <input class="form-control form-control-sm" @bind="dial.EntryWindowEndEt" placeholder="09:00" />
                        <label class="form-label small mb-0 mt-2">Arm sell-off watch at</label>
                        <input class="form-control form-control-sm" @bind="dial.ArmExitAtEt" placeholder="09:15" />
                        <label class="form-label small mb-0 mt-2">Hard sell-by (before 9:30 bell)</label>
                        <input class="form-control form-control-sm" @bind="dial.SellByEt" placeholder="09:28" />
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="fw-semibold small mb-2"><i class="bi bi-shield-exclamation me-1" aria-hidden="true"></i>Risk &amp; exit</div>
                        <label class="form-label small mb-0">Stop loss % (below entry)</label>
                        <input class="form-control form-control-sm" type="number" step="0.5" @bind="dial.StopLossPercent" />
                        <label class="form-label small mb-0 mt-2">Trailing stop % (blank = off)</label>
                        <input class="form-control form-control-sm" type="number" step="0.5" @bind="trailingText" />
                        <label class="form-label small mb-0 mt-2">Peak giveback % (of the run)</label>
                        <input class="form-control form-control-sm" type="number" step="5" @bind="dial.PeakGivebackPercent" />
                        <label class="form-label small mb-0 mt-2">Position size $ (notional)</label>
                        <input class="form-control form-control-sm" type="number" step="100" @bind="dial.DefaultNotional" />
                    </div>
                </div>
                <details class="mt-3">
                    <summary class="text-muted small" style="cursor:pointer">Preview generated IdiotScript</summary>
                    <pre class="small mt-2 p-2" style="background:var(--bg-row-alt);border:1px solid var(--border);border-radius:6px;overflow:auto">@ScriptPreview</pre>
                </details>
            </div>
        }

        @if (queueError is not null)
        {
            <div class="alert alert-warning small mt-2 mb-0">@queueError</div>
        }
    </div>

    <!-- ── Backtest a day ─────────────────────────────────────────── -->
    <div class="trading-card p-3 mb-3">
        <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
            <h2 class="h6 mb-0"><i class="bi bi-clock-history me-1" style="color:var(--brand)" aria-hidden="true"></i>Backtest a day</h2>
            <span class="text-muted small">replay the ticker + dials above over a past day — same exit brain the live console runs — then apply the tuned dials</span>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="strategy-chip ticker-chip">@(string.IsNullOrWhiteSpace(symbolInput) ? "TICKER?" : symbolInput.ToUpperInvariant())</span>
            <input class="form-control form-control-sm" style="max-width:170px" type="date"
                   @bind="backtestDate" aria-label="Backtest date" />
            <button class="btn btn-sm btn-primary" type="button"
                    disabled="@(backtestRunning || string.IsNullOrWhiteSpace(symbolInput))"
                    @onclick="RunDayBacktest">
                @if (backtestRunning)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-play-fill me-1" aria-hidden="true"></i>
                }
                Replay day
            </button>
            @if (backtestReport is not null)
            {
                <span class="text-muted small">data: @backtestDataSource</span>
            }
        </div>

        @if (backtestError is not null)
        {
            <div class="alert alert-warning small mt-2 mb-0">@backtestError</div>
        }

        @if (backtestReport is { } r)
        {
            <div class="border-top pt-3 mt-3">
                @if (!r.Entered)
                {
                    <div class="text-muted"><i class="bi bi-slash-circle me-1" aria-hidden="true"></i>No entry that day. @r.NoEntryReason</div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="strategy-chip @(r.PnL >= 0 ? "long-chip" : "filter-chip")">
                            P&amp;L @r.PnL.ToString("+0.00;-0.00") (@r.ReturnPercent.ToString("+0.0;-0.0")%)
                        </span>
                        <span class="text-muted small">
                            BUY @r.Quantity @@ @r.Entry!.Price.ToString("F2") (@EasternTime.Format(r.Entry.Utc, "HH:mm 'ET'"), gap @r.GapAtEntryPercent.ToString("+0.0")%)
                            → SELL @@ @r.Exit!.Price.ToString("F2") (@EasternTime.Format(r.Exit.Utc, "HH:mm 'ET'") · @r.Exit.Reason)
                            · peak @r.PeakPrice.ToString("F2") (@r.MaxFavorablePercent.ToString("+0.0")% @EasternTime.Format(r.PeakUtc, "HH:mm")) · worst @r.MaxAdversePercent.ToString("0.0")%
                        </span>
                    </div>

                    <div class="mt-2">
                        @foreach (var s in r.Suggestions)
                        {
                            <div class="small"><i class="bi bi-lightbulb me-1" style="color:var(--brand)" aria-hidden="true"></i>@s</div>
                        }
                    </div>

                    <details class="mt-2">
                        <summary class="text-muted small" style="cursor:pointer">Giveback grid — what each dial would have done</summary>
                        <table class="table table-sm mt-2 mb-0" style="max-width:480px">
                            <thead><tr class="text-muted small"><th>Giveback %</th><th>Exit</th><th>Reason</th><th>P&amp;L</th></tr></thead>
                            <tbody>
                            @foreach (var g in r.GivebackGrid.OrderBy(g => g.GivebackPercent))
                            {
                                <tr class="small @(g.PnL == r.GivebackGrid.Max(x => x.PnL) ? "fw-semibold" : null)">
                                    <td>@g.GivebackPercent%</td>
                                    <td>@g.ExitPrice.ToString("F2")</td>
                                    <td>@g.ExitReason</td>
                                    <td>@g.PnL.ToString("+0.00;-0.00")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </details>

                    @if (r.TunedProfile is not null)
                    {
                        <button class="btn btn-sm btn-outline-success mt-2" type="button" @onclick="ApplyTunedProfile">
                            <i class="bi bi-sliders me-1" aria-hidden="true"></i>
                            Apply tuned dials (giveback @r.TunedProfile.PeakGivebackPercent%, SL @r.TunedProfile.StopLossPercent%, gap ≥@r.TunedProfile.MinGapPercent%)
                        </button>
                    }
                }
            </div>
        }
    </div>

    <!-- ── Queued gappers ─────────────────────────────────────────── -->
    <h2 class="h6 text-muted">Queued gappers (@ActiveGapperCount/@MaxGappers active)</h2>
    @if (loading)
    {
        <div class="text-muted small"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Loading...</div>
    }
    else if (gappers.Count == 0)
    {
        <div class="trading-card p-4 text-center">
            <i class="bi bi-sunrise fs-1 text-muted d-block mb-2" aria-hidden="true"></i>
            <div class="text-muted">No gappers queued. Pick a ticker, select a profile, dial it in, and queue it.</div>
        </div>
    }
    else
    {
        <ul class="list-unstyled mb-0" role="list">
            @foreach (var s in gappers)
            {
                <li class="trading-card mb-2 p-3" data-strategy-id="@s.Id">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="strategy-chip ticker-chip">@s.Symbol</span>
                        <span class="fw-semibold">@s.Title</span>

                        @* Live state chip: holding / sold / waiting-on-condition *@
                        @if (s.PositionQty > 0)
                        {
                            <span class="strategy-chip long-chip">
                                <i class="bi bi-briefcase-fill" aria-hidden="true"></i>
                                HOLDING @s.PositionQty @@ @(s.LastEntryPrice?.ToString("F2"))
                            </span>
                        }
                        else if (s.LastExitReason is not null && s.LastExitedUtc is { } exited)
                        {
                            <span class="strategy-chip filter-chip"
                                  title="Exited @EasternTime.Format(exited, "HH:mm:ss 'ET'")">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                sold @@ @(s.LastExitPrice?.ToString("F2")) · @s.LastExitReason
                            </span>
                        }
                        else if (s.IsActive && progress.TryGetValue(s.Id, out var p))
                        {
                            <span class="strategy-chip @(p.IsFullPass ? "long-chip" : "filter-chip")"
                                  title="Last evaluated @EasternTime.Format(p.EvaluatedUtc, "HH:mm:ss 'ET'")">
                                <i class="bi @(p.IsFullPass ? "bi-check-circle-fill" : "bi-hourglass-split")" aria-hidden="true"></i>
                                @p.PassedCount/@p.TotalCount
                                @if (!p.IsFullPass && !string.IsNullOrEmpty(p.FirstFailingVerb))
                                {
                                    <span class="text-muted ms-1">· @p.FirstFailingVerb</span>
                                }
                            </span>
                        }
                        else if (s.IsActive)
                        {
                            <span class="strategy-chip text-muted">
                                <i class="bi bi-hourglass" aria-hidden="true"></i> awaiting first evaluation
                            </span>
                        }

                        <div class="ms-auto d-flex gap-2 align-items-center">
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" id="@($"gtoggle-{s.Id}")"
                                       checked="@s.IsActive"
                                       aria-label="@(s.IsActive ? "Pause" : "Activate") @s.Title"
                                       @onchange="(e) => ToggleActive(s, (bool)(e.Value ?? false))" />
                                <label class="form-check-label small text-muted" for="@($"gtoggle-{s.Id}")">
                                    @(s.IsActive ? "Active" : "Paused")
                                </label>
                            </div>
                            <button class="btn btn-sm btn-outline-danger" type="button"
                                    aria-label="Remove @s.Title"
                                    disabled="@(s.PositionQty > 0)"
                                    title="@(s.PositionQty > 0 ? "Holding a position — pause instead; the Monitor manages the exit" : "Remove")"
                                    @onclick="() => RemoveGapper(s)">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(s.Description))
                    {
                        <div class="text-muted small mt-1">@s.Description</div>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    private const int MaxGappers = 3;

    private bool loading = true;
    private string? loadError;
    private string? queueError;
    private Guid? userId;

    private string symbolInput = "";
    private string selectedProfileId = "";
    private bool showDials;
    private GapperProfile dial = new();

    private string transcriptText = "";
    private bool interpreting;
    private string? interpretError;
    private List<string> interpretWarnings = new();
    private List<GapperCandidate> candidates = new();

    private DateTime backtestDate = LastWeekday();
    private bool backtestRunning;
    private string? backtestError;
    private string backtestDataSource = "";
    private GapperDayBacktestReport? backtestReport;
    private List<Strategy> gappers = new();
    private readonly Dictionary<Guid, ConditionProgress> progress = new();
    private System.Threading.Timer? poll;

    // Nullable numeric dial-ins bound through strings so "blank = off" works.
    // Invariant culture both ways: on a comma-decimal server culture the bare
    // TryParse read "2.5" as 25 (dot = thousands separator) — a silently
    // 10×-loosened trailing stop.
    private string maxGapText
    {
        get => dial.MaxGapPercent?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
        set => dial.MaxGapPercent = double.TryParse(value, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : null;
    }
    private string trailingText
    {
        get => dial.TrailingStopPercent?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
        set => dial.TrailingStopPercent = double.TryParse(value, System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : null;
    }

    private GapperProfile CurrentProfile => ProfileService.GetById(selectedProfileId) ?? ProfileService.GetProfiles()[0];

    private int ActiveGapperCount => gappers.Count(s => s.IsActive);

    private bool CanQueue => !string.IsNullOrWhiteSpace(symbolInput) && ActiveGapperCount < MaxGappers;

    private string ScriptPreview
    {
        get
        {
            try
            {
                return GapperScriptFactory.ToScript(
                    string.IsNullOrWhiteSpace(symbolInput) ? "TICK" : symbolInput.Trim(), dial);
            }
            catch (ArgumentException ex) { return ex.Message; }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var profiles = ProfileService.GetProfiles();
        selectedProfileId = profiles[0].Id;
        dial = profiles[0].Clone();

        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var rawId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            userId = Guid.TryParse(rawId, out var uid) ? uid : null;
            if (userId is null) { loadError = "Sign in to queue gappers."; return; }

            await RefreshAsync();
        }
        catch (Exception ex) { loadError = ex.Message; }
        finally { loading = false; }

        // The console re-reads strategies every tick; this page re-reads the
        // console's writes every 5s. SQL is the bus in both directions.
        poll = new System.Threading.Timer(async _ =>
        {
            try { await InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); }); }
            catch { /* circuit may be tearing down */ }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void OnProfileSelected(ChangeEventArgs e)
    {
        selectedProfileId = e.Value?.ToString() ?? selectedProfileId;
        dial = CurrentProfile.Clone(); // reselecting resets the dial-ins to the template
    }

    private async Task RefreshAsync()
    {
        if (userId is null) return;
        var all = await StrategyRepo.GetAllForUserAsync(userId.Value);
        // Gapper rows are recognized by their exit brain — PeakGiveback is the
        // semantic marker only the gapper factory emits.
        gappers = all.Where(s => s.ScriptText.Contains("PeakGiveback(", StringComparison.OrdinalIgnoreCase)).ToList();

        var ids = gappers.Where(s => s.IsActive).Select(s => s.Id).ToList();
        progress.Clear();
        if (ids.Count > 0)
        {
            var rows = await ProgressRepo.GetForStrategyIdsAsync(ids);
            foreach (var (k, v) in rows) progress[k] = v;
        }
    }

    /// <summary>
    /// Re-queries SQL for the caller's true active-gapper count. The in-memory
    /// <see cref="gappers"/> list is only as fresh as the last poll (up to 5s
    /// old) — a second browser tab, or two rapid clicks, could otherwise both
    /// pass the client-side <see cref="ActiveGapperCount"/> check and exceed
    /// the 3-gapper cap. This is the authoritative check right before the
    /// write that actually flips a row active.
    /// </summary>
    private async Task<int> CountActiveGappersFromDbAsync()
    {
        if (userId is null) return 0;
        var all = await StrategyRepo.GetAllForUserAsync(userId.Value);
        return all.Count(s => s.IsActive && s.ScriptText.Contains("PeakGiveback(", StringComparison.OrdinalIgnoreCase));
    }

    private async Task QueueGapper()
    {
        queueError = null;
        if (userId is null || !CanQueue) return;
        await QueueFromProfileAsync(symbolInput.Trim().ToUpperInvariant(), dial, CurrentProfile.Name);
        if (queueError is null) symbolInput = "";
    }

    /// <summary>Shared queue path for the manual form and interpreted candidates.</summary>
    private async Task QueueFromProfileAsync(string symbol, GapperProfile profile, string profileName)
    {
        if (userId is null) return;

        // Duplicate-symbol check against SQL, not the in-memory page list —
        // that list is only as fresh as the last 5s poll, so a second tab
        // could otherwise double-queue the same ticker and double the
        // capital exposure on one gap.
        if (await StrategyRepo.CountActiveForSymbolAsync(userId.Value, symbol) > 0)
        {
            queueError = $"{symbol} already has an active gapper. Pause or remove it first.";
            await RefreshAsync();
            return;
        }

        if (await CountActiveGappersFromDbAsync() >= MaxGappers)
        {
            queueError = "3 gappers already active — pause or remove one first.";
            await RefreshAsync();
            return;
        }

        // Definition-direct (IP-LAW-8): the factory's semantic model becomes
        // the canonical JSON with NO parser in the loop; the script text is
        // generated from the same model purely as the human view.
        string script, canonicalJson;
        try
        {
            var builder = GapperScriptFactory.Compose(symbol, profile);
            script = builder.ToScript();
            canonicalJson = StrategyJson.Serialize(builder.Build());
        }
        catch (ArgumentException ex) { queueError = ex.Message; return; }

        var created = await StrategyRepo.CreateAsync(
            userId.Value,
            title: $"{symbol} Gapper — {profileName}",
            symbol: symbol,
            scriptText: script,
            scriptJson: canonicalJson,
            description: $"Gapper profile '{profileName}': ≥{profile.MinGapPercent}% gap on {profile.MinVolumeRatio}× volume, " +
                         $"entry {profile.EntryWindowStartEt}–{profile.EntryWindowEndEt} ET, stop {profile.StopLossPercent}%, " +
                         $"giveback {profile.PeakGivebackPercent}% armed {profile.ArmExitAtEt}, flat by {profile.SellByEt} ET.");
        await StrategyRepo.SetActiveAsync(created.Id, true, userId.Value);

        // Close the check-then-act race: re-verify AFTER activating. Two tabs
        // racing past the pre-checks both land here; whoever now sees the cap
        // or duplicate rule violated reverts its own activation. (No SQL
        // transaction spans the create+activate, so this recheck is what
        // actually enforces the invariant.)
        if (await CountActiveGappersFromDbAsync() > MaxGappers
            || await StrategyRepo.CountActiveForSymbolAsync(userId.Value, symbol) > 1)
        {
            await StrategyRepo.SetActiveAsync(created.Id, false, userId.Value);
            queueError = $"{symbol} lost the race to another queue action (cap or duplicate) — left paused.";
        }

        await RefreshAsync();
    }

    // ── Transcript interpretation ───────────────────────────────────

    private async Task InterpretTranscript()
    {
        interpretError = null;
        interpretWarnings.Clear();
        interpreting = true;
        try
        {
            var result = await Interpreter.InterpretAsync(transcriptText);
            interpretWarnings = result.Warnings.ToList();
            if (!result.Success)
            {
                interpretError = result.Error;
                return;
            }
            candidates = result.Candidates.ToList();
        }
        catch (Exception ex) { interpretError = ex.Message; }
        finally { interpreting = false; }
    }

    private void ClearCandidates()
    {
        candidates.Clear();
        interpretWarnings.Clear();
        interpretError = null;
    }

    private async Task QueueCandidate(GapperCandidate c)
    {
        queueError = null;
        await QueueFromProfileAsync(c.Symbol, c.Profile, c.Profile.Name);
        if (queueError is null) candidates.RemoveAll(x => x.Symbol == c.Symbol);
        else interpretError = queueError;
    }

    /// <summary>Copies a candidate into the manual form for hand-tweaking before queueing.</summary>
    private void LoadCandidateIntoDials(GapperCandidate c)
    {
        symbolInput = c.Symbol;
        dial = c.Profile.Clone();
        showDials = true;
    }

    private static string CandidateScript(GapperCandidate c)
    {
        try { return GapperScriptFactory.ToScript(c.Symbol, c.Profile); }
        catch (ArgumentException ex) { return ex.Message; }
    }

    // ── Day backtest (design on a past day → examine → re-dial) ──────

    // ET calendar, not server-local: on a UTC host DateTime.Today rolls to
    // "tomorrow" at 8 PM ET, which made the default replay day the still-in-
    // progress (or not-yet-started) session.
    private static DateTime LastWeekday() =>
        MarketTime.PreviousEquityTradingDayEt(DateTime.UtcNow).ToDateTime(TimeOnly.MinValue);

    private async Task RunDayBacktest()
    {
        backtestError = null;
        backtestReport = null;
        if (string.IsNullOrWhiteSpace(symbolInput)) return;

        var symbol = symbolInput.Trim().ToUpperInvariant();
        var problems = dial.Validate();
        if (problems.Count > 0) { backtestError = string.Join(" ", problems); return; }

        backtestRunning = true;
        try
        {
            // Key priority mirrors /backtest: the signed-in user's OWN Alpaca
            // keys first, then the host's global settings chain, then Mock.
            // (This page previously read only the global chain, so a user with
            // keys configured on API Keys got synthetic Mock data here while
            // /backtest gave them real bars.)
            var userApiKeys = userId is null ? null : await UserKeys.GetOrCreateAsync(userId.Value);
            // Take the user's PAIR only when both halves exist — mixing a
            // user key id with the global secret would be a broken credential.
            var useUserKeys = !string.IsNullOrWhiteSpace(userApiKeys?.AlpacaApiKeyId)
                           && !string.IsNullOrWhiteSpace(userApiKeys?.AlpacaApiSecretKey);
            var keyId  = useUserKeys ? userApiKeys!.AlpacaApiKeyId!     : AppSettings.AlpacaApiKeyId;
            var secret = useUserKeys ? userApiKeys!.AlpacaApiSecretKey! : AppSettings.AlpacaApiSecretKey;
            var hasKeys = !string.IsNullOrWhiteSpace(keyId) && !string.IsNullOrWhiteSpace(secret);
            IMarketDataFeed feed = hasKeys
                ? new AlpacaDataFeed(keyId, secret, "iex")
                : new MockDataFeed();
            backtestDataSource = hasKeys ? "Alpaca" : "Mock";

            var day = DateOnly.FromDateTime(backtestDate);
            var eastern = MarketTime.Eastern;
            var startUtc = TimeZoneInfo.ConvertTimeToUtc(
                DateTime.SpecifyKind(day.ToDateTime(new TimeOnly(4, 0)), DateTimeKind.Unspecified), eastern);
            var endUtc = TimeZoneInfo.ConvertTimeToUtc(
                DateTime.SpecifyKind(day.ToDateTime(new TimeOnly(16, 0)), DateTimeKind.Unspecified), eastern);

            var candles = new List<IdiotProof.Models.Candle>();
            await using var disposable = feed as IAsyncDisposable;
            await foreach (var c in feed.GetHistoricalCandlesAsync(symbol, startUtc, endUtc, TimeSpan.FromMinutes(1)))
                candles.Add(c);

            // Previous close relative to that day's premarket, not "now".
            var previousClose = await feed.GetPreviousCloseAsync(symbol, startUtc.AddHours(2));

            backtestReport = GapperDayBacktester.Run(symbol, dial, candles, previousClose, day);
        }
        catch (Exception ex)
        {
            backtestError = $"Replay failed: {ex.Message}";
        }
        finally { backtestRunning = false; }
    }

    /// <summary>The re-dial half of the loop: hindsight profile → the manual dials, ready to queue for a real day.</summary>
    private void ApplyTunedProfile()
    {
        if (backtestReport?.TunedProfile is not { } tuned) return;
        dial = tuned.Clone();
        showDials = true;
    }

    private async Task ToggleActive(Strategy s, bool isActive)
    {
        if (userId is null) return;

        if (isActive && !s.IsActive)
        {
            if (await CountActiveGappersFromDbAsync() >= MaxGappers)
            {
                queueError = "3 gappers already active — pause one first.";
                await RefreshAsync();
                return;
            }
            // Re-activation must obey the same one-active-gapper-per-symbol
            // rule as queueing — pause A, queue B for the same ticker, then
            // re-toggling A used to double the exposure on one gap.
            if (await StrategyRepo.CountActiveForSymbolAsync(userId.Value, s.Symbol) > 0)
            {
                queueError = $"{s.Symbol} already has an active gapper — pause it before re-activating this one.";
                await RefreshAsync();
                return;
            }
        }

        var result = await StrategyRepo.SetActiveAsync(s.Id, isActive, userId.Value);
        if (result == StrategyMutation.PositionOpen)
        {
            queueError = $"{s.Symbol} is holding {s.PositionQty} shares — the Monitor must stay active to manage the exit.";
            await RefreshAsync();
            return;
        }
        if (result != StrategyMutation.Ok) return;
        s.IsActive = isActive;

        // Same post-write recheck as queueing — two tabs re-activating
        // different rows for the same symbol both pass the pre-check.
        if (isActive
            && (await CountActiveGappersFromDbAsync() > MaxGappers
                || await StrategyRepo.CountActiveForSymbolAsync(userId.Value, s.Symbol) > 1))
        {
            await StrategyRepo.SetActiveAsync(s.Id, false, userId.Value);
            s.IsActive = false;
            queueError = $"{s.Symbol} lost the race to another activation (cap or duplicate) — left paused.";
            await RefreshAsync();
        }
    }

    private async Task RemoveGapper(Strategy s)
    {
        if (userId is null) return;
        if (s.PositionQty > 0) return; // Monitor owns the open position (repo re-checks too)
        await StrategyRepo.DeleteAsync(s.Id, userId.Value);
        gappers.RemoveAll(x => x.Id == s.Id);
    }

    public void Dispose()
    {
        poll?.Dispose();
        poll = null;
    }
}
