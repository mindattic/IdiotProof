@page "/login"
@attribute [AllowAnonymous]
@inject NavigationManager Nav
@inject IdiotProof.Blazor.Services.DevCredentials DevCreds
@layout EmptyLayout

<PageTitle>Sign In — IdiotProof</PageTitle>

<main class="login-wrapper" id="main-content">
    <section class="login-card" aria-labelledby="login-heading">
        <div class="login-logo">
            <span class="logo-icon" aria-hidden="true">⚡</span>
            <h1 id="login-heading">IdiotProof</h1>
            <p class="logo-sub">Trading Strategy Platform</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-error" role="alert" aria-live="assertive">@errorMessage</div>
        }
        @if (Registered == "1")
        {
            <div class="alert-setup" role="status" aria-live="polite">Account created — sign in to continue.</div>
        }

        <form method="post" action="/_ma-auth/login" aria-label="Sign in to IdiotProof">
            @* Local paths only — forwarding a raw ?returnUrl would let a
               crafted link bounce a successful login to an attacker's site
               (open redirect / phishing), regardless of what the auth
               library does with it downstream. *@
            <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />
            <AntiforgeryToken />

            <div class="form-group">
                <label for="login-email">Email</label>
                <input id="login-email"
                       type="email"
                       name="userName"
                       class="form-control"
                       autocomplete="email"
                       required
                       aria-required="true"
                       value="@(DevCreds.Username ?? "")"
                       placeholder="you@example.com" />
            </div>
            <div class="form-group">
                <label for="login-password">Password</label>
                <input id="login-password"
                       type="password"
                       name="password"
                       class="form-control"
                       autocomplete="current-password"
                       required
                       aria-required="true"
                       value="@(DevCreds.Password ?? "")"
                       placeholder="Your password" />
            </div>
            @if (!string.IsNullOrEmpty(DevCreds.Username))
            {
                <div class="alert-dev" role="note">
                    Dev autofill from <code>.env</code> — production builds render empty.
                </div>
            }

            <button type="submit" class="btn-login">Sign In</button>
        </form>

        <div class="login-links">
            <a href="/forgot-password">Forgot password?</a>
            <span class="sep">&middot;</span>
            <a href="/forgot-username">Forgot username?</a>
            <span class="sep">&middot;</span>
            <a href="/register">Create account</a>
        </div>
        <p class="login-notice" role="note">
            This application can place real orders with real brokers.<br>Keep your credentials secure.
        </p>
    </section>
</main>

@code {
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? Registered { get; set; }

    /// <summary>Only a same-site path survives; anything absolute, protocol-relative ("//evil"), or empty falls back to "/".</summary>
    private string SafeReturnUrl =>
        ReturnUrl is { Length: > 0 } r && r.StartsWith('/') && !r.StartsWith("//") && !r.Contains('\\')
            ? r : "/";

    private string errorMessage = "";

    protected override void OnInitialized()
    {
        if (Error == "1") errorMessage = "Incorrect username or password.";
    }
}

<style>
/* Login page always renders dark — independent of the app theme */
.login-wrapper {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-y: auto;
    padding: 1rem;
    background: #0d1117;
    background-image: radial-gradient(ellipse at 60% 20%, rgba(210,153,34,0.06) 0%, transparent 60%),
                      radial-gradient(ellipse at 20% 80%, rgba(88,166,255,0.04) 0%, transparent 50%);
}

.login-card {
    width: 100%;
    max-width: 400px;
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 14px;
    padding: 2.75rem 2.5rem 2rem;
    box-shadow: 0 8px 40px rgba(0,0,0,0.55), 0 1px 0 rgba(255,255,255,0.04) inset;
}

.login-logo {
    text-align: center;
    margin-bottom: 2.25rem;
}

.logo-icon {
    font-size: 2.75rem;
    line-height: 1;
    display: block;
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 0 12px rgba(210,153,34,0.5));
}
.login-logo h1 {
    font-size: 1.9rem;
    font-weight: 700;
    color: #e6edf3;
    margin: 0 0 0.3rem;
    letter-spacing: -0.02em;
}
.logo-sub { color: #6e7681; font-size: 0.82rem; letter-spacing: 0.04em; text-transform: uppercase; }

.alert-setup {
    background: rgba(56,139,253,0.12);
    border: 1px solid rgba(56,139,253,0.35);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    color: #79c0ff;
    margin-bottom: 1.25rem;
}
.alert-error {
    background: rgba(248,81,73,0.12);
    border: 1px solid rgba(248,81,73,0.35);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    color: #f85149;
    margin-bottom: 1.25rem;
}
.alert-dev {
    background: rgba(210,153,34,0.08);
    border: 1px solid rgba(210,153,34,0.25);
    border-radius: 6px;
    padding: 0.45rem 0.85rem;
    font-size: 0.74rem;
    color: #9e7317;
    margin-bottom: 1rem;
}
.alert-dev code { background: transparent; color: inherit; }

.form-group { margin-bottom: 1.1rem; }
.form-group label {
    display: block;
    color: #8b949e;
    font-size: 0.8rem;
    font-weight: 500;
    margin-bottom: 0.35rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
}
.form-control {
    width: 100%;
    padding: 0.65rem 0.9rem;
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    color: #e6edf3;
    font-size: 0.95rem;
    box-sizing: border-box;
    transition: border-color 0.15s, box-shadow 0.15s;
}
.form-control:focus {
    outline: none;
    border-color: #d29922;
    box-shadow: 0 0 0 3px rgba(210,153,34,0.18);
}

.btn-login {
    width: 100%;
    padding: 0.72rem;
    background: #d29922;
    color: #0d1117;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    letter-spacing: 0.02em;
    transition: background 0.15s, transform 0.1s;
    margin-top: 0.5rem;
}
.btn-login:hover  { background: #e0a820; }
.btn-login:active { transform: scale(0.98); }

.login-links {
    margin-top: 1.75rem;
    text-align: center;
}
.login-links a { color: #58a6ff; font-size: 0.82rem; text-decoration: none; }
.login-links a:hover { text-decoration: underline; }
.login-links .sep { color: #30363d; margin: 0 0.5rem; }

.login-notice {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #21262d;
    font-size: 0.74rem;
    color: #484f58;
    text-align: center;
    line-height: 1.5;
}
</style>
