@page "/dashboard"
@rendermode InteractiveServer
@using IdiotProof.Blazor.Data
@using IdiotProof.Blazor.Services
@using IdiotProof.Scripting
@using IdiotProof.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject StrategyRepository StrategyRepo
@inject ConditionProgressRepository ProgressRepo
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Dashboard — IdiotProof</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-3">
    <span class="text-muted small">
        <i class="bi bi-broadcast me-1" style="color:var(--green)" aria-hidden="true"></i>
        Live &middot; Alpaca SIP &middot; 3s refresh
    </span>
    <div class="dropdown">
        <button class="btn btn-sm btn-outline-secondary" type="button"
                data-bs-toggle="dropdown" aria-expanded="false" aria-label="Choose visible columns">
            <i class="bi bi-layout-three-columns me-1" aria-hidden="true"></i>Columns
        </button>
        <ul class="dropdown-menu dropdown-menu-end" style="min-width:160px">
            @foreach (var col in AllCols)
            {
                <li>
                    <label class="dropdown-item d-flex align-items-center gap-2" style="cursor:pointer;user-select:none">
                        <input type="checkbox" checked="@visibleCols.Contains(col.Key)"
                               @onchange="async () => await ToggleColumnAsync(col.Key)" />
                        @col.Label
                    </label>
                </li>
            }
        </ul>
    </div>
</div>

@if (rows is null)
{
    <p class="text-muted">Loading…</p>
}
else if (rows.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-reception-0 d-block mb-2" style="font-size:2.5rem" aria-hidden="true"></i>
        No active strategies — activate one on the Strategies tab to see it here.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0" style="font-size:0.9rem">
            <thead>
                <tr>
                    <th style="white-space:nowrap">Symbol</th>
                    @if (visibleCols.Contains("price")) { <th class="text-end" style="white-space:nowrap">Price</th> }
                    @if (visibleCols.Contains("state")) { <th style="white-space:nowrap">State</th> }
                    @if (visibleCols.Contains("pnl"))   { <th class="text-end" style="white-space:nowrap">P&amp;L %</th> }
                    @if (visibleCols.Contains("sl"))    { <th class="text-end" style="white-space:nowrap">SL</th> }
                    @if (visibleCols.Contains("tp"))    { <th class="text-end" style="white-space:nowrap">TP</th> }
                    @if (visibleCols.Contains("cond"))  { <th class="text-center" style="white-space:nowrap">Conditions</th> }
                    @if (visibleCols.Contains("age"))   { <th style="white-space:nowrap">Updated</th> }
                    <th>Title</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in rows)
                {
                    <tr @key="r.Strategy.Id">
                        <td><span class="badge symbol-chip">@r.Strategy.Symbol</span></td>
                        @if (visibleCols.Contains("price"))
                        {
                            <td class="text-end" style="font-family:var(--font-mono);font-weight:600">
                                @(r.LastPrice.HasValue ? $"${r.LastPrice.Value:0.00}" : "—")
                            </td>
                        }
                        @if (visibleCols.Contains("state"))
                        {
                            <td><span class="@StateClass(r.State) text-nowrap">@r.State</span></td>
                        }
                        @if (visibleCols.Contains("pnl"))
                        {
                            <td class="text-end @PnlClass(r.PnlPct)" style="font-family:var(--font-mono)">@r.PnlPct</td>
                        }
                        @if (visibleCols.Contains("sl"))
                        {
                            <td class="text-end text-muted" style="font-family:var(--font-mono)">@r.SlStr</td>
                        }
                        @if (visibleCols.Contains("tp"))
                        {
                            <td class="text-end text-muted" style="font-family:var(--font-mono)">@r.TpStr</td>
                        }
                        @if (visibleCols.Contains("cond"))
                        {
                            <td class="text-center">
                                <span class="@CondBadgeClass(r)">@r.PassedCount/@r.TotalCount</span>
                            </td>
                        }
                        @if (visibleCols.Contains("age"))
                        {
                            <td class="text-muted" style="font-size:0.8rem">@AgeStr(r.LastPriceUtc)</td>
                        }
                        <td class="text-muted" style="max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                            title="@r.Strategy.Title">@r.Strategy.Title</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private sealed record ColDef(string Key, string Label);
    private static readonly ColDef[] AllCols =
    [
        new("price", "Price"),
        new("state", "State"),
        new("pnl",   "P&L %"),
        new("sl",    "SL"),
        new("tp",    "TP"),
        new("cond",  "Conditions"),
        new("age",   "Last Update"),
    ];
    private static readonly HashSet<string> DefaultCols = ["price", "state", "pnl", "sl", "tp", "cond"];
    private const string ColsKey = "idiotproof.dashboard.cols";

    private sealed record DashboardRow(
        Strategy Strategy,
        string State,
        string PnlPct,
        string SlStr,
        string TpStr,
        decimal? LastPrice,
        DateTime? LastPriceUtc,
        int PassedCount,
        int TotalCount);

    private List<DashboardRow>? rows;
    private HashSet<string> visibleCols = new(DefaultCols);
    private Timer? poll;
    private bool colsLoaded;
    private Guid userId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var claim = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        userId = claim is not null && Guid.TryParse(claim, out var g) ? g : Guid.Empty;

        await RefreshAsync();
        poll = new Timer(async _ =>
        {
            try { await InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); }); }
            catch { /* circuit tearing down */ }
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || colsLoaded) return;
        colsLoaded = true;
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ColsKey);
            if (!string.IsNullOrWhiteSpace(saved))
            {
                visibleCols = saved.Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task RefreshAsync()
    {
        if (userId == Guid.Empty) return;
        var all = await StrategyRepo.GetAllForUserAsync(userId);
        var active = all.Where(s => s.IsActive).ToList();
        if (active.Count == 0) { rows = []; return; }
        var progress = await ProgressRepo.GetForStrategyIdsAsync(active.Select(s => s.Id));
        rows = active
            .OrderBy(s => s.Symbol, StringComparer.OrdinalIgnoreCase)
            .ThenBy(s => s.Title,   StringComparer.OrdinalIgnoreCase)
            .Select(s => BuildRow(s, progress.GetValueOrDefault(s.Id)))
            .ToList();
    }

    private static DashboardRow BuildRow(Strategy s, ConditionProgress? cp)
    {
        var loaded = StrategyLoader.Load(s.ScriptJson, s.ScriptText);
        var def = loaded.Definition;

        string state = loaded.CanonicalError is not null ? "QUARANTINE"
            : def is null ? "UNPARSED"
            : s.PositionQty > 0
                ? (def.Direction == TradeDirection.Short ? $"SHORT ×{s.PositionQty}" : $"LONG ×{s.PositionQty}")
            : "armed";

        var lastPrice = cp?.LastPrice;
        string pnlPct = "—";
        if (s.PositionQty > 0 && s.LastEntryPrice is { } entry && entry != 0 && lastPrice.HasValue)
        {
            var pct = (lastPrice.Value - entry) / entry * 100m;
            pnlPct = pct >= 0 ? $"+{pct:0.00}%" : $"{pct:0.00}%";
        }

        string slStr = "—";
        string tpStr = "—";
        if (def is not null)
        {
            var refPrice = s.LastEntryPrice;
            bool isShort = def.Direction == TradeDirection.Short;

            if (def.StopLossPrice.HasValue)
                slStr = $"${def.StopLossPrice.Value:0.00}";
            else if (def.StopLossPercent.HasValue && refPrice.HasValue && refPrice.Value != 0)
                slStr = $"${(double)refPrice.Value * (isShort ? 1 + def.StopLossPercent.Value / 100 : 1 - def.StopLossPercent.Value / 100):0.00}";
            else if (def.StopLossPercent.HasValue)
                slStr = isShort ? $"+{def.StopLossPercent.Value:0.0}%" : $"-{def.StopLossPercent.Value:0.0}%";

            var tpPrice = def.TakeProfitTargets?.Count > 0 ? (double?)def.TakeProfitTargets[0].Price : def.TakeProfitPrice;
            if (tpPrice.HasValue)
                tpStr = $"${tpPrice.Value:0.00}";
            else if (def.TakeProfitPercent.HasValue && refPrice.HasValue && refPrice.Value != 0)
                tpStr = $"${(double)refPrice.Value * (isShort ? 1 - def.TakeProfitPercent.Value / 100 : 1 + def.TakeProfitPercent.Value / 100):0.00}";
            else if (def.TakeProfitPercent.HasValue)
                tpStr = isShort ? $"-{def.TakeProfitPercent.Value:0.0}%" : $"+{def.TakeProfitPercent.Value:0.0}%";
        }

        return new DashboardRow(s, state, pnlPct, slStr, tpStr,
            lastPrice, cp?.LastPriceUtc, cp?.PassedCount ?? 0, cp?.TotalCount ?? 0);
    }

    private async Task ToggleColumnAsync(string key)
    {
        if (!visibleCols.Remove(key)) visibleCols.Add(key);
        try { await JS.InvokeVoidAsync("localStorage.setItem", ColsKey, string.Join(",", visibleCols)); }
        catch { }
    }

    private static string StateClass(string state) => state switch
    {
        "QUARANTINE"             => "badge bg-danger",
        "UNPARSED"               => "badge bg-warning text-dark",
        "armed"                  => "badge bg-secondary",
        _ when state.StartsWith("LONG")  => "badge bg-success",
        _ when state.StartsWith("SHORT") => "badge bg-primary",
        _                                => "badge bg-secondary",
    };

    private static string PnlClass(string p) =>
        p.StartsWith('+') ? "text-success fw-semibold" : p.StartsWith('-') ? "text-danger fw-semibold" : "";

    private static string CondBadgeClass(DashboardRow r) =>
        r.TotalCount > 0 && r.PassedCount == r.TotalCount ? "badge bg-success" : "badge bg-secondary";

    private static string AgeStr(DateTime? utc)
    {
        if (utc is null) return "—";
        var age = DateTime.UtcNow - utc.Value;
        if (age.TotalSeconds < 90) return $"{(int)age.TotalSeconds}s ago";
        if (age.TotalMinutes < 60) return $"{(int)age.TotalMinutes}m ago";
        return $"{(int)age.TotalHours}h ago";
    }

    public void Dispose() => poll?.Dispose();
}
