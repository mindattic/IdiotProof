@page "/"
@rendermode InteractiveServer
@inject TradingStateService TradingState
@inject WorkspaceManager WorkspaceManager
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Dashboard — IdiotProof</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 mb-0 text-white">
        <i class="bi bi-speedometer2 me-2" style="color:var(--green)" aria-hidden="true"></i>Dashboard
    </h1>
    <span class="text-muted small" aria-live="off">Auto-refreshes every 5s</span>
</div>

<!-- Stat Cards -->
<section class="row g-3 mb-4" aria-label="Account summary statistics">
    <div class="col-6 col-lg-3">
        <div class="trading-card p-3 text-center" role="group" aria-labelledby="stat-workspaces-label">
            <div id="stat-workspaces-label" class="text-muted small mb-1">Total Workspaces</div>
            <div class="fs-2 fw-bold text-white" aria-live="polite">@userTabs.Count</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="trading-card p-3 text-center" role="group" aria-labelledby="stat-strategies-label">
            <div id="stat-strategies-label" class="text-muted small mb-1">Active Strategies</div>
            <div class="fs-2 fw-bold text-white" aria-live="polite">@activeStrategies</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="trading-card p-3 text-center" role="group" aria-labelledby="stat-positions-label">
            <div id="stat-positions-label" class="text-muted small mb-1">Open Positions</div>
            <div class="fs-2 fw-bold text-white" aria-live="polite">@openPositions</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="trading-card p-3 text-center" role="group" aria-labelledby="stat-pnl-label">
            <div id="stat-pnl-label" class="text-muted small mb-1">Today's P&amp;L</div>
            <div class="fs-2 fw-bold @(todaysPnl >= 0 ? "text-green" : "text-red")"
                 aria-live="polite"
                 aria-label="Today's profit and loss: @todaysPnl.ToString("+$0.00;-$0.00;$0.00")">
                <span aria-hidden="true">@todaysPnl.ToString("+$0.00;-$0.00;$0.00")</span>
            </div>
        </div>
    </div>
</section>

<div class="row g-3">
    <!-- Recent Signals -->
    <div class="col-lg-8">
        <section class="trading-card p-3" aria-labelledby="recent-signals-heading">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 id="recent-signals-heading" class="h6 mb-0 text-white">
                    <i class="bi bi-lightning-charge me-1" style="color:var(--yellow)" aria-hidden="true"></i>
                    Recent Signals
                    <span class="badge bg-secondary ms-2" aria-label="@recentSignals.Count signals">@recentSignals.Count</span>
                </h2>
                <a href="/signals" class="btn btn-sm btn-outline-secondary" aria-label="View all signals">View All</a>
            </div>
            @if (recentSignals.Count == 0)
            {
                <div class="text-muted text-center py-4" role="status">
                    <i class="bi bi-inbox fs-2 d-block mb-2" aria-hidden="true"></i>No signals yet — start a workspace to begin scanning
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-dark table-hover mb-0" aria-label="Recent trading signals">
                        <caption class="visually-hidden">Most recent trading signals across all workspaces</caption>
                        <thead>
                            <tr class="text-muted small">
                                <th scope="col">Symbol</th>
                                <th scope="col">Direction</th>
                                <th scope="col">Confidence</th>
                                <th scope="col">Strategy</th>
                                <th scope="col">Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var signal in recentSignals.Take(20))
                            {
                                <tr>
                                    <th scope="row" class="fw-bold text-white">@signal.Symbol</th>
                                    <td>
                                        @if (signal.Direction == TradeDirection.Long)
                                        {
                                            <span class="signal-long" aria-label="Long position">
                                                <i class="bi bi-triangle-fill me-1" style="font-size:0.6rem" aria-hidden="true"></i>Long
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="signal-short" aria-label="Short position">
                                                <i class="bi bi-triangle-fill me-1" style="font-size:0.6rem;transform:rotate(180deg);display:inline-block" aria-hidden="true"></i>Short
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="confidence-bar-wrapper"
                                             role="progressbar"
                                             aria-valuenow="@((int)signal.ConfidencePercent)"
                                             aria-valuemin="0"
                                             aria-valuemax="100"
                                             aria-label="Signal confidence: @signal.ConfidencePercent.ToString("0") percent">
                                            <div class="confidence-bar" style="width:@(signal.ConfidencePercent)%"></div>
                                            <span class="confidence-label" aria-hidden="true">@signal.ConfidencePercent.ToString("0")%</span>
                                        </div>
                                    </td>
                                    <td class="text-muted small">@signal.StrategyName</td>
                                    <td class="text-muted small">
                                        <time datetime="@signal.GeneratedUtc.ToString("o")">@signal.GeneratedUtc.ToString("HH:mm:ss")</time>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <!-- Active Workspaces -->
    <aside class="col-lg-4">
        <section class="trading-card p-3 mb-3" aria-labelledby="ws-summary-heading">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 id="ws-summary-heading" class="h6 mb-0 text-white">
                    <i class="bi bi-layers me-1" style="color:var(--blue)" aria-hidden="true"></i>Workspaces
                </h2>
                <a href="/workspaces" class="btn btn-sm btn-outline-secondary" aria-label="Manage workspaces">Manage</a>
            </div>
            <ul class="list-unstyled mb-0">
            @foreach (var tab in userTabs)
            {
                <li class="d-flex justify-content-between align-items-center py-2 border-bottom border-dark">
                    <div>
                        <div class="text-white small fw-semibold">@tab.Name</div>
                        <div class="text-muted" style="font-size:0.7rem">
                            @tab.Watchlist.Count tickers &bull; @tab.Strategies.Count(s => s.Enabled) strategies
                        </div>
                    </div>
                    <a href="/workspace/@tab.TabId" class="btn btn-sm btn-outline-secondary py-0" aria-label="Open workspace @tab.Name">Open</a>
                </li>
            }
            @if (!userTabs.Any())
            {
                <li class="text-muted text-center py-3 small">No workspaces yet</li>
            }
            </ul>
        </section>

        <!-- Quick Add Watchlist -->
        <section class="trading-card p-3" aria-labelledby="quick-add-heading">
            <h2 id="quick-add-heading" class="h6 mb-3 text-white">
                <i class="bi bi-plus-circle me-1" style="color:var(--green)" aria-hidden="true"></i>Quick Add to Watchlist
            </h2>
            @if (userTabs.Any())
            {
                <div class="mb-2">
                    <label class="visually-hidden" for="quick-add-workspace">Workspace</label>
                    <select id="quick-add-workspace"
                            class="form-select form-select-sm bg-dark text-white border-secondary"
                            @bind="quickAddWorkspaceId">
                        @foreach (var tab in userTabs)
                        {
                            <option value="@tab.TabId">@tab.Name</option>
                        }
                    </select>
                </div>
                <div class="input-group input-group-sm">
                    <label class="visually-hidden" for="quick-add-symbol">Ticker symbol</label>
                    <input id="quick-add-symbol"
                           class="form-control bg-dark text-white border-secondary"
                           placeholder="Ticker (e.g. AAPL)"
                           @bind="quickAddSymbol"
                           @onkeydown="OnQuickAddKeyDown" />
                    <button class="btn btn-outline-success" type="button" @onclick="QuickAddTicker" aria-label="Add ticker to watchlist">Add</button>
                </div>
                <div role="status" aria-live="polite" aria-atomic="true">
                @if (!string.IsNullOrEmpty(quickAddMessage))
                {
                    <div class="text-muted small mt-1">@quickAddMessage</div>
                }
                </div>
            }
            else
            {
                <div class="text-muted small">
                    <a href="/workspaces" class="text-info">Create a workspace</a> first
                </div>
            }
        </section>
    </aside>
</div>

@code {
    private string userId = "";
    private IReadOnlyList<WorkspaceTab> userTabs = [];
    private List<TradeSignal> recentSignals = [];
    private int activeStrategies;
    private int openPositions;
    private decimal todaysPnl;
    private string quickAddSymbol = "";
    private string quickAddWorkspaceId = "";
    private string quickAddMessage = "";
    private System.Threading.Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        RefreshData();
        if (userTabs.Any())
            quickAddWorkspaceId = userTabs[0].TabId;

        refreshTimer = new System.Threading.Timer(_ =>
        {
            RefreshData();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void RefreshData()
    {
        userTabs = WorkspaceManager.GetTabsForUser(userId);
        recentSignals = TradingState.GetRecentSignalsForUser(userId).Take(20).ToList();
        activeStrategies = userTabs.Sum(t => t.Strategies.Count(s => s.Enabled));
        var userPositions = TradingState.GetPositionsForUser(userId);
        openPositions = userPositions.Values.Sum(p => p.Count);
        todaysPnl = TradingState.GetTodaysPnlForUser(userId);
    }

    private void OnQuickAddKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") QuickAddTicker();
    }

    private void QuickAddTicker()
    {
        var symbol = quickAddSymbol.Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(symbol)) return;
        if (string.IsNullOrEmpty(quickAddWorkspaceId)) return;

        var tab = WorkspaceManager.Get(userId, quickAddWorkspaceId);
        if (tab == null) return;

        if (!tab.Watchlist.Contains(symbol))
        {
            tab.Watchlist.Add(symbol);
            WorkspaceManager.Save(userId, tab);
            quickAddMessage = $"{symbol} added to {tab.Name}";
        }
        else
        {
            quickAddMessage = $"{symbol} is already in {tab.Name}";
        }
        quickAddSymbol = "";
    }

    public void Dispose() => refreshTimer?.Dispose();
}
