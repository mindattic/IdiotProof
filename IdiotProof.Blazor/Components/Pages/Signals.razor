@page "/signals"
@rendermode InteractiveServer
@inject TradingStateService TradingState
@inject UserKeyService UserKeyService
@inject AuditLogger AuditLogger
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Signals — IdiotProof</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 mb-0 text-white">
        <i class="bi bi-lightning-charge me-2" style="color:var(--yellow)" aria-hidden="true"></i>
        Signal Feed
        <span class="badge bg-secondary ms-2"
              aria-live="polite"
              aria-label="@filteredSignals.Count signals matching filters">@filteredSignals.Count</span>
    </h1>
    <button class="btn btn-sm btn-outline-secondary"
            type="button"
            @onclick="ExportCsv"
            aria-label="Export filtered signals as CSV">
        <i class="bi bi-download me-1" aria-hidden="true"></i>Export CSV
    </button>
</div>

<!-- Filter Bar -->
<section class="trading-card p-3 mb-3" aria-labelledby="filters-heading">
    <h2 id="filters-heading" class="visually-hidden">Filters</h2>
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label text-muted small" for="filter-symbol">Symbol</label>
            <input id="filter-symbol"
                   class="form-control form-control-sm bg-dark text-white border-secondary"
                   placeholder="Filter by symbol..."
                   @bind="filterSymbol"
                   @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <label class="form-label text-muted small" for="filter-strategy">Strategy</label>
            <input id="filter-strategy"
                   class="form-control form-control-sm bg-dark text-white border-secondary"
                   placeholder="Filter by strategy..."
                   @bind="filterStrategy"
                   @bind:event="oninput" />
        </div>
        <div class="col-md-2">
            <label class="form-label text-muted small" for="filter-direction">Direction</label>
            <select id="filter-direction"
                    class="form-select form-select-sm bg-dark text-white border-secondary"
                    @bind="filterDirection">
                <option value="">All</option>
                <option value="Long">Long</option>
                <option value="Short">Short</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label text-muted small" for="filter-min-confidence">
                Min Confidence: <strong>@minConfidence%</strong>
            </label>
            <input id="filter-min-confidence"
                   type="range" class="form-range" min="0" max="100" step="5"
                   aria-valuenow="@minConfidence"
                   aria-valuemin="0"
                   aria-valuemax="100"
                   aria-valuetext="@minConfidence percent"
                   @bind="minConfidence"
                   @bind:event="oninput" />
        </div>
        <div class="col-md-1">
            <button class="btn btn-sm btn-outline-secondary w-100"
                    type="button"
                    aria-label="Clear all filters"
                    @onclick="ClearFilters">Clear</button>
        </div>
    </div>
</section>

<div role="status" aria-live="polite" aria-atomic="true">
@if (!string.IsNullOrEmpty(executionFeedback))
{
    <div class="alert alert-info small py-2 mb-3">@executionFeedback</div>
}
</div>

<!-- Signal List -->
@if (!filteredSignals.Any())
{
    <div class="text-center py-5 text-muted" role="status">
        <i class="bi bi-inbox fs-1 d-block mb-3" aria-hidden="true"></i>
        No signals match your filters.
    </div>
}
else
{
    <ul class="d-flex flex-column gap-2 list-unstyled mb-0"
        aria-label="Filtered trading signals">
        @foreach (var signal in filteredSignals)
        {
            TradingState.SignalVotes.TryGetValue(
                $"{signal.Symbol}_{signal.StrategyName}_{signal.GeneratedUtc:yyyyMMddHHmmss}",
                out var vote);
            <li>
                <SignalCard Signal="@signal"
                            VotingResult="@vote"
                            OnExecute="@(EventCallback.Factory.Create<TradeSignal>(this, OnExecuteSignal))" />
            </li>
        }
    </ul>
}

@code {
    private string userId = "";
    private string filterSymbol = "";
    private string filterStrategy = "";
    private string filterDirection = "";
    private int minConfidence = 0;
    private List<TradeSignal> filteredSignals = [];
    private string? executionFeedback;
    private System.Threading.Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        ApplyFilters();
        refreshTimer = new System.Threading.Timer(_ =>
        {
            ApplyFilters();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private void ApplyFilters()
    {
        var signals = TradingState.GetRecentSignalsForUser(userId).AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filterSymbol))
            signals = signals.Where(s => s.Symbol.Contains(filterSymbol.Trim(), StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(filterStrategy))
            signals = signals.Where(s => s.StrategyName.Contains(filterStrategy.Trim(), StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(filterDirection) && Enum.TryParse<TradeDirection>(filterDirection, out var dir))
            signals = signals.Where(s => s.Direction == dir);

        if (minConfidence > 0)
            signals = signals.Where(s => s.ConfidencePercent >= minConfidence);

        filteredSignals = signals.ToList();
    }

    private void ClearFilters()
    {
        filterSymbol = "";
        filterStrategy = "";
        filterDirection = "";
        minConfidence = 0;
        ApplyFilters();
    }

    private async Task OnExecuteSignal(TradeSignal signal)
    {
        executionFeedback = null;
        try
        {
            var keys = await UserKeyService.GetOrCreateAsync(userId);
            IBrokerClient broker = !string.IsNullOrWhiteSpace(keys.AlpacaApiKeyId)
                ? new AlpacaBrokerClient(keys.AlpacaApiKeyId, keys.AlpacaApiSecretKey ?? "", keys.AlpacaIsPaper)
                : new SandboxBrokerClient();

            var request = new OrderRequest
            {
                Symbol = signal.Symbol,
                Quantity = 1,
                Side = signal.Direction == TradeDirection.Long ? OrderSide.Buy : OrderSide.Sell,
                Type = OrderType.Market,
                TimeInForce = "DAY"
            };
            var result = await broker.PlaceOrderAsync(request);
            AuditLogger.Log("MANUAL_TRADE", $"BrokerOrderId={result.BrokerOrderId} Symbol={signal.Symbol} Side={request.Side} Strategy={signal.StrategyName}", signal.Symbol);
            executionFeedback = result.IsSuccess
                ? $"Order placed: {request.Side} {signal.Symbol} (ID: {result.BrokerOrderId})"
                : $"Order rejected: {result.Message}";
        }
        catch (Exception ex)
        {
            executionFeedback = $"Error: {ex.Message}";
        }
    }

    private async Task ExportCsv()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Time (UTC),Symbol,Direction,Strategy,Confidence,Entry,Stop,Reason");
        foreach (var s in filteredSignals)
        {
            sb.AppendLine($"{s.GeneratedUtc:yyyy-MM-dd HH:mm:ss},{s.Symbol},{s.Direction},{s.StrategyName},{s.ConfidencePercent:F1},{s.SuggestedEntry:F2},{s.SuggestedStop:F2},{s.Reason.Replace(",", " ")}");
        }
        var filename = $"signals_{DateTime.UtcNow:yyyyMMdd_HHmmss}.csv";
        await JS.InvokeVoidAsync("IdiotProof.downloadFile", filename, "text/csv", sb.ToString());
    }

    public void Dispose() => refreshTimer?.Dispose();
}
