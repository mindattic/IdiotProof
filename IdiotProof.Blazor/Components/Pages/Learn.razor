@page "/learn"
@rendermode InteractiveServer
@using IdiotProof.Blazor.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@*
    Learning Center — teaches a user everything needed to create and monitor a strategy.
    Verb catalog is rendered from live reflection (IP-LAW-4) so docs never drift from code.
    Stories: IP-US-I1 through IP-US-I5.
*@

<PageTitle>Learn — IdiotProof</PageTitle>

<section aria-labelledby="learn-heading" class="learn-center">

    <div class="d-flex align-items-center gap-2 mb-1">
        <h1 id="learn-heading" class="h4 mb-0">
            <i class="bi bi-book me-2" style="color:var(--brand)" aria-hidden="true"></i>Learning Center
        </h1>
    </div>
    <p class="text-muted small mb-4">
        Everything you need to define, activate, and monitor a trading strategy — end to end.
    </p>

    @* ── IP-US-I1 — Workflow overview ── *@
    <div class="trading-card p-4 mb-4" id="learn-workflow">
        <h2 class="h5 mb-3">
            <i class="bi bi-diagram-3 me-2" style="color:var(--brand)" aria-hidden="true"></i>How it works end to end
        </h2>
        <p class="text-muted small mb-3">
            IdiotProof turns a plain-English idea into a running strategy in five steps.
            The Monitor evaluates it 24/7 and only fires when everything lines up.
        </p>

        <div class="workflow-diagram d-flex flex-wrap align-items-center gap-2 mb-3" aria-label="Workflow overview">
            <div class="wf-step text-center">
                <div class="wf-icon"><i class="bi bi-pencil-square fs-4" aria-hidden="true"></i></div>
                <div class="wf-label small fw-semibold mt-1">1&nbsp;· Describe</div>
                <div class="wf-desc text-muted" style="font-size:.75rem">Write your idea<br/>in plain English</div>
            </div>
            <div class="wf-arrow" aria-hidden="true"><i class="bi bi-arrow-right"></i></div>
            <div class="wf-step text-center">
                <div class="wf-icon"><i class="bi bi-robot fs-4" aria-hidden="true"></i></div>
                <div class="wf-label small fw-semibold mt-1">2&nbsp;· Generate</div>
                <div class="wf-desc text-muted" style="font-size:.75rem">Claude writes<br/>valid IdiotScript</div>
            </div>
            <div class="wf-arrow" aria-hidden="true"><i class="bi bi-arrow-right"></i></div>
            <div class="wf-step text-center">
                <div class="wf-icon"><i class="bi bi-toggle-on fs-4" aria-hidden="true"></i></div>
                <div class="wf-label small fw-semibold mt-1">3&nbsp;· Activate</div>
                <div class="wf-desc text-muted" style="font-size:.75rem">Save and enable<br/>on Strategies page</div>
            </div>
            <div class="wf-arrow" aria-hidden="true"><i class="bi bi-arrow-right"></i></div>
            <div class="wf-step text-center">
                <div class="wf-icon"><i class="bi bi-cpu fs-4" aria-hidden="true"></i></div>
                <div class="wf-label small fw-semibold mt-1">4&nbsp;· Monitor</div>
                <div class="wf-desc text-muted" style="font-size:.75rem">24/7 console evaluates<br/>every tick</div>
            </div>
            <div class="wf-arrow" aria-hidden="true"><i class="bi bi-arrow-right"></i></div>
            <div class="wf-step text-center gates-step">
                <div class="wf-icon"><i class="bi bi-shield-lock fs-4" aria-hidden="true"></i></div>
                <div class="wf-label small fw-semibold mt-1">5&nbsp;· Three Gates</div>
                <div class="wf-desc text-muted" style="font-size:.75rem">Conditions&nbsp;→ LLM&nbsp;→ Risk<br/>then fire</div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-2">
            <a href="/builder" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-code-square me-1" aria-hidden="true"></i>Try the Builder
            </a>
            <a href="/" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-collection me-1" aria-hidden="true"></i>View Strategies
            </a>
        </div>
    </div>

    @* ── IP-US-I2 — Six phases + reflected verb catalog ── *@
    <div class="trading-card p-4 mb-4" id="learn-phases">
        <h2 class="h5 mb-1">
            <i class="bi bi-layers me-2" style="color:var(--brand)" aria-hidden="true"></i>The six IdiotScript phases
        </h2>
        <p class="text-muted small mb-3">
            Every strategy walks through these phases in order. The parser rejects verbs used in
            the wrong phase. The verb list below is <strong>generated from the live codebase</strong>
            — it can never drift from what actually compiles.
        </p>

        @if (phaseGroups is not null)
        {
            <div class="row g-3">
                @foreach (var (group, idx) in phaseGroups.Select((g, i) => (g, i)))
                {
                    <div class="col-md-6">
                        <div class="phase-card p-3 h-100" data-phase="@group.Phase.ToLowerInvariant()">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="phase-badge" aria-hidden="true">@(idx + 1)</span>
                                <span class="fw-semibold">@group.Phase</span>
                            </div>
                            <div class="text-muted small mb-2">@group.Role</div>
                            <div class="text-muted" style="font-size:.75rem; margin-bottom:.5rem">@group.Description</div>
                            <div class="verb-list">
                                @foreach (var verb in group.Verbs)
                                {
                                    <button type="button" class="verb-chip small" @onclick="() => selectedGlossaryKey = VerbKey(verb)">@verb</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-muted small">Loading verb catalog…</div>
        }

        @if (conditionCatalog is not null && conditionCatalog.Count > 0)
        {
            <details class="mt-3">
                <summary class="small text-muted" style="cursor:pointer">
                    <i class="bi bi-braces me-1" aria-hidden="true"></i>Static <code>Conditions</code> catalog
                    (for <code>.If</code> / <code>.ElseIf</code> branching) — @conditionCatalog.Count verbs
                </summary>
                <div class="verb-list mt-2">
                    @foreach (var v in conditionCatalog)
                    {
                        <button type="button" class="verb-chip small" @onclick="() => selectedGlossaryKey = VerbKey(v)">@v</button>
                    }
                </div>
            </details>
        }

        <div class="mt-3">
            <a href="/builder" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-code-square me-1" aria-hidden="true"></i>Open the Builder to use these verbs
            </a>
        </div>
    </div>

    @* ── IP-US-I3 — Three gates diagram ── *@
    <div class="trading-card p-4 mb-4" id="learn-gates">
        <h2 class="h5 mb-1">
            <i class="bi bi-shield-check me-2" style="color:var(--brand)" aria-hidden="true"></i>The three gates
        </h2>
        <p class="text-muted small mb-3">
            Before any trade fires, the signal must pass three gates in order. Any gate can block
            the fire; the reason is always written to the audit log.
        </p>

        <div class="gates-diagram d-flex flex-column flex-md-row gap-3 mb-3" aria-label="Three gates diagram">
            <div class="gate-card p-3 flex-fill text-center">
                <div class="gate-number" aria-hidden="true">1</div>
                <i class="bi bi-list-check fs-3 d-block my-2" style="color:var(--brand)" aria-hidden="true"></i>
                <div class="fw-semibold mb-1">Condition Match</div>
                <div class="text-muted small">
                    Every entry condition in the strategy must evaluate to <code>true</code>
                    on the same bar. A single <code>false</code> blocks the fire.
                </div>
                <div class="mt-2 text-muted" style="font-size:.75rem">
                    <i class="bi bi-speedometer2 me-1" aria-hidden="true"></i>
                    Progress visible as <strong>N/M</strong> badge on the Strategies page
                </div>
            </div>
            <div class="gate-arrow align-self-center" aria-hidden="true">
                <i class="bi bi-arrow-right d-none d-md-block fs-4"></i>
                <i class="bi bi-arrow-down d-md-none fs-4"></i>
            </div>
            <div class="gate-card p-3 flex-fill text-center">
                <div class="gate-number" aria-hidden="true">2</div>
                <i class="bi bi-people fs-3 d-block my-2" style="color:var(--brand)" aria-hidden="true"></i>
                <div class="fw-semibold mb-1">LLM Voter Quorum</div>
                <div class="text-muted small">
                    A panel of LLMs votes on whether to approve the signal. Quorum must be
                    reached; dissent blocks the fire. All traffic routes through
                    MindAttic.Legion — no direct API calls.
                </div>
                <div class="mt-2 text-muted" style="font-size:.75rem">
                    <i class="bi bi-gear me-1" aria-hidden="true"></i>
                    Configured in <code>legion.json</code>; default panel: claude&nbsp;+&nbsp;openai&nbsp;+&nbsp;gemini
                </div>
            </div>
            <div class="gate-arrow align-self-center" aria-hidden="true">
                <i class="bi bi-arrow-right d-none d-md-block fs-4"></i>
                <i class="bi bi-arrow-down d-md-none fs-4"></i>
            </div>
            <div class="gate-card p-3 flex-fill text-center">
                <div class="gate-number" aria-hidden="true">3</div>
                <i class="bi bi-shield-exclamation fs-3 d-block my-2" style="color:var(--brand)" aria-hidden="true"></i>
                <div class="fw-semibold mb-1">Risk Guardian</div>
                <div class="text-muted small">
                    The final veto. Checks: stop loss present, risk within per-trade cap,
                    worst-case size within account risk %, and daily loss circuit breaker.
                    Cannot be bypassed — not even by a unanimous LLM vote.
                </div>
                <div class="mt-2 text-muted" style="font-size:.75rem">
                    <i class="bi bi-lock me-1" aria-hidden="true"></i>
                    Enforced by <code>RiskGuardian</code> in <code>IdiotProof.Shared</code>
                </div>
            </div>
        </div>

        <div class="alert alert-info small mb-0" role="note">
            <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
            <strong>Sandbox is the safe default.</strong> The Monitor always starts with the Sandbox broker
            registered as the fallback — live trading requires an explicit opt-in on the API Keys page.
        </div>
    </div>

    @* ── IP-US-I4 — Annotated examples ── *@
    <div class="trading-card p-4 mb-4" id="learn-examples">
        <h2 class="h5 mb-2">
            <i class="bi bi-collection-play me-2" style="color:var(--brand)" aria-hidden="true"></i>Example strategies
        </h2>
        <p class="text-muted small mb-3">
            Three production-ready scripts that demonstrate the most common setups.
            Click "Open in Builder" to seed the editor with that script.
        </p>

        <div class="row g-3">
            @foreach (var ex in examples)
            {
                <div class="col-lg-4">
                    <div class="example-card p-3 h-100 d-flex flex-column">
                        <div class="fw-semibold mb-1">@ex.Title</div>
                        <div class="text-muted small mb-2">@ex.Description</div>
                        <pre class="script-preview flex-grow-1"><code>@ex.Script</code></pre>
                        <div class="d-flex gap-2 mt-2 flex-wrap">
                            <a href="/builder?seed=@Uri.EscapeDataString(ex.Script)&ticker=@ex.Ticker"
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Open in Builder
                            </a>
                            <a href="/backtest" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-clock-history me-1" aria-hidden="true"></i>Backtest
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @* ── IP-US-I5 — Quick links / "try it" ── *@
    <div class="trading-card p-4 mb-4" id="learn-try-it">
        <h2 class="h5 mb-3">
            <i class="bi bi-lightning me-2" style="color:var(--brand)" aria-hidden="true"></i>Try it now
        </h2>
        <div class="row g-3">
            <div class="col-sm-6 col-lg-3">
                <a href="/builder" class="try-it-card p-3 d-block text-decoration-none">
                    <i class="bi bi-code-square fs-3 d-block mb-2" style="color:var(--brand)" aria-hidden="true"></i>
                    <div class="fw-semibold">Strategy Builder</div>
                    <div class="text-muted small">Describe your setup → Claude generates IdiotScript → Save</div>
                </a>
            </div>
            <div class="col-sm-6 col-lg-3">
                <a href="/" class="try-it-card p-3 d-block text-decoration-none">
                    <i class="bi bi-collection fs-3 d-block mb-2" style="color:var(--brand)" aria-hidden="true"></i>
                    <div class="fw-semibold">My Strategies</div>
                    <div class="text-muted small">Toggle strategies active, view live condition progress badges</div>
                </a>
            </div>
            <div class="col-sm-6 col-lg-3">
                <a href="/backtest" class="try-it-card p-3 d-block text-decoration-none">
                    <i class="bi bi-clock-history fs-3 d-block mb-2" style="color:var(--brand)" aria-hidden="true"></i>
                    <div class="fw-semibold">Backtest</div>
                    <div class="text-muted small">Replay a strategy over a previous day, bar by bar</div>
                </a>
            </div>
            <div class="col-sm-6 col-lg-3">
                <a href="/api-keys" class="try-it-card p-3 d-block text-decoration-none">
                    <i class="bi bi-key fs-3 d-block mb-2" style="color:var(--brand)" aria-hidden="true"></i>
                    <div class="fw-semibold">API Keys</div>
                    <div class="text-muted small">Set your Claude and Alpaca credentials — required to generate and trade</div>
                </a>
            </div>
        </div>
    </div>

</section>

<GlossaryModal Key="selectedGlossaryKey" OnClose="() => selectedGlossaryKey = null" />

<style>
    .learn-center { max-width: 1100px; }

    /* Workflow diagram */
    .workflow-diagram { flex-wrap: wrap; }
    .wf-step { min-width: 90px; }
    .wf-icon { font-size: 1.5rem; color: var(--brand-text); }
    .wf-arrow { color: var(--text-muted); font-size: 1.1rem; }
    .gates-step .wf-icon { color: var(--yellow, #f0c000); }

    /* Phase cards */
    .phase-card {
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg-card);
    }
    .phase-badge {
        display: inline-flex; align-items: center; justify-content: center;
        width: 1.5rem; height: 1.5rem; border-radius: 50%;
        background: var(--brand); color: #fff; font-size: .75rem; font-weight: 700;
        flex-shrink: 0;
    }
    .verb-list { display: flex; flex-wrap: wrap; gap: .25rem; }
    .verb-chip {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: 4px; padding: .1rem .35rem;
        font-size: .7rem; white-space: nowrap;
        font-family: var(--font-mono, "Roboto Mono", "Courier New", monospace);
        color: inherit; cursor: pointer;
    }
    .verb-chip:hover { border-color: var(--brand); background: var(--bg-hover); }

    /* Gates */
    .gate-card {
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg-card);
        min-width: 160px;
    }
    .gate-number {
        display: inline-flex; align-items: center; justify-content: center;
        width: 1.6rem; height: 1.6rem; border-radius: 50%;
        border: 2px solid var(--brand); color: var(--brand-text);
        font-weight: 700; font-size: .8rem; margin: 0 auto;
    }
    .gate-arrow { color: var(--text-muted); }

    /* Examples */
    .example-card {
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg-card);
    }
    .script-preview {
        background: var(--bg-elevated);
        border-radius: 6px; padding: .6rem; font-size: .7rem;
        overflow-x: auto; white-space: pre-wrap; word-break: break-all;
        margin: 0;
    }

    /* Try-it cards */
    .try-it-card {
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg-card);
        color: inherit;
        transition: border-color .15s ease, background .15s ease;
    }
    .try-it-card:hover {
        border-color: var(--brand);
        background: var(--bg-hover);
    }
</style>

@code {
    private IReadOnlyList<StrategyScriptGenerator.PhaseVerbGroup>? phaseGroups;
    private IReadOnlyList<string>? conditionCatalog;
    private string? selectedGlossaryKey;

    /// <summary>The bare verb name (before "(") a reflected chip like "IsAdxAbove(double threshold=20)" resolves to.</summary>
    private static string VerbKey(string reflectedVerb) => reflectedVerb.Split('(')[0].Trim();

    private static readonly ExampleEntry[] examples =
    [
        new(
            "NCI Breakout-Pullback",
            "NCI",
            "Long after a breakout above 3.68 retraces back — two scale-out targets, stop below the level.",
            "Stock.Ticker(\"NCI\")\n    .Breakout(3.68)\n    .Pullback()\n    .IsAboveVwap()\n    .Long()\n    .TakeProfit(5.00, 6.50)\n    .StopLoss(3.50)\n    .Repeat()\n    .Build()"),
        new(
            "ERNA AH Momentum",
            "ERNA",
            "After-hours momentum breakout that must hold above 0.48 and stay above VWAP — two targets, tight stop.",
            "Stock.Ticker(\"ERNA\")\n    .Breakout(0.52)\n    .Pullback()\n    .IsAboveVwap()\n    .HoldsAbove(0.48)\n    .Long()\n    .TakeProfit(0.66, 0.88)\n    .StopLoss(0.46)\n    .Repeat()\n    .Build()"),
        new(
            "SUNE Wedge Breakout",
            "SUNE",
            "Clean breakout above 2.42 with price holding above 2.30 — three scale-out targets, wide stop.",
            "Stock.Ticker(\"SUNE\")\n    .Breakout(2.42)\n    .HoldsAbove(2.30)\n    .Long()\n    .TakeProfit(2.85, 3.20, 4.20)\n    .StopLoss(2.25)\n    .Repeat()\n    .Build()"),
    ];

    protected override void OnInitialized()
    {
        phaseGroups = StrategyScriptGenerator.GetVerbsByPhase();
        conditionCatalog = StrategyScriptGenerator.GetConditionCatalog();
    }

    private sealed record ExampleEntry(string Title, string Ticker, string Description, string Script);
}
