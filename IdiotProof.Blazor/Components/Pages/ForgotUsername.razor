@page "/forgot-username"
@attribute [AllowAnonymous]
@inject AppDbContext Db
@layout EmptyLayout

@using IdiotProof.Blazor.Data
@using Microsoft.EntityFrameworkCore

<PageTitle>Find Username — IdiotProof</PageTitle>

<main class="login-wrapper" id="main-content">
    <section class="login-card" aria-labelledby="forgot-user-heading">
        <div class="login-logo">
            <span class="logo-icon" aria-hidden="true">⚡</span>
            <h1 id="forgot-user-heading">IdiotProof</h1>
            <p class="logo-sub">Find your username</p>
        </div>

        <p class="login-warning" style="text-align:left;margin-bottom:1rem">
            Your username is the email address you registered with.
            Local accounts on this machine:
        </p>

        @if (emails.Count == 0)
        {
            <div class="alert-error" role="status">
                No accounts found yet. <a href="/register" style="color:#79c0ff">Create one</a>.
            </div>
        }
        else
        {
            <ul class="email-list" aria-label="Registered usernames on this machine">
                @foreach (var email in emails)
                {
                    <li><code>@email</code></li>
                }
            </ul>
        }

        <p class="login-warning" style="margin-top:1rem">
            <a href="/login" style="color:#79c0ff">Back to sign in</a>
            &middot;
            <a href="/forgot-password" style="color:#79c0ff">Reset password</a>
        </p>
    </section>
</main>

@code {
    private List<string> emails = [];

    protected override async Task OnInitializedAsync()
    {
        emails = await Db.AuthUsers
            .Where(u => u.Email != null)
            .OrderBy(u => u.Email)
            .Select(u => u.Email!)
            .ToListAsync();
    }
}

<style>
.login-wrapper { min-height:100vh; display:flex; align-items:center; justify-content:center; background:var(--bg-primary,#0d1117); }
.login-card { width:100%; max-width:380px; background:var(--bg-card,#1c2128); border:1px solid var(--border,#30363d); border-radius:12px; padding:2.5rem; }
.login-logo { text-align:center; margin-bottom:2rem; }
.logo-icon { font-size:2.5rem; }
.login-logo h1 { font-size:1.8rem; font-weight:700; color:#e6edf3; margin:0.25rem 0; }
.logo-sub { color:#8b949e; font-size:0.85rem; }
.alert-error { background:rgba(248,81,73,0.15); border:1px solid rgba(248,81,73,0.4); border-radius:6px; padding:0.75rem 1rem; font-size:0.85rem; color:#f85149; margin-bottom:1.25rem; }
.email-list { list-style:none; padding:0; margin:0; border:1px solid #30363d; border-radius:6px; background:#0d1117; }
.email-list li { padding:0.6rem 0.85rem; border-bottom:1px solid #30363d; color:#e6edf3; font-size:0.9rem; }
.email-list li:last-child { border-bottom:none; }
.email-list code { background:transparent; color:#e6edf3; font-family:inherit; }
.login-warning { margin-top:0.75rem; font-size:0.75rem; color:#6e7681; text-align:center; }
</style>
