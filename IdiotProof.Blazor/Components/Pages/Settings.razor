@page "/settings"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Settings — IdiotProof</PageTitle>

<section aria-labelledby="settings-heading">
    <h1 id="settings-heading" class="h4 mb-3">
        <i class="bi bi-gear me-2" style="color:var(--brand)" aria-hidden="true"></i>Settings
    </h1>

    <div class="trading-card p-4">
        <p class="text-muted mb-0">
            Settings will live here as the editor grows. For now this page is a placeholder —
            theme is fixed to dark, timezone is fixed to Eastern, and per-user API credentials
            live on the
            <a href="/api-keys">API Keys</a> page.
        </p>
    </div>
</section>
