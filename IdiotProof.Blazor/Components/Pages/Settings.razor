@page "/settings"
@rendermode InteractiveServer
@using IdiotProof.Blazor.Services
@inject AppSettings AppSettings
@inject IStorageProvider StorageProvider
@inject TradingStateService TradingState
@inject UserManager<AppUser> UserMgr
@inject AuthenticationStateProvider AuthStateProvider
@inject SettingsRepository SettingsRepo
@inject AuditLogRepository AuditLogRepo

<PageTitle>Settings — IdiotProof</PageTitle>

<section aria-labelledby="settings-heading">
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 id="settings-heading" class="h4 mb-0 text-white">
        <i class="bi bi-gear me-2" style="color:var(--text-muted)" aria-hidden="true"></i>Settings
    </h1>
    <button class="btn btn-success btn-sm" type="button" @onclick="SaveSettings" aria-label="Save settings">
        <i class="bi bi-floppy me-1" aria-hidden="true"></i>Save
    </button>
</div>

<div role="status" aria-live="polite" aria-atomic="true">
@if (!string.IsNullOrEmpty(saveMessage))
{
    <div class="alert alert-success small py-2 mb-3">@saveMessage</div>
}
</div>

<!-- General Settings -->
<section class="trading-card p-3 mb-3" aria-labelledby="general-heading">
    <h2 id="general-heading" class="h6 text-white mb-3">General</h2>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label text-muted small" for="default-broker">Default Broker</label>
            <select id="default-broker" class="form-select bg-dark text-white border-secondary" @bind="defaultBroker">
                <option value="Sandbox">Sandbox (safe)</option>
                <option value="Alpaca">Alpaca</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label text-muted small" for="default-data-feed">Default Data Feed</label>
            <select id="default-data-feed" class="form-select bg-dark text-white border-secondary" @bind="defaultDataFeed">
                <option value="Polygon">Polygon.io</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label text-muted small" for="timezone-select">Timezone</label>
            <select id="timezone-select" class="form-select bg-dark text-white border-secondary" @bind="timezone">
                <option value="Eastern Standard Time">Eastern (ET)</option>
                <option value="Central Standard Time">Central (CT)</option>
                <option value="Mountain Standard Time">Mountain (MT)</option>
                <option value="Pacific Standard Time">Pacific (PT)</option>
                <option value="UTC">UTC</option>
            </select>
        </div>
        <div class="col-md-4">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="showConnMsg" @bind="showConnectionMessages" />
                <label class="form-check-label text-muted small" for="showConnMsg">Show Connection Messages</label>
            </div>
        </div>
    </div>
</section>

<!-- Strategy Execution -->
<section class="trading-card p-3 mb-3" aria-labelledby="exec-heading">
    <h2 id="exec-heading" class="h6 text-white mb-3">Strategy Execution</h2>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label text-muted small" for="eval-interval">Evaluation Interval (seconds)</label>
            <input id="eval-interval"
                   type="number" min="5" max="300"
                   class="form-control bg-dark text-white border-secondary"
                   aria-describedby="eval-interval-hint"
                   @bind="evalInterval" />
            <div id="eval-interval-hint" class="text-muted" style="font-size:0.7rem">Min 5s, recommended 30s</div>
        </div>
        <div class="col-md-4">
            <label class="form-label text-muted small" for="max-concurrent">Max Concurrent Evaluations</label>
            <input id="max-concurrent"
                   type="number" min="1" max="20"
                   class="form-control bg-dark text-white border-secondary"
                   @bind="maxConcurrent" />
        </div>
    </div>
</section>

<!-- LLM Voting -->
<section class="trading-card p-3 mb-3" aria-labelledby="llm-heading">
    <h2 id="llm-heading" class="h6 text-white mb-3">
        <i class="bi bi-robot me-1" aria-hidden="true"></i>LLM Signal Voting
    </h2>
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="llmEnabled" @bind="llmEnabled" />
                <label class="form-check-label text-muted small" for="llmEnabled">Enable LLM Voting</label>
            </div>
        </div>
        <div class="col-md-4">
            <label class="form-label text-muted small" for="consensus-threshold">
                Consensus Threshold: <strong>@consensusThreshold%</strong>
            </label>
            <input id="consensus-threshold"
                   type="range" class="form-range" min="50" max="100" step="5"
                   aria-valuenow="@consensusThreshold"
                   aria-valuemin="50"
                   aria-valuemax="100"
                   aria-valuetext="@consensusThreshold percent"
                   aria-describedby="consensus-hint"
                   @bind="consensusThreshold"
                   @bind:event="oninput" />
            <div id="consensus-hint" class="text-muted" style="font-size:0.7rem">% of weighted votes required to approve</div>
        </div>
    </div>

    <!-- Voter Weights -->
    <fieldset class="row g-2">
        <legend class="visually-hidden">Voter weights</legend>
        @foreach (var voter in voters)
        {
            var v = voter;
            var sliderId = $"voter-{v.ModelId}";
            <div class="col-md-6">
                <div class="border border-secondary rounded p-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="text-white small mb-0" for="@sliderId">@v.ModelId</label>
                        <span class="badge bg-secondary" aria-hidden="true">Weight: @v.Weight</span>
                    </div>
                    <input id="@sliderId"
                           type="range" class="form-range" min="0" max="5" step="1"
                           value="@v.Weight"
                           aria-label="Weight for @v.ModelId"
                           aria-valuenow="@v.Weight"
                           aria-valuemin="0"
                           aria-valuemax="5"
                           aria-valuetext="Weight @v.Weight of 5"
                           @onchange="@((e) => { if (int.TryParse(e.Value?.ToString(), out var w)) v.Weight = w; })" />
                </div>
            </div>
        }
    </fieldset>
</section>

<!-- Audit Log -->
<section class="trading-card p-3 mb-3" aria-labelledby="audit-heading">
    <h2 id="audit-heading" class="h6 text-white mb-3">
        <i class="bi bi-journal-text me-1" aria-hidden="true"></i>Audit Log (last 100 entries)
    </h2>
    <div style="max-height:300px;overflow-y:auto;font-family:monospace;font-size:0.75rem;background:var(--bg-secondary);border-radius:4px;padding:12px"
         role="log"
         aria-label="Audit log entries"
         tabindex="0">
        @if (logEntries.Any())
        {
            @foreach (var line in logEntries)
            {
                <div class="text-muted">@line</div>
            }
        }
        else
        {
            <div class="text-muted">No log entries found.</div>
        }
    </div>
</section>

<!-- Password -->
<section class="trading-card p-3 mb-3" aria-labelledby="password-heading">
    <h2 id="password-heading" class="h6 text-white mb-3">
        <i class="bi bi-lock me-1" aria-hidden="true"></i>Change Password
    </h2>
    <div role="status" aria-live="polite" aria-atomic="true">
    @if (!string.IsNullOrEmpty(passwordMessage))
    {
        <div class="alert @(passwordError ? "alert-danger" : "alert-success") small py-2 mb-3">@passwordMessage</div>
    }
    </div>
    <div class="row g-2" style="max-width:400px">
        <div class="col-12">
            <label class="form-label text-muted small" for="new-password">New Password</label>
            <input id="new-password"
                   type="password" class="form-control bg-dark text-white border-secondary"
                   autocomplete="new-password"
                   @bind="newPassword" placeholder="New password" />
        </div>
        <div class="col-12">
            <label class="form-label text-muted small" for="confirm-password">Confirm Password</label>
            <input id="confirm-password"
                   type="password" class="form-control bg-dark text-white border-secondary"
                   autocomplete="new-password"
                   @bind="confirmPassword" placeholder="Confirm password" />
        </div>
        <div class="col-12">
            <button class="btn btn-sm btn-outline-warning" type="button" @onclick="ChangePassword">
                <i class="bi bi-lock-fill me-1" aria-hidden="true"></i>Update Password
            </button>
        </div>
    </div>
</section>

<!-- Danger Zone -->
<section class="trading-card p-3 border border-danger" aria-labelledby="danger-heading">
    <h2 id="danger-heading" class="h6 text-danger mb-3">
        <i class="bi bi-exclamation-octagon me-1" aria-hidden="true"></i>Danger Zone
    </h2>
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <div class="text-white small" id="clear-data-label">Clear All Data</div>
            <div class="text-muted" id="clear-data-hint" style="font-size:0.75rem">Deletes all workspaces, signals, and settings. Cannot be undone.</div>
        </div>
        <button class="btn btn-sm btn-outline-danger"
                type="button"
                aria-labelledby="clear-data-label"
                aria-describedby="clear-data-hint"
                @onclick="() => showClearModal = true">
            Clear All Data
        </button>
    </div>
</section>
</section>

<!-- Clear Confirm Modal -->
@if (showClearModal)
{
    <div class="modal-backdrop fade show" @onclick="() => showClearModal = false"></div>
    <div class="modal fade show d-block"
         role="dialog"
         aria-modal="true"
         aria-labelledby="clear-modal-title"
         aria-describedby="clear-modal-desc"
         tabindex="-1"
         @onkeydown="HandleClearKey">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-danger">
                <div class="modal-header border-danger">
                    <h2 id="clear-modal-title" class="h5 modal-title text-danger">Confirm Clear All Data</h2>
                </div>
                <div class="modal-body text-white" id="clear-modal-desc">
                    <p>This will permanently delete <strong>all workspaces, settings, and signal history</strong>.</p>
                    <p class="text-danger fw-bold">This cannot be undone.</p>
                </div>
                <div class="modal-footer border-secondary">
                    <button class="btn btn-secondary" type="button" @onclick="() => showClearModal = false" autofocus>Cancel</button>
                    <button class="btn btn-danger" type="button" @onclick="ClearAllData">Yes, Delete Everything</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string defaultBroker = "Sandbox";
    private string defaultDataFeed = "Polygon";
    private string timezone = "Central Standard Time";
    private bool showConnectionMessages = true;
    private int evalInterval = 30;
    private int maxConcurrent = 5;
    private bool llmEnabled;
    private int consensusThreshold = 66;
    private bool showClearModal;
    private string saveMessage = "";
    private List<string> logEntries = [];
    private string newPassword = "";
    private string confirmPassword = "";
    private string passwordMessage = "";
    private bool passwordError;

    private sealed class VoterConfig
    {
        public string ModelId { get; set; } = "";
        public int Weight { get; set; } = 1;
    }

    private List<VoterConfig> voters =
    [
        new() { ModelId = "claude-sonnet-4-6", Weight = 2 },
        new() { ModelId = "claude-haiku-4-5-20251001", Weight = 1 },
    ];

    protected override async Task OnInitializedAsync()
    {
        // Read order: SQL KV store wins (canonical) → AppSettings snapshot (boot
        // values) → defaults baked into the typed class. The KV store is empty
        // on first run so AppSettings provides the seed values.
        defaultBroker          = await SettingsRepo.GetAsync("ui.defaultBroker")    ?? AppSettings.DefaultBroker;
        defaultDataFeed        = await SettingsRepo.GetAsync("ui.defaultDataFeed")  ?? AppSettings.DefaultDataFeed;
        timezone               = await SettingsRepo.GetAsync("ui.timezone")         ?? AppSettings.Timezone;
        showConnectionMessages = (await SettingsRepo.GetBoolAsync("ui.showConnectionMessages")) ?? AppSettings.ShowConnectionMessages;
        llmEnabled             = (await SettingsRepo.GetBoolAsync("llm.votingEnabled")) ?? AppSettings.LlmVotingEnabled;
        evalInterval           = (await SettingsRepo.GetIntAsync("engine.evaluationIntervalSeconds")) ?? AppSettings.StrategyEvaluationIntervalSeconds;
        maxConcurrent          = (await SettingsRepo.GetIntAsync("engine.maxConcurrentEvaluations")) ?? AppSettings.MaxConcurrentEvaluations;

        var thresholdRaw       = await SettingsRepo.GetDecimalAsync("llm.consensusThreshold");
        if (thresholdRaw is { } t) consensusThreshold = (int)Math.Round(t * 100);
        else                       consensusThreshold = (int)Math.Round(AppSettings.LlmConsensusThreshold * 100);

        LoadLogEntries();
    }

    private void LoadLogEntries()
    {
        try
        {
            var logDir = StorageProvider.LogsPath;
            var logs = Directory.GetFiles(logDir, "*.log")
                .OrderByDescending(f => f)
                .FirstOrDefault();
            if (logs != null)
            {
                logEntries = File.ReadAllLines(logs)
                    .Reverse()
                    .Take(100)
                    .ToList();
            }
        }
        catch { logEntries = ["(Could not read log files)"]; }
    }

    private async Task SaveSettings()
    {
        // Clamp before persisting so out-of-range values from a tampered DOM
        // never reach the database.
        evalInterval  = Math.Clamp(evalInterval, 5, 300);
        maxConcurrent = Math.Clamp(maxConcurrent, 1, 20);
        consensusThreshold = Math.Clamp(consensusThreshold, 50, 100);

        // Live-update the in-memory AppSettings snapshot so any code that
        // injected it (StrategyExecutionService, etc.) sees the new values
        // before the next process restart.
        AppSettings.DefaultBroker                       = defaultBroker;
        AppSettings.DefaultDataFeed                     = defaultDataFeed;
        AppSettings.Timezone                            = timezone;
        AppSettings.ShowConnectionMessages              = showConnectionMessages;
        AppSettings.LlmVotingEnabled                    = llmEnabled;
        AppSettings.StrategyEvaluationIntervalSeconds   = evalInterval;
        AppSettings.MaxConcurrentEvaluations            = maxConcurrent;
        AppSettings.LlmConsensusThreshold               = consensusThreshold / 100m;

        // Canonical persist path: SQL KV. The disk app-settings.json file
        // remains as a startup-overlay seed so older process forks (CLI,
        // existing engine) keep reading what they always read.
        await SettingsRepo.SetAsync("ui.defaultBroker", defaultBroker);
        await SettingsRepo.SetAsync("ui.defaultDataFeed", defaultDataFeed);
        await SettingsRepo.SetAsync("ui.timezone", timezone);
        await SettingsRepo.SetAsync("ui.showConnectionMessages", showConnectionMessages ? "true" : "false");
        await SettingsRepo.SetAsync("llm.votingEnabled", llmEnabled ? "true" : "false");
        await SettingsRepo.SetAsync("llm.consensusThreshold", (consensusThreshold / 100m).ToString(System.Globalization.CultureInfo.InvariantCulture));
        await SettingsRepo.SetAsync("engine.evaluationIntervalSeconds", evalInterval.ToString(System.Globalization.CultureInfo.InvariantCulture));
        await SettingsRepo.SetAsync("engine.maxConcurrentEvaluations", maxConcurrent.ToString(System.Globalization.CultureInfo.InvariantCulture));

        AppSettings.Save(StorageProvider);

        // Record who changed what so the audit trail captures config drift.
        var auth   = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await AuditLogRepo.LogAsync("settings", "Settings updated", userId);

        saveMessage = "Settings saved (DB + disk).";
    }

    private async Task ChangePassword()
    {
        passwordMessage = "";
        passwordError = false;

        if (string.IsNullOrWhiteSpace(newPassword) || newPassword.Length < 8)
        {
            passwordMessage = "Password must be at least 8 characters.";
            passwordError = true;
            return;
        }
        if (newPassword != confirmPassword)
        {
            passwordMessage = "Passwords do not match.";
            passwordError = true;
            return;
        }

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId == null) { passwordMessage = "Not authenticated."; passwordError = true; return; }

        var user = await UserMgr.FindByIdAsync(userId);
        if (user == null) { passwordMessage = "User not found."; passwordError = true; return; }

        var token = await UserMgr.GeneratePasswordResetTokenAsync(user);
        var result = await UserMgr.ResetPasswordAsync(user, token, newPassword);

        if (result.Succeeded)
        {
            newPassword = "";
            confirmPassword = "";
            passwordMessage = "Password updated successfully.";
        }
        else
        {
            passwordMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            passwordError = true;
        }
    }

    private void HandleClearKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") showClearModal = false;
    }

    private void ClearAllData()
    {
        try
        {
            foreach (var dir in new[] { StorageProvider.WorkspacesPath, StorageProvider.DataPath })
            {
                if (Directory.Exists(dir))
                    foreach (var f in Directory.GetFiles(dir))
                        File.Delete(f);
            }
            var settingsFile = Path.Combine(StorageProvider.SettingsPath, "app-settings.json");
            if (File.Exists(settingsFile)) File.Delete(settingsFile);
        }
        catch { }
        showClearModal = false;
        saveMessage = "All data cleared. Restart the application.";
    }
}
