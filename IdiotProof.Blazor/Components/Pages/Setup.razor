@page "/setup"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inject AppSettings AppSettings
@inject IStorageProvider StorageProvider
@inject UserKeyService UserKeyService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Setup — IdiotProof</PageTitle>

<main class="d-flex justify-content-center" id="main-content">
    <div style="max-width:680px;width:100%">
        <header class="text-center mb-4">
            <h1 class="h3 text-white mb-1">
                <i class="bi bi-magic me-2" style="color:var(--green)" aria-hidden="true"></i>IdiotProof Setup
            </h1>
            <div class="text-muted small" aria-live="polite">Step @currentStep of @totalSteps</div>
            <div class="progress mt-2" style="height:4px;background:var(--bg-secondary)"
                 role="progressbar"
                 aria-valuenow="@currentStep"
                 aria-valuemin="1"
                 aria-valuemax="@totalSteps"
                 aria-label="Setup progress">
                <div class="progress-bar bg-success" style="width:@(currentStep * 100 / totalSteps)%"></div>
            </div>
        </header>

        <section class="trading-card p-4" aria-live="polite" aria-atomic="false">
            <!-- Step 1: Welcome -->
            @if (currentStep == 1)
            {
                <h2 class="h5 text-white mb-3">Welcome to IdiotProof</h2>
                <p class="text-muted">
                    IdiotProof is a professional trading strategy platform that helps you build, test, and execute
                    automated trading strategies using technical analysis and AI signal verification.
                </p>
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
                    <strong>Financial Risk Warning:</strong> Trading involves substantial risk of loss.
                    IdiotProof can place real orders with real brokers. Always start with paper trading.
                    Never trade more than you can afford to lose.
                </div>
                <ul class="text-muted small">
                    <li class="mb-1">Connect to IBKR or Alpaca as your broker</li>
                    <li class="mb-1">Use Polygon.io for market data</li>
                    <li class="mb-1">Let Claude AI vote on trade signals</li>
                    <li class="mb-1">Run proven strategies: ITI, Premarket Breakout, Momentum Decay</li>
                    <li>Monitor positions and P&L in real-time</li>
                </ul>
            }

            <!-- Step 2: Broker Setup -->
            @if (currentStep == 2)
            {
                <h2 class="h5 text-white mb-3">Broker Setup</h2>
                <fieldset class="mb-3">
                    <legend class="form-label text-muted small">Choose your primary broker</legend>
                    <div class="row g-2" role="radiogroup" aria-label="Primary broker">
                        @foreach (var broker in new[] { ("Alpaca", "Recommended for beginners. REST API, easy setup, great paper trading.", "bi-graph-up"), ("Ibkr", "Interactive Brokers. Advanced. Requires TWS or Gateway running locally.", "bi-building"), ("Sandbox", "No real broker. Use for testing and development only.", "bi-cpu") })
                        {
                            var b = broker;
                            var isChecked = primaryBroker == b.Item1;
                            <div class="col-md-4">
                                <button type="button"
                                        class="border rounded p-2 text-center w-100 bg-transparent @(isChecked ? "border-success" : "border-secondary")"
                                        role="radio"
                                        aria-checked="@isChecked"
                                        aria-label="@b.Item1: @b.Item2"
                                        @onclick="() => primaryBroker = b.Item1">
                                    <i class="bi @b.Item3 fs-3 @(isChecked ? "text-success" : "text-muted") d-block mb-1" aria-hidden="true"></i>
                                    <div class="text-white small fw-semibold">@b.Item1</div>
                                    <div class="text-muted" style="font-size:0.7rem">@b.Item2</div>
                                </button>
                            </div>
                        }
                    </div>
                </fieldset>
                @if (primaryBroker == "Alpaca")
                {
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label text-muted small" for="setup-alpaca-key">Alpaca API Key ID</label>
                            <input id="setup-alpaca-key"
                                   class="form-control bg-dark text-white border-secondary"
                                   autocomplete="off"
                                   @bind="alpacaKeyId" placeholder="PK..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small" for="setup-alpaca-secret">Secret Key</label>
                            <input id="setup-alpaca-secret"
                                   type="password"
                                   class="form-control bg-dark text-white border-secondary"
                                   autocomplete="off"
                                   @bind="alpacaSecret" placeholder="••••" />
                        </div>
                    </div>
                }
                @if (primaryBroker == "Ibkr")
                {
                    <div class="alert alert-info small" role="note">
                        IBKR requires TWS or IB Gateway running on your machine with API access enabled.
                        Default connection: 127.0.0.1:4002 (paper).
                    </div>
                }
            }

            <!-- Step 3: Data Feed -->
            @if (currentStep == 3)
            {
                <h2 class="h5 text-white mb-3">Market Data Feed</h2>
                <p class="text-muted small">Market data is needed to fetch price history for strategy evaluation.</p>
                <div class="mb-3">
                    <div class="border rounded p-3 border-secondary">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-hexagon fs-3 text-purple" style="color:#8b5cf6" aria-hidden="true"></i>
                            <div class="flex-grow-1">
                                <div class="text-white fw-semibold">Polygon.io</div>
                                <div class="text-muted small mb-2" id="polygon-hint">Professional market data. Free tier available at polygon.io</div>
                                <label class="form-label text-muted small" for="setup-polygon-key">API Key</label>
                                <input id="setup-polygon-key"
                                       class="form-control form-control-sm bg-dark text-white border-secondary"
                                       autocomplete="off"
                                       aria-describedby="polygon-hint"
                                       @bind="polygonKey" placeholder="Your Polygon API key" />
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Step 4: AI -->
            @if (currentStep == 4)
            {
                <h2 class="h5 text-white mb-3">AI Signal Voting</h2>
                <p class="text-muted small">
                    IdiotProof can send trade signals to Claude models for independent AI analysis.
                    Multiple models vote on whether to approve or reject the signal.
                </p>
                <div class="mb-3">
                    <label class="form-label text-muted small" for="setup-claude-key">Claude API Key (optional)</label>
                    <input id="setup-claude-key"
                           type="password"
                           class="form-control bg-dark text-white border-secondary"
                           autocomplete="off"
                           aria-describedby="claude-key-hint"
                           @bind="claudeKey" placeholder="sk-ant-..." />
                    <div id="claude-key-hint" class="text-muted small mt-1">Get your key at console.anthropic.com</div>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="enableLlm" @bind="enableLlm" />
                    <label class="form-check-label text-white small" for="enableLlm">Enable LLM Voting</label>
                </div>
                @if (!enableLlm)
                {
                    <div class="text-muted small mt-2">You can enable LLM voting later in Settings.</div>
                }
            }

            <!-- Step 5: Risk Limits -->
            @if (currentStep == 5)
            {
                <h2 class="h5 text-white mb-3">Default Risk Limits</h2>
                <p class="text-muted small">These apply to all workspaces unless overridden per-workspace.</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small" for="setup-max-loss-trade">Max Loss per Trade ($)</label>
                        <input id="setup-max-loss-trade" type="number" class="form-control bg-dark text-white border-secondary" @bind="maxLossPerTrade" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small" for="setup-max-loss-day">Max Loss per Day ($)</label>
                        <input id="setup-max-loss-day" type="number" class="form-control bg-dark text-white border-secondary" @bind="maxLossPerDay" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small" for="setup-max-position">Max Position Size ($)</label>
                        <input id="setup-max-position" type="number" class="form-control bg-dark text-white border-secondary" @bind="maxPositionSize" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small" for="setup-max-open">Max Open Positions</label>
                        <input id="setup-max-open" type="number" class="form-control bg-dark text-white border-secondary" @bind="maxOpenPositions" />
                    </div>
                </div>
            }

            <!-- Step 6: Paper Trading -->
            @if (currentStep == 6)
            {
                <h2 class="h5 text-white mb-3">Paper Trading Mode</h2>
                <div class="alert alert-success" role="note">
                    <i class="bi bi-shield-check me-2 fs-5" aria-hidden="true"></i>
                    <strong>We strongly recommend starting in paper trading mode.</strong>
                    Paper trading uses simulated money so you can verify your strategies work before risking real capital.
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="usePaper" @bind="usePaperTrading" />
                    <label class="form-check-label text-white" for="usePaper">
                        Start in Paper Trading Mode <span class="badge bg-success ms-1">Recommended</span>
                    </label>
                </div>
                @if (!usePaperTrading)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
                        <strong>WARNING:</strong> Live trading mode will place real orders with real money.
                        Ensure your broker account is properly funded and you understand the risks.
                    </div>
                }
            }

            <!-- Step 7: Complete -->
            @if (currentStep == 7)
            {
                <div class="text-center mb-4">
                    <i class="bi bi-check-circle-fill fs-1 d-block mb-3" style="color:var(--green)" aria-hidden="true"></i>
                    <h2 class="h5 text-white">Setup Complete!</h2>
                </div>
                <section class="trading-card p-3 mb-3" aria-labelledby="config-summary-heading">
                    <h3 id="config-summary-heading" class="text-muted small mb-2">Configuration Summary</h3>
                    <dl class="mb-0">
                        <div class="d-flex justify-content-between small py-1 border-bottom border-dark">
                            <dt class="text-muted fw-normal">Primary Broker</dt>
                            <dd class="text-white mb-0">@primaryBroker</dd>
                        </div>
                        <div class="d-flex justify-content-between small py-1 border-bottom border-dark">
                            <dt class="text-muted fw-normal">Data Feed</dt>
                            <dd class="text-white mb-0">@(string.IsNullOrEmpty(polygonKey) ? "None configured" : "Polygon.io")</dd>
                        </div>
                        <div class="d-flex justify-content-between small py-1 border-bottom border-dark">
                            <dt class="text-muted fw-normal">LLM Voting</dt>
                            <dd class="@(enableLlm ? "text-green" : "text-muted") mb-0">@(enableLlm ? "Enabled" : "Disabled")</dd>
                        </div>
                        <div class="d-flex justify-content-between small py-1 border-bottom border-dark">
                            <dt class="text-muted fw-normal">Max Loss / Trade</dt>
                            <dd class="text-white mb-0">$@maxLossPerTrade</dd>
                        </div>
                        <div class="d-flex justify-content-between small py-1">
                            <dt class="text-muted fw-normal">Mode</dt>
                            <dd class="@(usePaperTrading ? "text-green" : "text-red") mb-0">
                                @(usePaperTrading ? "Paper Trading" : "LIVE TRADING")
                            </dd>
                        </div>
                    </dl>
                </section>
            }
        </section>

        <!-- Navigation Buttons -->
        <div class="d-flex justify-content-between mt-3">
            <button class="btn btn-outline-secondary"
                    type="button"
                    disabled="@(currentStep <= 1)"
                    aria-label="Previous step"
                    @onclick="PrevStep">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
            </button>
            @if (currentStep < totalSteps)
            {
                <button class="btn btn-primary" type="button" aria-label="Next step" @onclick="NextStep">
                    Next <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                </button>
            }
            else
            {
                <button class="btn btn-success" @onclick="Complete" type="button" aria-label="Finish setup and go to dashboard">
                    <i class="bi bi-check-circle me-1" aria-hidden="true"></i>Go to Dashboard
                </button>
            }
        </div>
    </div>
</main>

@code {
    private int currentStep = 1;
    private const int totalSteps = 7;

    private string primaryBroker = "Alpaca";
    private string alpacaKeyId = "";
    private string alpacaSecret = "";
    private string polygonKey = "";
    private string claudeKey = "";
    private bool enableLlm = true;
    private bool usePaperTrading = true;
    private decimal maxLossPerTrade = 100m;
    private decimal maxLossPerDay = 500m;
    private decimal maxPositionSize = 5000m;
    private int maxOpenPositions = 5;

    private void NextStep() { if (currentStep < totalSteps) currentStep++; }
    private void PrevStep() { if (currentStep > 1) currentStep--; }

    private async Task Complete()
    {
        AppSettings.DefaultBroker = primaryBroker;
        AppSettings.DefaultDataFeed = "Polygon";
        AppSettings.LlmVotingEnabled = enableLlm;
        AppSettings.Save(StorageProvider);

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            var keys = await UserKeyService.GetOrCreateAsync(userId);
            keys.AlpacaApiKeyId     = alpacaKeyId;
            keys.AlpacaApiSecretKey = alpacaSecret;
            keys.AlpacaIsPaper      = usePaperTrading;
            keys.IbkrUsePaper       = usePaperTrading;
            keys.PolygonApiKey      = polygonKey;
            keys.ClaudeApiKey       = claudeKey;
            keys.LlmVotingEnabled   = enableLlm;
            await UserKeyService.SaveAsync(userId, keys);
        }

        Nav.NavigateTo("/");
    }
}
