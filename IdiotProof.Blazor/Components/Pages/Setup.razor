@page "/setup"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inject AppSettings AppSettings
@inject IStorageProvider StorageProvider
@inject UserKeyService UserKeyService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Setup — IdiotProof</PageTitle>

<div class="d-flex justify-content-center">
    <div style="max-width:680px;width:100%">
        <div class="text-center mb-4">
            <h3 class="text-white mb-1">
                <i class="bi bi-magic me-2" style="color:var(--green)"></i>IdiotProof Setup
            </h3>
            <div class="text-muted small">Step @currentStep of @totalSteps</div>
            <div class="progress mt-2" style="height:4px;background:var(--bg-secondary)">
                <div class="progress-bar bg-success" style="width:@(currentStep * 100 / totalSteps)%"></div>
            </div>
        </div>

        <div class="trading-card p-4">
            <!-- Step 1: Welcome -->
            @if (currentStep == 1)
            {
                <h5 class="text-white mb-3">Welcome to IdiotProof</h5>
                <p class="text-muted">
                    IdiotProof is a professional trading strategy platform that helps you build, test, and execute
                    automated trading strategies using technical analysis and AI signal verification.
                </p>
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Financial Risk Warning:</strong> Trading involves substantial risk of loss.
                    IdiotProof can place real orders with real brokers. Always start with paper trading.
                    Never trade more than you can afford to lose.
                </div>
                <ul class="text-muted small">
                    <li class="mb-1">Connect to IBKR or Alpaca as your broker</li>
                    <li class="mb-1">Use Polygon.io for market data</li>
                    <li class="mb-1">Let Claude AI vote on trade signals</li>
                    <li class="mb-1">Run proven strategies: ITI, Premarket Breakout, Momentum Decay</li>
                    <li>Monitor positions and P&L in real-time</li>
                </ul>
            }

            <!-- Step 2: Broker Setup -->
            @if (currentStep == 2)
            {
                <h5 class="text-white mb-3">Broker Setup</h5>
                <div class="mb-3">
                    <label class="form-label text-muted small">Choose your primary broker</label>
                    <div class="row g-2">
                        @foreach (var broker in new[] { ("Alpaca", "Recommended for beginners. REST API, easy setup, great paper trading.", "bi-graph-up"), ("Ibkr", "Interactive Brokers. Advanced. Requires TWS or Gateway running locally.", "bi-building"), ("Sandbox", "No real broker. Use for testing and development only.", "bi-cpu") })
                        {
                            var b = broker;
                            <div class="col-md-4">
                                <div class="border rounded p-2 text-center @(primaryBroker == b.Item1 ? "border-success" : "border-secondary")"
                                     style="cursor:pointer" @onclick="() => primaryBroker = b.Item1">
                                    <i class="bi @b.Item3 fs-3 @(primaryBroker == b.Item1 ? "text-success" : "text-muted") d-block mb-1"></i>
                                    <div class="text-white small fw-semibold">@b.Item1</div>
                                    <div class="text-muted" style="font-size:0.7rem">@b.Item2</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (primaryBroker == "Alpaca")
                {
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Alpaca API Key ID</label>
                            <input class="form-control bg-dark text-white border-secondary" @bind="alpacaKeyId" placeholder="PK..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Secret Key</label>
                            <input type="password" class="form-control bg-dark text-white border-secondary" @bind="alpacaSecret" placeholder="••••" />
                        </div>
                    </div>
                }
                @if (primaryBroker == "Ibkr")
                {
                    <div class="alert alert-info small">
                        IBKR requires TWS or IB Gateway running on your machine with API access enabled.
                        Default connection: 127.0.0.1:4002 (paper).
                    </div>
                }
            }

            <!-- Step 3: Data Feed -->
            @if (currentStep == 3)
            {
                <h5 class="text-white mb-3">Market Data Feed</h5>
                <p class="text-muted small">Market data is needed to fetch price history for strategy evaluation.</p>
                <div class="mb-3">
                    <div class="border rounded p-3 border-secondary">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-hexagon fs-3 text-purple" style="color:#8b5cf6"></i>
                            <div>
                                <div class="text-white fw-semibold">Polygon.io</div>
                                <div class="text-muted small mb-2">Professional market data. Free tier available at polygon.io</div>
                                <label class="form-label text-muted small">API Key</label>
                                <input class="form-control form-control-sm bg-dark text-white border-secondary"
                                       @bind="polygonKey" placeholder="Your Polygon API key" />
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Step 4: AI -->
            @if (currentStep == 4)
            {
                <h5 class="text-white mb-3">AI Signal Voting</h5>
                <p class="text-muted small">
                    IdiotProof can send trade signals to Claude models for independent AI analysis.
                    Multiple models vote on whether to approve or reject the signal.
                </p>
                <div class="mb-3">
                    <label class="form-label text-muted small">Claude API Key (optional)</label>
                    <input type="password" class="form-control bg-dark text-white border-secondary"
                           @bind="claudeKey" placeholder="sk-ant-..." />
                    <div class="text-muted small mt-1">Get your key at console.anthropic.com</div>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="enableLlm" @bind="enableLlm" />
                    <label class="form-check-label text-white small" for="enableLlm">Enable LLM Voting</label>
                </div>
                @if (!enableLlm)
                {
                    <div class="text-muted small mt-2">You can enable LLM voting later in Settings.</div>
                }
            }

            <!-- Step 5: Risk Limits -->
            @if (currentStep == 5)
            {
                <h5 class="text-white mb-3">Default Risk Limits</h5>
                <p class="text-muted small">These apply to all workspaces unless overridden per-workspace.</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Max Loss per Trade ($)</label>
                        <input type="number" class="form-control bg-dark text-white border-secondary" @bind="maxLossPerTrade" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Max Loss per Day ($)</label>
                        <input type="number" class="form-control bg-dark text-white border-secondary" @bind="maxLossPerDay" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Max Position Size ($)</label>
                        <input type="number" class="form-control bg-dark text-white border-secondary" @bind="maxPositionSize" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Max Open Positions</label>
                        <input type="number" class="form-control bg-dark text-white border-secondary" @bind="maxOpenPositions" />
                    </div>
                </div>
            }

            <!-- Step 6: Paper Trading -->
            @if (currentStep == 6)
            {
                <h5 class="text-white mb-3">Paper Trading Mode</h5>
                <div class="alert alert-success">
                    <i class="bi bi-shield-check me-2 fs-5"></i>
                    <strong>We strongly recommend starting in paper trading mode.</strong>
                    Paper trading uses simulated money so you can verify your strategies work before risking real capital.
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="usePaper" @bind="usePaperTrading" />
                    <label class="form-check-label text-white" for="usePaper">
                        Start in Paper Trading Mode <span class="badge bg-success ms-1">Recommended</span>
                    </label>
                </div>
                @if (!usePaperTrading)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>WARNING:</strong> Live trading mode will place real orders with real money.
                        Ensure your broker account is properly funded and you understand the risks.
                    </div>
                }
            }

            <!-- Step 7: Complete -->
            @if (currentStep == 7)
            {
                <div class="text-center mb-4">
                    <i class="bi bi-check-circle-fill fs-1 d-block mb-3" style="color:var(--green)"></i>
                    <h5 class="text-white">Setup Complete!</h5>
                </div>
                <div class="trading-card p-3 mb-3">
                    <h6 class="text-muted small mb-2">Configuration Summary</h6>
                    <div class="d-flex justify-content-between small py-1 border-bottom border-dark">
                        <span class="text-muted">Primary Broker</span>
                        <span class="text-white">@primaryBroker</span>
                    </div>
                    <div class="d-flex justify-content-between small py-1 border-bottom border-dark">
                        <span class="text-muted">Data Feed</span>
                        <span class="text-white">@(string.IsNullOrEmpty(polygonKey) ? "None configured" : "Polygon.io")</span>
                    </div>
                    <div class="d-flex justify-content-between small py-1 border-bottom border-dark">
                        <span class="text-muted">LLM Voting</span>
                        <span class="@(enableLlm ? "text-green" : "text-muted")">@(enableLlm ? "Enabled" : "Disabled")</span>
                    </div>
                    <div class="d-flex justify-content-between small py-1 border-bottom border-dark">
                        <span class="text-muted">Max Loss / Trade</span>
                        <span class="text-white">$@maxLossPerTrade</span>
                    </div>
                    <div class="d-flex justify-content-between small py-1">
                        <span class="text-muted">Mode</span>
                        <span class="@(usePaperTrading ? "text-green" : "text-red")">
                            @(usePaperTrading ? "Paper Trading" : "LIVE TRADING")
                        </span>
                    </div>
                </div>
            }
        </div>

        <!-- Navigation Buttons -->
        <div class="d-flex justify-content-between mt-3">
            <button class="btn btn-outline-secondary" disabled="@(currentStep <= 1)" @onclick="PrevStep">
                <i class="bi bi-arrow-left me-1"></i>Back
            </button>
            @if (currentStep < totalSteps)
            {
                <button class="btn btn-primary" @onclick="NextStep">
                    Next <i class="bi bi-arrow-right ms-1"></i>
                </button>
            }
            else
            {
                <button class="btn btn-success" @onclick="Complete" type="button">
                    <i class="bi bi-check-circle me-1"></i>Go to Dashboard
                </button>
            }
        </div>
    </div>
</div>

@code {
    private int currentStep = 1;
    private const int totalSteps = 7;

    private string primaryBroker = "Alpaca";
    private string alpacaKeyId = "";
    private string alpacaSecret = "";
    private string polygonKey = "";
    private string claudeKey = "";
    private bool enableLlm = true;
    private bool usePaperTrading = true;
    private decimal maxLossPerTrade = 100m;
    private decimal maxLossPerDay = 500m;
    private decimal maxPositionSize = 5000m;
    private int maxOpenPositions = 5;

    private void NextStep() { if (currentStep < totalSteps) currentStep++; }
    private void PrevStep() { if (currentStep > 1) currentStep--; }

    private async Task Complete()
    {
        AppSettings.DefaultBroker = primaryBroker;
        AppSettings.DefaultDataFeed = "Polygon";
        AppSettings.LlmVotingEnabled = enableLlm;
        AppSettings.Save(StorageProvider);

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            var keys = await UserKeyService.GetOrCreateAsync(userId);
            keys.AlpacaApiKeyId     = alpacaKeyId;
            keys.AlpacaApiSecretKey = alpacaSecret;
            keys.AlpacaIsPaper      = usePaperTrading;
            keys.IbkrUsePaper       = usePaperTrading;
            keys.PolygonApiKey      = polygonKey;
            keys.ClaudeApiKey       = claudeKey;
            keys.LlmVotingEnabled   = enableLlm;
            await UserKeyService.SaveAsync(userId, keys);
        }

        Nav.NavigateTo("/");
    }
}
