@using IdiotProof.Models
@using IdiotProof.Scripting

@*
    StrategyBuilderRenderer — standalone visual flow-chart for an IdiotScript
    strategy. Reusable in three places:
      1. Strategy Builder tab (preview pane while authoring)
      2. Strategies-as-home page (expand-row inline preview)
      3. Learning Center wikilinks ([[Stock.Ticker(...)]] inlines)

    Renders one card per phase (Setup / Filters / Entry / Order / Risk / Exit)
    with chips for each item in that phase. Branching blocks render nested
    inside Entry as If/ElseIf/Else columns. A sequenced strategy renders one
    card group per step with a "Then when" connector between them.

    Read-only — editing is the StrategyBuilder.razor page's job. This component
    is intentionally pure render so it can be embedded anywhere prose lives.
*@

@if (Strategy is null)
{
    @if (!string.IsNullOrEmpty(EmptyMessage))
    {
        <div class="text-muted small">@EmptyMessage</div>
    }
}
else
{
    <div class="strategy-renderer @CssClass">
        @{ var steps = Strategy.AllSteps().ToList(); }
        @foreach (var (step, stepIndex) in steps.Select((s, i) => (s, i)))
        {
            @if (Strategy.IsSequence)
            {
                <div class="step-header" data-cy="step-header">
                    <span class="strategy-chip step-chip">
                        <i class="bi bi-signpost-split" aria-hidden="true"></i>
                        Step @(stepIndex + 1)/@steps.Count@(string.IsNullOrEmpty(step.StepName) ? "" : $" \"{step.StepName}\"")
                    </span>
                </div>
            }
            <div class="step-group" aria-label="@(Strategy.IsSequence ? $"Step {stepIndex + 1} of {steps.Count}" : "Strategy")">
        <!-- SETUP -->
        <section class="strategy-phase" aria-label="Setup phase">
            <div class="phase-header">
                <span class="phase-number">1</span>
                <h3 class="phase-title">Setup</h3>
            </div>
            <div class="phase-body">
                <span class="strategy-chip ticker-chip">
                    <i class="bi bi-tag-fill" aria-hidden="true"></i>
                    @(string.IsNullOrEmpty(step.Symbol) ? "<symbol>" : step.Symbol)
                </span>
                <span class="strategy-chip">Session: @step.Session</span>
                @if (step.Quantity > 0)
                {
                    <span class="strategy-chip">Qty: @step.Quantity</span>
                }
                else if (step.NotionalAmount is { } setupNotional)
                {
                    @* Every gapper sizes by dollars — omitting this rendered
                       the flagship strategy with NO sizing at all. *@
                    <span class="strategy-chip">Size: $@setupNotional</span>
                }
            </div>
        </section>

        @{ var filterConds = step.EntryConditions.Where(c => c.Phase == StrategyPhase.Filters).ToList(); }
        @if (filterConds.Count > 0)
        {
            <!-- FILTERS -->
            <section class="strategy-phase" aria-label="Filters phase">
                <div class="phase-header">
                    <span class="phase-number">2</span>
                    <h3 class="phase-title">Filters</h3>
                    <span class="phase-hint">always-on regime gates</span>
                </div>
                <div class="phase-body">
                    @foreach (var c in filterConds)
                    {
                        <span class="strategy-chip filter-chip">@c.ToScript()</span>
                    }
                </div>
            </section>
        }

        @{ var entryConds = step.EntryConditions.Where(c => c.Phase == StrategyPhase.Entry).ToList(); }
        @if (entryConds.Count > 0 || step.ConditionalBlocks.Count > 0)
        {
            <!-- ENTRY -->
            <section class="strategy-phase" aria-label="Entry phase">
                <div class="phase-header">
                    <span class="phase-number">3</span>
                    <h3 class="phase-title">Entry</h3>
                    <span class="phase-hint">trigger conditions (AND)</span>
                </div>
                <div class="phase-body">
                    @foreach (var c in entryConds)
                    {
                        <span class="strategy-chip entry-chip">@c.ToScript()</span>
                    }
                    @if (step.ConditionalBlocks.Count > 0)
                    {
                        <div class="branching-block">
                            @foreach (var block in step.ConditionalBlocks)
                            {
                                <div class="branch-tree">
                                    @foreach (var (branch, idx) in block.Branches.Select((b, i) => (b, i)))
                                    {
                                        var label = idx == 0 ? "If" : (branch.Condition is null ? "Else" : "ElseIf");
                                        <div class="branch-node">
                                            <div class="branch-label">@label</div>
                                            @if (branch.Condition is not null)
                                            {
                                                <div class="branch-condition">@branch.Condition.ToScript()</div>
                                            }
                                            <div class="branch-actions">
                                                @if (branch.Overrides.Direction.HasValue)
                                                {
                                                    <span class="strategy-chip @(branch.Overrides.Direction == TradeDirection.Long ? "long-chip" : "short-chip")">
                                                        @(branch.Overrides.Direction == TradeDirection.Long ? "Long" : "Short")
                                                    </span>
                                                }
                                                @if (branch.Overrides.TakeProfitPrice.HasValue)
                                                {
                                                    <span class="strategy-chip target-chip">TP @branch.Overrides.TakeProfitPrice</span>
                                                }
                                                @if (branch.Overrides.StopLossPrice.HasValue)
                                                {
                                                    <span class="strategy-chip stop-chip">Stop @branch.Overrides.StopLossPrice</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        <!-- ORDER -->
        <section class="strategy-phase" aria-label="Order phase">
            <div class="phase-header">
                <span class="phase-number">4</span>
                <h3 class="phase-title">Order</h3>
            </div>
            <div class="phase-body">
                <span class="strategy-chip @(step.Direction == TradeDirection.Long ? "long-chip" : "short-chip")">
                    <i class="bi @(step.Direction == TradeDirection.Long ? "bi-arrow-up-circle-fill" : "bi-arrow-down-circle-fill")" aria-hidden="true"></i>
                    @(step.Direction == TradeDirection.Long ? "Long" : "Short")
                </span>
                @if (step.Quantity > 0)
                {
                    <span class="strategy-chip">@step.Quantity shares</span>
                }
                else if (step.NotionalAmount is { } orderNotional)
                {
                    <span class="strategy-chip">$@orderNotional notional</span>
                }
            </div>
        </section>

        @if (step.StopLossPrice.HasValue || step.StopLossPercent.HasValue || step.TrailingStopPercent.HasValue)
        {
            <!-- RISK -->
            <section class="strategy-phase" aria-label="Risk phase">
                <div class="phase-header">
                    <span class="phase-number">5</span>
                    <h3 class="phase-title">Risk</h3>
                </div>
                <div class="phase-body">
                    @if (step.StopLossPrice.HasValue)
                    {
                        <span class="strategy-chip stop-chip">Stop @step.StopLossPrice</span>
                    }
                    @if (step.StopLossPercent.HasValue)
                    {
                        <span class="strategy-chip stop-chip">Stop @step.StopLossPercent%</span>
                    }
                    @if (step.TrailingStopPercent.HasValue)
                    {
                        <span class="strategy-chip">Trail @step.TrailingStopPercent%</span>
                    }
                </div>
            </section>
        }

        @if (step.TakeProfitPrice.HasValue || step.TakeProfitTargets.Count > 0 || step.ExitTime.HasValue || step.PeakGivebackPercent.HasValue)
        {
            <!-- EXIT -->
            <section class="strategy-phase" aria-label="Exit phase">
                <div class="phase-header">
                    <span class="phase-number">6</span>
                    <h3 class="phase-title">Exit</h3>
                </div>
                <div class="phase-body">
                    @if (step.TakeProfitTargets.Count > 0)
                    {
                        @foreach (var t in step.TakeProfitTargets)
                        {
                            <span class="strategy-chip target-chip">@t.Label: @t.Price (@t.PercentToSell%)</span>
                        }
                    }
                    else if (step.TakeProfitPrice.HasValue)
                    {
                        <span class="strategy-chip target-chip">Target @step.TakeProfitPrice</span>
                    }
                    @if (step.PeakGivebackPercent is { } giveback)
                    {
                        @* The gapper's signature momentum-rollover exit — was
                           invisible in every preview before this chip. *@
                        <span class="strategy-chip target-chip">
                            Giveback @giveback%@(step.PeakGivebackArmTime is { } arm ? $" armed {arm:hh\\:mm} ET" : "")
                        </span>
                    }
                    @if (step.ExitTime.HasValue)
                    {
                        <span class="strategy-chip">Time exit @step.ExitTime</span>
                    }
                </div>
            </section>
        }
            </div>

            @if (stepIndex + 1 < steps.Count)
            {
                <!-- THEN WHEN: the transition to the next step, watched only while flat after this step's exit -->
                <section class="strategy-phase transition-phase" aria-label="Transition to step @(stepIndex + 2)" data-cy="then-when">
                    <div class="phase-header">
                        <span class="phase-number"><i class="bi bi-arrow-down" aria-hidden="true"></i></span>
                        <h3 class="phase-title">Then when</h3>
                        <span class="phase-hint">after this step exits</span>
                    </div>
                    <div class="phase-body">
                        @if (step.ThenWhen.Count == 0)
                        {
                            <span class="strategy-chip">right away</span>
                        }
                        @foreach (var c in step.ThenWhen)
                        {
                            <span class="strategy-chip entry-chip">@c.ToScript()</span>
                        }
                        @if (step.ThenWithinDays is { } days)
                        {
                            <span class="strategy-chip">within @days day@(days == 1 ? "" : "s")</span>
                        }
                    </div>
                </section>
            }
        }
    </div>
}

@code {
    /// <summary>
    /// The strategy to render. When null, renders nothing (or EmptyMessage if set).
    /// </summary>
    [Parameter] public StrategyDefinition? Strategy { get; set; }

    /// <summary>Optional message shown when Strategy is null.</summary>
    [Parameter] public string? EmptyMessage { get; set; }

    /// <summary>Extra CSS classes applied to the root .strategy-renderer element.</summary>
    [Parameter] public string CssClass { get; set; } = "";
}
