@rendermode InteractiveServer
@using IdiotProof.Blazor.Data
@using IdiotProof.Blazor.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject UserPreferencesService Prefs
@inject StrategyRepository StrategyRepo
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

@*
    BuilderTabBar — Chrome-style tab strip across the top of the Strategy
    Builder. Each tab is either:

      • An existing strategy (key = strategy guid) showing the strategy's title
      • A blank draft (key = "new") showing "New strategy"

    The active tab is the one matching the page's current ?strategyId= query
    string (or "new" if no query param). Clicking a tab navigates to the
    matching /builder URL; clicking the X removes the tab from the list and,
    if it was active, navigates to the next remaining tab (or /strategies if
    none are left).

    Tab order persists to UserPreferences.OpenStrategyTabs (CSV) and is
    mirrored to localStorage for SSR pre-paint. The Strategies-page Edit
    button calls into AddTabForStrategyAsync before navigating so a fresh
    edit always lands on a registered tab.
*@

<div class="builder-tabbar d-flex align-items-center gap-1 mb-3" role="tablist" aria-label="Open strategy tabs">
    @foreach (var tab in tabs)
    {
        var isActive = tab.Key == activeKey;
        var displayTitle = string.IsNullOrEmpty(tab.Title) ? "New strategy" : tab.Title;
        <button type="button"
                class="builder-tab @(isActive ? "active" : "")"
                role="tab"
                aria-selected="@isActive"
                aria-label="@(isActive ? $"{displayTitle} (current tab)" : $"Switch to {displayTitle}")"
                @onclick="() => SwitchTo(tab.Key)">
            <span class="builder-tab-title">@displayTitle</span>
            <span class="builder-tab-close"
                  role="button"
                  tabindex="0"
                  aria-label="Close @displayTitle tab"
                  @onclick="() => CloseTab(tab.Key)"
                  @onclick:stopPropagation="true"
                  @onkeydown="(e) => OnCloseKey(e, tab.Key)"
                  @onkeydown:stopPropagation="true">
                <i class="bi bi-x" aria-hidden="true"></i>
            </span>
        </button>
    }
    <button type="button"
            class="builder-tab-new"
            aria-label="New strategy tab"
            @onclick="OpenNewDraft">
        <i class="bi bi-plus" aria-hidden="true"></i> New
    </button>
</div>

@code {
    /// <summary>
    /// The currently active strategy id, passed from the parent page via the
    /// ?strategyId= query parameter. Null/empty means the user is on a fresh
    /// "new" draft tab.
    /// </summary>
    [Parameter] public Guid? ActiveStrategyId { get; set; }

    private List<TabEntry> tabs = new();
    private string? userId;
    private string activeKey = "new";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        await ReloadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Re-resolve which tab is active whenever the parent passes a new id.
        activeKey = ActiveStrategyId.HasValue ? ActiveStrategyId.Value.ToString() : "new";

        // If the active tab isn't in the list yet, register it. Common for
        // direct-link navigation (Strategies-page Edit, bookmarked URL).
        if (userId is not null && tabs.Count > 0 && !tabs.Any(t => t.Key == activeKey))
        {
            await AddCurrentToTabsAsync();
        }
    }

    private async Task ReloadAsync()
    {
        if (userId is null) return;

        var keys = await Prefs.GetOpenTabsAsync(userId);

        // Always have at least one tab — either the active one, or a default "new".
        if (keys.Count == 0)
        {
            keys.Add(activeKey);
            await Prefs.AddOpenTabAsync(userId, activeKey);
        }

        // Resolve titles for guid keys (look up in Strategies repo); "new" → blank.
        var resolved = new List<TabEntry>(keys.Count);
        foreach (var key in keys)
        {
            if (key == "new")
            {
                resolved.Add(new TabEntry(key, ""));
            }
            else if (Guid.TryParse(key, out var id))
            {
                var s = await StrategyRepo.GetByIdAsync(id);
                if (s is null)
                {
                    // Strategy was deleted — drop it from the open list silently
                    // rather than render a broken chip.
                    await Prefs.RemoveOpenTabAsync(userId, key);
                    continue;
                }
                resolved.Add(new TabEntry(key, s.Title));
            }
        }

        tabs = resolved;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "idiotproof.openTabs", string.Join(",", keys)); }
        catch { /* SSR — JS not available */ }
    }

    private async Task AddCurrentToTabsAsync()
    {
        if (userId is null) return;
        var added = await Prefs.AddOpenTabAsync(userId, activeKey);
        await ReloadAsync();
    }

    private void SwitchTo(string key)
    {
        // Build the URL for that tab. "new" goes to /builder with no query;
        // any other key goes to /builder?strategyId=guid.
        var url = key == "new" ? "/builder" : $"/builder?strategyId={key}";
        Nav.NavigateTo(url);
    }

    private async Task OpenNewDraft()
    {
        if (userId is null) { Nav.NavigateTo("/builder"); return; }
        await Prefs.AddOpenTabAsync(userId, "new");
        Nav.NavigateTo("/builder");
    }

    private async Task CloseTab(string key)
    {
        if (userId is null) return;
        var remaining = await Prefs.RemoveOpenTabAsync(userId, key);
        await ReloadAsync();

        // If the user closed the active tab, navigate somewhere sensible.
        if (key == activeKey)
        {
            if (remaining.Count == 0) Nav.NavigateTo("/strategies");
            else                      SwitchTo(remaining[0]);
        }
    }

    /// <summary>
    /// Keyboard accessibility for the close-tab "X". Enter and Space both
    /// trigger close — matches WAI-ARIA's button pattern for elements that
    /// aren't real <c>button</c> tags.
    /// </summary>
    private async Task OnCloseKey(KeyboardEventArgs e, string key)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            await CloseTab(key);
        }
    }

    /// <summary>Internal projection of an open tab — public because record's auto-generated == operator forces it.</summary>
    public sealed record TabEntry(string Key, string Title);
}
