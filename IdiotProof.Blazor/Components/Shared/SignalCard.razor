@using IdiotProof.Blazor.Services

<article class="trading-card p-3 mb-2 signal-card @(Signal.Direction == TradeDirection.Long ? "signal-card-long" : "signal-card-short")"
         aria-label="@Signal.Direction signal for @Signal.Symbol from @Signal.StrategyName at @Signal.ConfidencePercent.ToString("0")% confidence">
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div>
            <span class="fw-bold text-white me-2">@Signal.Symbol</span>
            @if (Signal.Direction == TradeDirection.Long)
            {
                <span class="badge bg-success signal-long" aria-label="Long position">
                    <i class="bi bi-triangle-fill me-1" style="font-size:0.55rem" aria-hidden="true"></i>Long
                </span>
            }
            else
            {
                <span class="badge bg-danger signal-short" aria-label="Short position">
                    <i class="bi bi-triangle-fill me-1" style="font-size:0.55rem;transform:rotate(180deg);display:inline-block" aria-hidden="true"></i>Short
                </span>
            }
            <span class="text-muted small ms-2">@Signal.StrategyName</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <time class="text-muted small" datetime="@Signal.GeneratedUtc.ToString("o")">@Signal.GeneratedUtc.ToString("HH:mm:ss")</time>
            @if (OnExecute.HasDelegate)
            {
                <button class="btn btn-sm btn-outline-success py-0 px-2"
                        type="button"
                        aria-label="Execute @Signal.Direction trade for @Signal.Symbol"
                        @onclick="() => OnExecute.InvokeAsync(Signal)">
                    <i class="bi bi-play-fill me-1" style="font-size:0.7rem" aria-hidden="true"></i>Execute
                </button>
            }
        </div>
    </div>

    <!-- Confidence Bar -->
    <div class="mb-2">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="text-muted" style="font-size:0.7rem" id="conf-label-@Signal.Symbol-@Signal.GeneratedUtc.Ticks">Confidence</span>
            <span class="text-white small fw-semibold" aria-hidden="true">@Signal.ConfidencePercent.ToString("0")%</span>
        </div>
        <div class="confidence-bar-wrapper"
             role="progressbar"
             aria-valuenow="@((int)Signal.ConfidencePercent)"
             aria-valuemin="0"
             aria-valuemax="100"
             aria-labelledby="conf-label-@Signal.Symbol-@Signal.GeneratedUtc.Ticks"
             aria-valuetext="@Signal.ConfidencePercent.ToString("0") percent">
            <div class="confidence-bar @ConfidenceColor" style="width:@(Signal.ConfidencePercent)%"></div>
        </div>
    </div>

    <!-- Price Levels -->
    <dl class="d-flex gap-3 mb-2">
        <div>
            <dt class="text-muted" style="font-size:0.65rem">Entry</dt>
            <dd class="text-white small mb-0">$@Signal.SuggestedEntry.ToString("0.00")</dd>
        </div>
        <div>
            <dt class="text-muted" style="font-size:0.65rem">Stop</dt>
            <dd class="text-red small mb-0">$@Signal.SuggestedStop.ToString("0.00")</dd>
        </div>
        @foreach (var (target, i) in Signal.Targets.Select((t, i) => (t, i + 1)).Take(2))
        {
            <div>
                <dt class="text-muted" style="font-size:0.65rem" aria-label="Target @i">T@i</dt>
                <dd class="text-green small mb-0">$@target.ToString("0.00")</dd>
            </div>
        }
    </dl>

    @if (!string.IsNullOrEmpty(Signal.Reason))
    {
        <div class="text-muted small mb-2" style="font-size:0.7rem;font-style:italic">@Signal.Reason</div>
    }

    <!-- LLM Voting Result -->
    @if (VotingResult != null && VotingResult.Votes.Any())
    {
        <section class="border-top border-dark pt-2 mt-1" aria-label="AI consensus voting result">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted" style="font-size:0.65rem">
                    <i class="bi bi-robot me-1" aria-hidden="true"></i>AI Consensus
                </span>
                <span class="badge @ConsensusClass small"
                      aria-label="Consensus: @VotingResult.Consensus at @VotingResult.ConsensusConfidence.ToString("0") percent confidence">
                    <span aria-hidden="true">@VotingResult.Consensus (@VotingResult.ConsensusConfidence.ToString("0")%)</span>
                </span>
            </div>
            <ul class="d-flex flex-wrap gap-1 list-unstyled mb-0">
                @foreach (var vote in VotingResult.Votes)
                {
                    <li class="border rounded px-2 py-1 @VoteClass(vote.Decision)"
                        style="font-size:0.65rem"
                        aria-label="@vote.ModelId voted @vote.Decision at @vote.Confidence.ToString("0") percent">
                        <span class="text-muted" aria-hidden="true">@vote.ModelId.Split('-').Last()</span>
                        <span class="ms-1 @VoteTextClass(vote.Decision)" aria-hidden="true">@vote.Decision (@vote.Confidence.ToString("0")%)</span>
                    </li>
                }
            </ul>
            @if (!string.IsNullOrEmpty(VotingResult.ConsensusReasoning))
            {
                <div class="text-muted mt-1" style="font-size:0.65rem;font-style:italic">
                    @(VotingResult.ConsensusReasoning.Length > 120
                        ? VotingResult.ConsensusReasoning[..117] + "..."
                        : VotingResult.ConsensusReasoning)
                </div>
            }
        </section>
    }
</article>

@code {
    [Parameter, EditorRequired] public TradeSignal Signal { get; set; } = null!;
    [Parameter] public LlmVotingResult? VotingResult { get; set; }
    [Parameter] public EventCallback<TradeSignal> OnExecute { get; set; }

    private string ConfidenceColor => Signal.ConfidencePercent >= 70 ? "confidence-bar-high"
        : Signal.ConfidencePercent >= 50 ? "confidence-bar-mid"
        : "confidence-bar-low";

    private string ConsensusClass => VotingResult?.Consensus switch
    {
        VoteDecision.Approve => "bg-success",
        VoteDecision.Reject => "bg-danger",
        _ => "bg-secondary"
    };

    private static string VoteClass(VoteDecision d) => d switch
    {
        VoteDecision.Approve => "border-success",
        VoteDecision.Reject => "border-danger",
        _ => "border-secondary"
    };

    private static string VoteTextClass(VoteDecision d) => d switch
    {
        VoteDecision.Approve => "text-green",
        VoteDecision.Reject => "text-red",
        _ => "text-muted"
    };
}
