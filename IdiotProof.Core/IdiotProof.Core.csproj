<Project Sdk="Microsoft.NET.Sdk">
  <!-- The one service graph every front door shares (HOUSE-LAW-6): the SQL model, migrations and
       every non-UI service. Blazor, the Hub, the Monitor and the ResearchScanner reference this;
       nothing references IdiotProof.Blazor. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IdiotProof.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IdiotProof.Blazor" />
    <InternalsVisibleTo Include="IdiotProof.Blazor.Tests" />
    <InternalsVisibleTo Include="IdiotProof.Monitor.Tests" />
    <InternalsVisibleTo Include="IdiotProof.Core.Tests" />
    <!-- The Monitor exe (assembly idiotproof-monitor) and the Hub host the worker and the operator commands. -->
    <InternalsVisibleTo Include="idiotproof-monitor" />
    <InternalsVisibleTo Include="IdiotProof.Hub" />
    <InternalsVisibleTo Include="IdiotProof.Operations" />
  </ItemGroup>
  <ItemGroup>
    <!-- The implicit usings the services had under the Web SDK, so they move without edits. -->
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <!-- DataProtection, hosting and the authentication entities come from the shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MindAttic.Authentication" Version="6.0.0" />
    <!-- The shared Data Protection key ring's production shape (Blob + Key Vault). -->
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.3" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.3" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <!-- Microsoft.Data.SqlClient (via EFCore.SqlServer) pins this transitively at 10.0.7, inside
         the vulnerable range for CVE-2026-50527 (NU1903); first patched in 10.0.10. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <!-- Premarket-fade alert emailing (EmailSmsAlertSender) — same email-to-SMS gateway approach as
         MindAttic.Psst, without that assembly's net10.0-windows sound-effect dependency. -->
    <PackageReference Include="MailKit" Version="4.16.0" />
    <!-- User-facing files (replay pages, ML dataset) go through ArtifactWriter. -->
    <PackageReference Include="MindAttic.Export" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Static JSON catalogs (IP-LAW-7) ship to {app}/data/ of every host that references Core. -->
    <None Include="Catalogs\*.json" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IdiotProof.Shared\IdiotProof.Shared.csproj" />
    <ProjectReference Include="..\IdiotProof.Scripting\IdiotProof.Scripting.csproj" />
    <ProjectReference Include="..\IdiotProof.Models\IdiotProof.Models.csproj" />
    <ProjectReference Include="..\IdiotProof.Engine\IdiotProof.Engine.csproj" />
    <ProjectReference Include="..\IdiotProof.Strategies\IdiotProof.Strategies.csproj" />
    <ProjectReference Include="..\IdiotProof.Indicators\IdiotProof.Indicators.csproj" />
    <ProjectReference Include="..\IdiotProof.Brokers\IdiotProof.Brokers.csproj" />
    <ProjectReference Include="..\IdiotProof.DataFeeds\IdiotProof.DataFeeds.csproj" />
  </ItemGroup>
</Project>
