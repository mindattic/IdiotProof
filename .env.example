# Local dev autofill — loaded at startup only when ASPNETCORE_ENVIRONMENT=Development.
# Copy this file to %APPDATA%\MindAttic\IdiotProof\.env (outside the repo, never
# committed) and fill in your values. The Login page prefills these into the
# email/password inputs so you don't retype every run. Has no effect in any
# non-Development build.

DEV_USERNAME=you@example.com
DEV_PASSWORD=change-me
