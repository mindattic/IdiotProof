<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IdiotProof.ResearchScanner</RootNamespace>
    <AssemblyName>idiotproof-research-scanner</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legion voter-panel config (repo root) — same reasoning as IdiotProof.Monitor.csproj:
         a deployed host has no repo checkout, so ship the file with the binaries. -->
    <Content Include="..\legion.json" Link="legion.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared service graph (research services, SQL model); never the web project. -->
    <ProjectReference Include="..\IdiotProof.Core\IdiotProof.Core.csproj" />
  </ItemGroup>

</Project>
