<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IdiotProof.ResearchScanner</RootNamespace>
    <AssemblyName>idiotproof-research-scanner</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <!-- Same CVE-2026-50527 pin as IdiotProof.Monitor.csproj — see that file's comment. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legion voter-panel config (repo root) — same reasoning as IdiotProof.Monitor.csproj:
         a deployed host has no repo checkout, so ship the file with the binaries. -->
    <Content Include="..\legion.json" Link="legion.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Hand-maintained S&P index add/delete log read by IndexEventScanner (single source: the web host's wwwroot copy). -->
    <Content Include="..\IdiotProof.Blazor\wwwroot\data\sp-index-events.json" Link="data\sp-index-events.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IdiotProof.Engine\IdiotProof.Engine.csproj" />
    <ProjectReference Include="..\IdiotProof.Blazor\IdiotProof.Blazor.csproj" />
  </ItemGroup>

</Project>
