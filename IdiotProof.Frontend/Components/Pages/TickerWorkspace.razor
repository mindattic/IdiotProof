@page "/workspaces"
@page "/workspace/{TabId}"
@rendermode InteractiveServer
@inject WorkspaceManager WorkspaceManager
@inject TradingStateService TradingState
@inject UserKeyService UserKeyService
@inject StrategyRegistry StrategyRegistry
@inject AppSettings AppSettings
@inject AuditLogger AuditLogger
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Workspaces — IdiotProof</PageTitle>

@if (string.IsNullOrEmpty(TabId))
{
    <!-- Workspace List View -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0 text-white">
            <i class="bi bi-layers me-2" style="color:var(--blue)"></i>Workspaces
        </h4>
        <button class="btn btn-success btn-sm" @onclick="ShowNewWorkspaceModal">
            <i class="bi bi-plus-circle me-1"></i>New Workspace
        </button>
    </div>

    <div class="row g-3">
        @foreach (var tab in userTabs)
        {
            <div class="col-md-6 col-lg-4">
                <div class="trading-card p-3 h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="text-white mb-0">@tab.Name</h6>
                        <div class="d-flex gap-1">
                            <a href="/workspace/@tab.TabId" class="btn btn-sm btn-outline-success">Open</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteWorkspace(tab.TabId)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                    <div class="text-muted small mb-2">
                        Created @tab.CreatedUtc.ToString("MMM d, yyyy")
                    </div>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        @foreach (var sym in tab.Watchlist.Take(5))
                        {
                            <span class="badge bg-dark border border-secondary">@sym</span>
                        }
                        @if (tab.Watchlist.Count > 5)
                        {
                            <span class="badge bg-secondary">+@(tab.Watchlist.Count - 5)</span>
                        }
                        @if (!tab.Watchlist.Any())
                        {
                            <span class="text-muted" style="font-size:0.75rem">No tickers</span>
                        }
                    </div>
                    <div class="small text-muted">
                        @tab.Strategies.Count(s => s.Enabled) active strategies &bull;
                        @if (tab.Settings.AutoTrade)
                        {
                            <span class="text-green">Auto-Trade ON</span>
                        }
                        else
                        {
                            <span>Manual</span>
                        }
                    </div>
                </div>
            </div>
        }
        @if (!userTabs.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-layers fs-1 d-block mb-3"></i>
                No workspaces yet. Create one to get started.
            </div>
        }
    </div>

    <!-- New Workspace Modal -->
    @if (showNewModal)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark border-secondary">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title text-white">New Workspace</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => showNewModal = false"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label text-muted small">Workspace Name</label>
                        <input class="form-control bg-dark text-white border-secondary"
                               placeholder="e.g. Momentum Plays"
                               @bind="newWorkspaceName"
                               @onkeydown="OnNewWorkspaceKeyDown" />
                    </div>
                    <div class="modal-footer border-secondary">
                        <button class="btn btn-secondary" @onclick="() => showNewModal = false">Cancel</button>
                        <button class="btn btn-success" @onclick="CreateWorkspace">Create</button>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <!-- Single Workspace View -->
    @if (currentTab == null)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-exclamation-circle fs-1 d-block mb-3"></i>
            Workspace not found. <a href="/workspaces">Back to workspaces</a>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-2">
                <a href="/workspaces" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
                </a>
                @if (editingName)
                {
                    <input class="form-control form-control-sm bg-dark text-white border-secondary"
                           style="width:200px"
                           @bind="editNameValue"
                           @onblur="SaveName"
                           @onkeydown="OnNameKeyDown" />
                }
                else
                {
                    <h4 class="mb-0 text-white" @ondblclick="StartEditName" style="cursor:pointer" title="Double-click to rename">
                        @currentTab.Name <i class="bi bi-pencil text-muted" style="font-size:0.7rem"></i>
                    </h4>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                <!-- Auto-Trade Toggle -->
                <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
                    <label class="form-check-label text-muted small" for="autoTradeSwitch">Auto-Trade</label>
                    <input class="form-check-input" type="checkbox" id="autoTradeSwitch"
                           checked="@currentTab.Settings.AutoTrade"
                           @onchange="OnAutoTradeToggle" />
                    @if (currentTab.Settings.AutoTrade)
                    {
                        <span class="badge bg-danger">LIVE</span>
                    }
                </div>
            </div>
        </div>

        <!-- Watchlist + Broker Selectors -->
        <div class="trading-card p-3 mb-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label text-muted small">Watchlist</label>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        @foreach (var sym in currentTab.Watchlist)
                        {
                            <span class="badge bg-dark border border-secondary d-flex align-items-center gap-1">
                                @sym
                                <button class="btn btn-sm p-0 text-danger" style="line-height:1" @onclick="() => RemoveTicker(sym)">
                                    <i class="bi bi-x" style="font-size:0.8rem"></i>
                                </button>
                            </span>
                        }
                    </div>
                    <div class="input-group input-group-sm">
                        <input class="form-control bg-dark text-white border-secondary"
                               placeholder="Add ticker..."
                               @bind="newTickerInput"
                               @onkeydown="OnAddTickerKeyDown" />
                        <button class="btn btn-outline-success" @onclick="AddTicker">+</button>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small">Broker</label>
                    <select class="form-select form-select-sm bg-dark text-white border-secondary"
                            @bind="currentTab.BrokerOverride"
                            @bind:after="SaveTab">
                        <option value="">Default (@AppSettings.DefaultBroker)</option>
                        <option value="Sandbox">Sandbox</option>
                        <option value="Alpaca">Alpaca</option>
                        <option value="Ibkr">IBKR</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small">Data Feed</label>
                    <select class="form-select form-select-sm bg-dark text-white border-secondary"
                            @bind="currentTab.DataFeedOverride"
                            @bind:after="SaveTab">
                        <option value="">Default (@AppSettings.DefaultDataFeed)</option>
                        <option value="Polygon">Polygon</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Risk Parameters (collapsible) -->
        <div class="trading-card p-3 mb-3">
            <button class="btn btn-sm btn-link text-muted p-0 d-flex align-items-center gap-1" @onclick="() => riskExpanded = !riskExpanded">
                <i class="bi @(riskExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                <span class="small">Risk Parameters</span>
            </button>
            @if (riskExpanded)
            {
                <div class="row g-2 mt-2">
                    <div class="col-md-3">
                        <label class="form-label text-muted" style="font-size:0.7rem">Max Position Size ($)</label>
                        <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary"
                               @bind="currentTab.Settings.MaxPositionSize"
                               @bind:after="SaveTab" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted" style="font-size:0.7rem">Max Loss / Trade ($)</label>
                        <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary"
                               @bind="currentTab.Settings.RiskLimits.MaxLossPerTrade"
                               @bind:after="SaveTab" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted" style="font-size:0.7rem">Max Loss / Day ($)</label>
                        <input type="number" class="form-control form-control-sm bg-dark text-white border-secondary"
                               @bind="currentTab.Settings.RiskLimits.MaxLossPerDay"
                               @bind:after="SaveTab" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted" style="font-size:0.7rem">Allowed Sessions</label>
                        <select class="form-select form-select-sm bg-dark text-white border-secondary"
                                @bind="currentTab.Settings.AllowedSessions"
                                @bind:after="SaveTab">
                            @foreach (var session in Enum.GetValues<TradingSession>())
                            {
                                <option value="@session">@session</option>
                            }
                        </select>
                    </div>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(orderFeedback))
        {
            <div class="alert alert-info small py-2 mb-3">@orderFeedback</div>
        }

        <!-- Per-Ticker Tabs -->
        @if (!currentTab.Watchlist.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-search fs-1 d-block mb-3"></i>
                Add tickers to the watchlist to see strategy signals.
            </div>
        }
        else
        {
            <ul class="nav nav-tabs mb-3" style="border-color:var(--border)">
                @foreach (var sym in currentTab.Watchlist)
                {
                    <li class="nav-item">
                        <button class="nav-link @(selectedTicker == sym ? "active" : "")"
                                style="@(selectedTicker == sym ? "background:var(--bg-card);border-color:var(--border);color:var(--text-primary)" : "color:var(--text-muted)")"
                                @onclick="() => selectedTicker = sym">
                            @sym
                            @if (TradingState.LivePrices.TryGetValue(sym, out var lp))
                            {
                                <span class="ms-1 text-muted small">$@lp.Price.ToString("0.00")</span>
                            }
                        </button>
                    </li>
                }
            </ul>

            @if (!string.IsNullOrEmpty(selectedTicker))
            {
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="trading-card p-3 mb-3">
                            @if (TradingState.LivePrices.TryGetValue(selectedTicker, out var price))
                            {
                                <PriceDisplay Symbol="@selectedTicker"
                                              Price="@price.Price"
                                              PriceChange="0"
                                              PriceChangePct="0" />
                            }
                            else
                            {
                                <div class="text-muted small">Price loading...</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-8">
                        <!-- Strategies for selected ticker -->
                        <div class="trading-card p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0 text-white">Strategies</h6>
                                <div class="d-flex gap-2 align-items-center">
                                    <select class="form-select form-select-sm bg-dark text-white border-secondary" style="width:auto" @bind="strategyToAdd">
                                        <option value="">Add strategy...</option>
                                        @foreach (var s in StrategyRegistry.GetAll())
                                        {
                                            <option value="@s.Name">@s.Name</option>
                                        }
                                    </select>
                                    <button class="btn btn-sm btn-outline-success" @onclick="AddStrategy">+</button>
                                </div>
                            </div>
                            @foreach (var binding in currentTab.Strategies)
                            {
                                <div class="border border-secondary rounded p-3 mb-2">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@binding.Enabled"
                                                   @onchange="(e) => ToggleStrategy(binding, (bool)(e.Value ?? false))" />
                                            <span class="text-white small fw-semibold">@binding.StrategyName</span>
                                        </div>
                                        <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => RemoveStrategy(binding)">
                                            <i class="bi bi-trash" style="font-size:0.7rem"></i>
                                        </button>
                                    </div>

                                    @{
                                        var signals = TradingState.GetSignalsFor(selectedTicker, userId)
                                            .Where(s => s.StrategyName == binding.StrategyName)
                                            .Take(1).ToList();
                                    }
                                    @if (signals.Any())
                                    {
                                        var sig = signals[0];
                                        TradingState.SignalVotes.TryGetValue(
                                            $"{sig.Symbol}_{sig.StrategyName}_{sig.GeneratedUtc:yyyyMMddHHmmss}",
                                            out var vote);
                                        <SignalCard Signal="@sig"
                                                    VotingResult="@vote"
                                                    OnExecute="@(EventCallback.Factory.Create<TradeSignal>(this, FireSignal))" />
                                    }
                                    else
                                    {
                                        <div class="text-muted" style="font-size:0.75rem">Waiting for next evaluation...</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    }

    <!-- Auto-Trade Confirm Modal -->
    @if (showAutoTradeModal)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark border-danger">
                    <div class="modal-header border-danger">
                        <h5 class="modal-title text-danger">
                            <i class="bi bi-exclamation-triangle me-2"></i>Enable Auto-Trade?
                        </h5>
                    </div>
                    <div class="modal-body text-white">
                        <p>Auto-trading will place <strong>real orders</strong> automatically when strategy signals are generated and approved by LLM voting.</p>
                        <p class="text-warning small">This uses real money. Ensure your broker is configured correctly and risk limits are set.</p>
                        <div class="alert alert-danger small">
                            <strong>Broker:</strong> @(currentTab?.BrokerOverride ?? AppSettings.DefaultBroker) &bull;
                            <strong>Max Loss/Trade:</strong> $@currentTab?.Settings.RiskLimits.MaxLossPerTrade.ToString("0")
                        </div>
                    </div>
                    <div class="modal-footer border-danger">
                        <button class="btn btn-secondary" @onclick="CancelAutoTrade">Cancel</button>
                        <button class="btn btn-danger" @onclick="ConfirmAutoTrade">Yes, Enable Auto-Trade</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public string? TabId { get; set; }

    private string userId = "";
    private IReadOnlyList<WorkspaceTab> userTabs = [];
    private WorkspaceTab? currentTab;
    private bool showNewModal;
    private bool showAutoTradeModal;
    private string newWorkspaceName = "";
    private string newTickerInput = "";
    private string selectedTicker = "";
    private string strategyToAdd = "";
    private bool editingName;
    private string editNameValue = "";
    private bool riskExpanded;
    private string? orderFeedback;
    private System.Threading.Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        userTabs = WorkspaceManager.GetTabsForUser(userId);

        refreshTimer = new System.Threading.Timer(_ =>
        {
            userTabs = WorkspaceManager.GetTabsForUser(userId);
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(TabId))
        {
            currentTab = WorkspaceManager.Get(userId, TabId);
            if (currentTab?.Watchlist.Any() == true && string.IsNullOrEmpty(selectedTicker))
                selectedTicker = currentTab.Watchlist[0];
        }
    }

    private void ShowNewWorkspaceModal() => showNewModal = true;

    private void OnNewWorkspaceKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") CreateWorkspace();
    }

    private void CreateWorkspace()
    {
        if (string.IsNullOrWhiteSpace(newWorkspaceName)) return;
        WorkspaceManager.Create(userId, newWorkspaceName.Trim());
        userTabs = WorkspaceManager.GetTabsForUser(userId);
        newWorkspaceName = "";
        showNewModal = false;
    }

    private void DeleteWorkspace(string tabId)
    {
        WorkspaceManager.Delete(userId, tabId);
        userTabs = WorkspaceManager.GetTabsForUser(userId);
    }

    private void StartEditName()
    {
        editNameValue = currentTab?.Name ?? "";
        editingName = true;
    }

    private void SaveName()
    {
        if (currentTab != null && !string.IsNullOrWhiteSpace(editNameValue))
        {
            currentTab.Name = editNameValue.Trim();
            WorkspaceManager.Save(userId, currentTab);
        }
        editingName = false;
    }

    private void OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SaveName();
        if (e.Key == "Escape") editingName = false;
    }

    private void AddTicker()
    {
        var sym = newTickerInput.Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(sym) || currentTab == null) return;
        if (!currentTab.Watchlist.Contains(sym))
        {
            currentTab.Watchlist.Add(sym);
            selectedTicker = sym;
            WorkspaceManager.Save(userId, currentTab);
        }
        newTickerInput = "";
    }

    private async Task OnAddTickerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { AddTicker(); await Task.CompletedTask; }
    }

    private void RemoveTicker(string sym)
    {
        if (currentTab == null) return;
        currentTab.Watchlist.Remove(sym);
        if (selectedTicker == sym)
            selectedTicker = currentTab.Watchlist.FirstOrDefault() ?? "";
        WorkspaceManager.Save(userId, currentTab);
    }

    private void AddStrategy()
    {
        if (string.IsNullOrEmpty(strategyToAdd) || currentTab == null) return;
        if (!currentTab.Strategies.Any(s => s.StrategyName == strategyToAdd))
        {
            currentTab.Strategies.Add(new StrategyBinding { StrategyName = strategyToAdd, Enabled = true });
            WorkspaceManager.Save(userId, currentTab);
        }
        strategyToAdd = "";
    }

    private void RemoveStrategy(StrategyBinding binding)
    {
        if (currentTab == null) return;
        currentTab.Strategies.Remove(binding);
        WorkspaceManager.Save(userId, currentTab);
    }

    private void ToggleStrategy(StrategyBinding binding, bool enabled)
    {
        binding.Enabled = enabled;
        if (currentTab != null) WorkspaceManager.Save(userId, currentTab);
    }

    private void OnAutoTradeToggle(ChangeEventArgs e)
    {
        var newVal = (bool)(e.Value ?? false);
        if (newVal && currentTab != null)
            showAutoTradeModal = true;
        else if (currentTab != null)
        {
            currentTab.Settings.AutoTrade = false;
            WorkspaceManager.Save(userId, currentTab);
        }
    }

    private void ConfirmAutoTrade()
    {
        if (currentTab != null)
        {
            currentTab.Settings.AutoTrade = true;
            WorkspaceManager.Save(userId, currentTab);
        }
        showAutoTradeModal = false;
    }

    private void CancelAutoTrade() => showAutoTradeModal = false;

    private void SaveTab()
    {
        if (currentTab != null)
            WorkspaceManager.Save(userId, currentTab);
    }

    private async Task FireSignal(TradeSignal signal)
    {
        orderFeedback = null;
        try
        {
            var keys = await UserKeyService.GetOrCreateAsync(userId);
            IBrokerClient broker = !string.IsNullOrWhiteSpace(keys.AlpacaApiKeyId)
                ? new AlpacaBrokerClient(keys.AlpacaApiKeyId, keys.AlpacaApiSecretKey ?? "", keys.AlpacaIsPaper)
                : new SandboxBrokerClient();

            var brokerName = !string.IsNullOrWhiteSpace(keys.AlpacaApiKeyId) ? "Alpaca" : "Sandbox";
            var request = new OrderRequest
            {
                Symbol = signal.Symbol,
                Quantity = 1,
                Side = signal.Direction == TradeDirection.Long ? OrderSide.Buy : OrderSide.Sell,
                Type = OrderType.Market,
                TimeInForce = "DAY"
            };

            var result = await broker.PlaceOrderAsync(request);
            AuditLogger.Log("MANUAL_TRADE", $"BrokerOrderId={result.BrokerOrderId} Symbol={signal.Symbol} Side={request.Side} Qty={request.Quantity} Strategy={signal.StrategyName}", signal.Symbol);
            orderFeedback = $"Order placed: {request.Side} {request.Quantity} {signal.Symbol} via {brokerName} (ID: {result.BrokerOrderId})";
        }
        catch (Exception ex)
        {
            AuditLogger.Log("MANUAL_TRADE_FAIL", $"Symbol={signal.Symbol} Error={ex.Message}", signal.Symbol);
            orderFeedback = $"Order failed: {ex.Message}";
        }
    }

    public void Dispose() => refreshTimer?.Dispose();
}
