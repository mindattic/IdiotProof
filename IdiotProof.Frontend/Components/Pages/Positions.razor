@page "/positions"
@rendermode InteractiveServer
@inject TradingStateService TradingState
@inject UserKeyService UserKeyService
@inject AuditLogger AuditLogger
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Positions — IdiotProof</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 text-white">
        <i class="bi bi-briefcase me-2" style="color:var(--blue)"></i>Open Positions
    </h4>
    <div class="d-flex gap-2 align-items-center">
        @if (lastRefreshed.HasValue)
        {
            <span class="text-muted small">Updated @lastRefreshed.Value.ToString("HH:mm:ss")</span>
        }
        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshPositions" disabled="@isRefreshing">
            <i class="bi bi-arrow-clockwise @(isRefreshing ? "spin" : "")"></i> Refresh
        </button>
    </div>
</div>

@if (allPositions.Count == 0 && !isRefreshing)
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-briefcase fs-1 d-block mb-3"></i>
        <div class="mb-2">No open positions</div>
        <a href="/workspaces" class="btn btn-outline-secondary btn-sm">Go to Workspaces</a>
    </div>
}
else
{
    @foreach (var brokerGroup in TradingState.GetPositionsForUser(userId))
    {
        <div class="trading-card p-3 mb-3">
            <h6 class="text-white mb-3">
                <i class="bi bi-building me-1"></i>@brokerGroup.Key
                <span class="badge bg-secondary ms-1">@brokerGroup.Value.Count</span>
            </h6>
            <div class="table-responsive">
                <table class="table table-sm table-dark table-hover mb-0">
                    <thead>
                        <tr class="text-muted small">
                            <th>Symbol</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Avg Price</th>
                            <th class="text-end">Current</th>
                            <th class="text-end">P&L ($)</th>
                            <th class="text-end">P&L (%)</th>
                            <th class="text-end">Value</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pos in brokerGroup.Value)
                        {
                            var pnlPct = pos.AveragePrice > 0 ? (pos.UnrealizedPnl / (pos.AveragePrice * pos.Quantity)) * 100 : 0;
                            var rowClass = pos.UnrealizedPnl >= 0 ? "text-green" : "text-red";
                            <tr>
                                <td class="fw-bold text-white">@pos.Symbol</td>
                                <td class="text-end text-white">@pos.Quantity</td>
                                <td class="text-end text-muted">$@pos.AveragePrice.ToString("0.00")</td>
                                <td class="text-end text-white">
                                    @if (TradingState.LivePrices.TryGetValue(pos.Symbol, out var lp))
                                    {
                                        @($"${lp.Price:0.00}")
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end @rowClass">
                                    @pos.UnrealizedPnl.ToString("+$0.00;-$0.00;$0.00")
                                </td>
                                <td class="text-end @rowClass">
                                    @pnlPct.ToString("+0.00;-0.00;0.00")%
                                </td>
                                <td class="text-end text-white">$@pos.MarketValue.ToString("0.00")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger py-0"
                                            @onclick="() => ConfirmClose(brokerGroup.Key, pos)">
                                        Close
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Summary Footer -->
    <div class="trading-card p-3">
        <div class="d-flex justify-content-end gap-4">
            <div class="text-end">
                <div class="text-muted small">Total Market Value</div>
                <div class="text-white fw-bold">$@totalValue.ToString("0.00")</div>
            </div>
            <div class="text-end">
                <div class="text-muted small">Total Unrealized P&L</div>
                <div class="@(totalPnl >= 0 ? "text-green" : "text-red") fw-bold">
                    @totalPnl.ToString("+$0.00;-$0.00;$0.00")
                </div>
            </div>
        </div>
    </div>
}

<!-- Close Confirmation Modal -->
@if (positionToClose != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-danger">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-white">Close Position</h5>
                </div>
                <div class="modal-body text-white">
                    Close <strong>@positionToClose.Symbol</strong>? (@positionToClose.Quantity shares at avg $@positionToClose.AveragePrice.ToString("0.00"))
                </div>
                @if (!string.IsNullOrEmpty(closeError))
                {
                    <div class="alert alert-danger small py-1 mx-3">@closeError</div>
                }
                <div class="modal-footer border-secondary">
                    <button class="btn btn-secondary" @onclick="() => { positionToClose = null; closeError = null; }">Cancel</button>
                    <button class="btn btn-danger" @onclick="ClosePosition">Close Position</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string userId = "";
    private List<Position> allPositions = [];
    private decimal totalValue;
    private decimal totalPnl;
    private bool isRefreshing;
    private DateTime? lastRefreshed;
    private Position? positionToClose;
    private string? closeError;
    private System.Threading.Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        await RefreshPositions();
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await RefreshPositions();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task RefreshPositions()
    {
        isRefreshing = true;
        StateHasChanged();

        try
        {
            var keys = await UserKeyService.GetOrCreateAsync(userId);
            if (!string.IsNullOrWhiteSpace(keys.AlpacaApiKeyId))
            {
                try
                {
                    var broker = new AlpacaBrokerClient(keys.AlpacaApiKeyId, keys.AlpacaApiSecretKey ?? "", keys.AlpacaIsPaper);
                    var positions = await broker.GetPositionsAsync();
                    TradingState.UpdatePositions(userId, BrokerType.Alpaca, positions.ToList());
                }
                catch { /* broker not connected */ }
            }

            allPositions = TradingState.GetPositionsForUser(userId).Values.SelectMany(p => p).ToList();
            totalValue = allPositions.Sum(p => p.MarketValue);
            totalPnl = allPositions.Sum(p => p.UnrealizedPnl);
            lastRefreshed = DateTime.UtcNow;
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private void ConfirmClose(string broker, Position pos)
    {
        positionToClose = pos;
    }

    private async Task ClosePosition()
    {
        if (positionToClose == null) return;
        closeError = null;
        try
        {
            var keys = await UserKeyService.GetOrCreateAsync(userId);
            IBrokerClient broker = !string.IsNullOrWhiteSpace(keys.AlpacaApiKeyId)
                ? new AlpacaBrokerClient(keys.AlpacaApiKeyId, keys.AlpacaApiSecretKey ?? "", keys.AlpacaIsPaper)
                : new SandboxBrokerClient();

            var side = positionToClose.Quantity >= 0 ? OrderSide.Sell : OrderSide.Buy;
            var request = new OrderRequest
            {
                Symbol = positionToClose.Symbol,
                Quantity = Math.Abs(positionToClose.Quantity),
                Side = side,
                Type = OrderType.Market,
                TimeInForce = "DAY"
            };

            var result = await broker.PlaceOrderAsync(request);
            AuditLogger.Log("CLOSE_POSITION", $"BrokerOrderId={result.BrokerOrderId} Symbol={positionToClose.Symbol} Side={side} Qty={request.Quantity}", positionToClose.Symbol);

            if (!result.IsSuccess)
            {
                closeError = result.Message ?? "Broker rejected order.";
                return;
            }

            positionToClose = null;
            await RefreshPositions();
        }
        catch (Exception ex)
        {
            var sym = positionToClose?.Symbol ?? "?";
            AuditLogger.Log("CLOSE_POSITION_FAIL", $"Symbol={sym} Error={ex.Message}", sym);
            closeError = ex.Message;
        }
    }

    public void Dispose() => refreshTimer?.Dispose();
}
