@page "/register"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inject UserManager<AppUser> UserMgr
@inject SignInManager<AppUser> SignInMgr
@inject NavigationManager Nav
@layout EmptyLayout

<PageTitle>Create Account — IdiotProof</PageTitle>

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-logo">
            <span class="logo-icon">⚡</span>
            <h1>IdiotProof</h1>
            <p class="logo-sub">Create your free account</p>
        </div>

        @if (errors.Count > 0)
        {
            @foreach (var err in errors)
            {
                <div class="alert-error">@err</div>
            }
        }

        <div class="form-group">
            <label>Email</label>
            <input type="email" class="form-control" @bind="email" placeholder="you@example.com" />
        </div>
        <div class="form-group">
            <label>Password <span style="color:#6e7681;font-size:0.75rem">(8+ chars, one digit)</span></label>
            <input type="password" class="form-control" @bind="password" placeholder="Choose a strong password" />
        </div>
        <div class="form-group">
            <label>Confirm Password</label>
            <input type="password" class="form-control" @bind="confirm" placeholder="Repeat your password" />
        </div>

        <button class="btn-login" @onclick="Submit" disabled="@busy">
            @(busy ? "Creating account…" : "Create Account & Sign In")
        </button>

        <p class="login-warning" style="margin-top:1rem">
            Already have an account? <a href="/login" style="color:#79c0ff">Sign in</a>
        </p>
        <p class="login-warning">
            You'll enter your broker API keys after signing in. No credit card required.
        </p>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string confirm = "";
    private bool busy;
    private List<string> errors = [];

    private async Task Submit()
    {
        errors.Clear();

        if (string.IsNullOrWhiteSpace(email))        { errors.Add("Email is required."); return; }
        if (password != confirm)                      { errors.Add("Passwords do not match."); return; }
        if (password.Length < 8)                      { errors.Add("Password must be at least 8 characters."); return; }
        if (!password.Any(char.IsDigit))              { errors.Add("Password must contain at least one digit."); return; }

        busy = true;
        StateHasChanged();

        var user = new AppUser { UserName = email.Trim(), Email = email.Trim() };
        var result = await UserMgr.CreateAsync(user, password);

        if (result.Succeeded)
        {
            await SignInMgr.SignInAsync(user, isPersistent: true);
            Nav.NavigateTo("/api-keys", forceLoad: true);
        }
        else
        {
            errors = result.Errors.Select(e => e.Description).ToList();
            busy = false;
        }
    }
}

<style>
.login-wrapper { min-height:100vh; display:flex; align-items:center; justify-content:center; background:var(--bg-primary,#0d1117); }
.login-card { width:100%; max-width:400px; background:var(--bg-card,#1c2128); border:1px solid var(--border,#30363d); border-radius:12px; padding:2.5rem; }
.login-logo { text-align:center; margin-bottom:1.5rem; }
.logo-icon { font-size:2.5rem; }
.login-logo h1 { font-size:1.8rem; font-weight:700; color:#e6edf3; margin:0.25rem 0; }
.logo-sub { color:#8b949e; font-size:0.85rem; }
.alert-error { background:rgba(248,81,73,0.15); border:1px solid rgba(248,81,73,0.4); border-radius:6px; padding:0.75rem 1rem; font-size:0.85rem; color:#f85149; margin-bottom:0.75rem; }
.form-group { margin-bottom:1rem; }
.form-group label { display:block; color:#8b949e; font-size:0.85rem; margin-bottom:0.4rem; }
.form-control { width:100%; padding:0.6rem 0.85rem; background:#0d1117; border:1px solid #30363d; border-radius:6px; color:#e6edf3; font-size:1rem; box-sizing:border-box; }
.form-control:focus { outline:none; border-color:#388bfd; box-shadow:0 0 0 3px rgba(56,139,253,0.15); }
.btn-login { width:100%; padding:0.7rem; background:#238636; color:#fff; border:none; border-radius:6px; font-size:1rem; font-weight:600; cursor:pointer; transition:background 0.2s; margin-top:0.5rem; }
.btn-login:hover:not(:disabled) { background:#2ea043; }
.btn-login:disabled { opacity:0.6; cursor:not-allowed; }
.login-warning { margin-top:0.75rem; font-size:0.75rem; color:#6e7681; text-align:center; }
</style>
