@page "/"
@rendermode InteractiveServer
@inject TradingStateService TradingState
@inject WorkspaceManager WorkspaceManager
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>Dashboard — IdiotProof</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 text-white">
        <i class="bi bi-speedometer2 me-2" style="color:var(--green)"></i>Dashboard
    </h4>
    <span class="text-muted small">Auto-refreshes every 5s</span>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="trading-card p-3 text-center">
            <div class="text-muted small mb-1">Total Workspaces</div>
            <div class="fs-2 fw-bold text-white">@userTabs.Count</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="trading-card p-3 text-center">
            <div class="text-muted small mb-1">Active Strategies</div>
            <div class="fs-2 fw-bold text-white">@activeStrategies</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="trading-card p-3 text-center">
            <div class="text-muted small mb-1">Open Positions</div>
            <div class="fs-2 fw-bold text-white">@openPositions</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="trading-card p-3 text-center">
            <div class="text-muted small mb-1">Today's P&L</div>
            <div class="fs-2 fw-bold @(todaysPnl >= 0 ? "text-green" : "text-red")">
                @todaysPnl.ToString("+$0.00;-$0.00;$0.00")
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Recent Signals -->
    <div class="col-lg-8">
        <div class="trading-card p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0 text-white">
                    <i class="bi bi-lightning-charge me-1" style="color:var(--yellow)"></i>
                    Recent Signals
                    <span class="badge bg-secondary ms-2">@recentSignals.Count</span>
                </h6>
                <a href="/signals" class="btn btn-sm btn-outline-secondary">View All</a>
            </div>
            @if (recentSignals.Count == 0)
            {
                <div class="text-muted text-center py-4">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>No signals yet — start a workspace to begin scanning
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-dark table-hover mb-0">
                        <thead>
                            <tr class="text-muted small">
                                <th>Symbol</th>
                                <th>Direction</th>
                                <th>Confidence</th>
                                <th>Strategy</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var signal in recentSignals.Take(20))
                            {
                                <tr>
                                    <td class="fw-bold text-white">@signal.Symbol</td>
                                    <td>
                                        @if (signal.Direction == TradeDirection.Long)
                                        {
                                            <span class="signal-long"><i class="bi bi-triangle-fill me-1" style="font-size:0.6rem"></i>Long</span>
                                        }
                                        else
                                        {
                                            <span class="signal-short"><i class="bi bi-triangle-fill me-1" style="font-size:0.6rem;transform:rotate(180deg);display:inline-block"></i>Short</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="confidence-bar-wrapper">
                                            <div class="confidence-bar" style="width:@(signal.ConfidencePercent)%"></div>
                                            <span class="confidence-label">@signal.ConfidencePercent.ToString("0")%</span>
                                        </div>
                                    </td>
                                    <td class="text-muted small">@signal.StrategyName</td>
                                    <td class="text-muted small">@signal.GeneratedUtc.ToString("HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Active Workspaces -->
    <div class="col-lg-4">
        <div class="trading-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0 text-white">
                    <i class="bi bi-layers me-1" style="color:var(--blue)"></i>Workspaces
                </h6>
                <a href="/workspaces" class="btn btn-sm btn-outline-secondary">Manage</a>
            </div>
            @foreach (var tab in userTabs)
            {
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-dark">
                    <div>
                        <div class="text-white small fw-semibold">@tab.Name</div>
                        <div class="text-muted" style="font-size:0.7rem">
                            @tab.Watchlist.Count tickers &bull; @tab.Strategies.Count(s => s.Enabled) strategies
                        </div>
                    </div>
                    <a href="/workspace/@tab.TabId" class="btn btn-sm btn-outline-secondary py-0">Open</a>
                </div>
            }
            @if (!userTabs.Any())
            {
                <div class="text-muted text-center py-3 small">No workspaces yet</div>
            }
        </div>

        <!-- Quick Add Watchlist -->
        <div class="trading-card p-3">
            <h6 class="mb-3 text-white">
                <i class="bi bi-plus-circle me-1" style="color:var(--green)"></i>Quick Add to Watchlist
            </h6>
            @if (userTabs.Any())
            {
                <div class="mb-2">
                    <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="quickAddWorkspaceId">
                        @foreach (var tab in userTabs)
                        {
                            <option value="@tab.TabId">@tab.Name</option>
                        }
                    </select>
                </div>
                <div class="input-group input-group-sm">
                    <input class="form-control bg-dark text-white border-secondary"
                           placeholder="Ticker (e.g. AAPL)"
                           @bind="quickAddSymbol"
                           @onkeydown="OnQuickAddKeyDown" />
                    <button class="btn btn-outline-success" @onclick="QuickAddTicker">Add</button>
                </div>
                @if (!string.IsNullOrEmpty(quickAddMessage))
                {
                    <div class="text-muted small mt-1">@quickAddMessage</div>
                }
            }
            else
            {
                <div class="text-muted small">
                    <a href="/workspaces" class="text-info">Create a workspace</a> first
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string userId = "";
    private IReadOnlyList<WorkspaceTab> userTabs = [];
    private List<TradeSignal> recentSignals = [];
    private int activeStrategies;
    private int openPositions;
    private decimal todaysPnl;
    private string quickAddSymbol = "";
    private string quickAddWorkspaceId = "";
    private string quickAddMessage = "";
    private System.Threading.Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        RefreshData();
        if (userTabs.Any())
            quickAddWorkspaceId = userTabs[0].TabId;

        refreshTimer = new System.Threading.Timer(_ =>
        {
            RefreshData();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void RefreshData()
    {
        userTabs = WorkspaceManager.GetTabsForUser(userId);
        recentSignals = TradingState.GetRecentSignalsForUser(userId).Take(20).ToList();
        activeStrategies = userTabs.Sum(t => t.Strategies.Count(s => s.Enabled));
        var userPositions = TradingState.GetPositionsForUser(userId);
        openPositions = userPositions.Values.Sum(p => p.Count);
        todaysPnl = TradingState.GetTodaysPnlForUser(userId);
    }

    private void OnQuickAddKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") QuickAddTicker();
    }

    private void QuickAddTicker()
    {
        var symbol = quickAddSymbol.Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(symbol)) return;
        if (string.IsNullOrEmpty(quickAddWorkspaceId)) return;

        var tab = WorkspaceManager.Get(userId, quickAddWorkspaceId);
        if (tab == null) return;

        if (!tab.Watchlist.Contains(symbol))
        {
            tab.Watchlist.Add(symbol);
            WorkspaceManager.Save(userId, tab);
            quickAddMessage = $"{symbol} added to {tab.Name}";
        }
        else
        {
            quickAddMessage = $"{symbol} is already in {tab.Name}";
        }
        quickAddSymbol = "";
    }

    public void Dispose() => refreshTimer?.Dispose();
}
